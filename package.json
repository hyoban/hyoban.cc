  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "p-limit": "^7.3.3",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.155.0",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.16.1"
