{
  "name": "hyoban.cc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @hyoban/web dev",
    "build": "vp run --filter @hyoban/web build",
    "check": "vp run --filter @hyoban/web check",
    "assets:migrate": "node scripts/migrate-assets-to-r2.mjs",
    "assets:upload": "node scripts/upload-asset-to-r2.mjs",
    "data:export": "node scripts/export-data.mjs",
    "data:import": "node scripts/import-data.mjs",
    "data:migrate": "node scripts/migrate-entries.mjs",
    "data:push": "node scripts/push-data.mjs",
    "data:schema": "node scripts/generate-data-schema.mjs",
    "zeekr:entries": "node scripts/zeekr-entries.mjs",
    "zeekr:convert": "node scripts/convert-zeekr-data.mjs",
    "zeekr:prepare": "node scripts/prepare-zeekr-data.mjs",
    "zeekr:check": "node scripts/convert-zeekr-data.mjs --check",
    "map:bench": "node scripts/bench-map.mjs",
    "map:cities": "node scripts/generate-city-boundaries.mjs",
    "places:locate": "node scripts/locate-places.mjs",
    "media:generate": "node scripts/generate-media.mjs",
    "moments:audit": "node scripts/audit-moments.mjs",
