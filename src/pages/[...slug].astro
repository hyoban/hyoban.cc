---
import SitePage from '@/components/SitePage.astro'
import Layout from '@/layouts/Layout.astro'
import { getPageTitle } from '@/page-cards'
import { getPostCardPath } from '@/post-cards'
import { countPostWords, formatPostFullDate, formatPostWordCount, getMarkdownEntries, type PostEntry } from '@/utils'
import { render } from 'astro:content'

export async function getStaticPaths() {
  // The use page has its own route, which renders its devices around the markdown.
  const entries = (await getMarkdownEntries()).filter((entry) => entry.data.link !== 'use')
  // A post links on to the ones published just before and after it, newest first.
  const posts = entries.filter((entry) => entry.collection === 'posts')
  const getNeighbor = (index: number) => {
    const neighbor = posts[index]
    return neighbor && { link: neighbor.data.link, title: neighbor.data.title }
  }
  return entries.map((entry) => {
    const index = posts.findIndex((post) => post === entry)
    return {
      params: { slug: entry.data.link },
      props: index === -1 ? { entry } : { entry, newer: getNeighbor(index - 1), older: getNeighbor(index + 1) },
    }
  })
}

type Neighbor = { link: string; title: string }
type Props = {
  entry: Awaited<ReturnType<typeof getMarkdownEntries>>[number]
  newer?: Neighbor | undefined
  older?: Neighbor | undefined
}
const { entry, newer, older } = Astro.props as Props
const post = entry.collection === 'posts' ? (entry as PostEntry) : null
const article = post
  ? {
      author: 'Hyoban',
      publishedTime: post.data.pubDate.toISOString(),
      telegramChannel: '@hyoban',
    }
  : undefined
const wordCount = post ? countPostWords(post.body ?? '') : 0
const { Content } = await render(entry)
---

<Layout
  title={getPageTitle({ heading: entry.data.title })}
  shareTitle={entry.data.title}
  description={entry.data.description}
  image={getPostCardPath(entry)}
  article={article}
>
  {
    post
      ? (
          <main class="post">
            <a href="/" class="post__back">
              <span class="i-lucide-undo-2" aria-hidden="true" />
              返回
            </a>
            <header class="post__header">
              <h1>{entry.data.title}</h1>
              <p>
                <time datetime={post.data.pubDate.toISOString()}>{formatPostFullDate(post.data.pubDate)}</time>
                <span aria-hidden="true">&emsp;</span>
                <span>{formatPostWordCount(wordCount)}</span>
              </p>
            </header>
            <article class="prose">
              <Content />
            </article>
            {(newer || older) && (
              <nav class="post__neighbors" aria-label="更多文章">
                {newer && (
                  <a href={`/${newer.link}/`} rel="prev" class="post__neighbor">
                    <span class="post__neighbor-label"><span class="i-lucide-chevron-left" aria-hidden="true" />新一篇</span>
                    <span class="link-text">{newer.title}</span>
                  </a>
                )}
                {older && (
                  <a href={`/${older.link}/`} rel="next" class="post__neighbor post__neighbor--older">
                    <span class="post__neighbor-label">旧一篇<span class="i-lucide-chevron-right" aria-hidden="true" /></span>
                    <span class="link-text">{older.title}</span>
                  </a>
                )}
              </nav>
            )}
          </main>
        )
      : (
          <SitePage title={entry.data.title} description={entry.data.description}>
            <article class="prose">
              <Content />
            </article>
          </SitePage>
        )
  }
</Layout>

<style>
  .post {
    position: relative;
    max-width: 40rem;
    margin: 1.5rem auto 0;
    line-height: 1.75rem;
  }

  /* Above the title, or out in the margin on its left once the window is wide enough. */
  .post__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 2rem;
    color: var(--color-tx-2);
    white-space: nowrap;
    text-decoration: none;
    transition: color 150ms var(--ease);

    @media (hover: hover) {
      &:hover {
        color: var(--color-tx);
      }
    }

    @media (width >= 64rem) {
      position: absolute;
      top: 0;
      right: 100%;
      margin: 0 4rem 0 0;
    }

    & span {
      width: 0.875rem;
      height: 0.875rem;
    }
  }

  /* The newer post on the left, the older on the right, side by side once there's room. */
  .post__neighbors {
    display: grid;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);

    @media (width >= 40rem) {
      grid-template-columns: 1fr 1fr;
    }
  }

  .post__neighbor {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-decoration: none;
  }

  .post__neighbor--older {
    @media (width >= 40rem) {
      grid-column: 2;
      align-items: flex-end;
      text-align: right;
    }
  }

  /* Chinese breaks only at its spaces and punctuation, into lines of even length. */
  .post__neighbor .link-text {
    overflow-wrap: anywhere;
    text-wrap: balance;
    word-break: keep-all;
  }

  .post__neighbor-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-tx-2);
    font-size: 0.875rem;

    & span {
      width: 0.875rem;
      height: 0.875rem;
    }
  }

  .post__header {
    margin-bottom: 2rem;

    & h1 {
      font-weight: 500;
    }

    & p {
      color: var(--color-tx-2);
    }
  }
</style>
