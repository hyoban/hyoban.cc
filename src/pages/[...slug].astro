---
import SitePage from '@/components/SitePage.astro'
import Layout from '@/layouts/Layout.astro'
import { countPostWords, formatPostFullDate, formatPostWordCount, getMarkdownEntries, type PostEntry } from '@/utils'
import { render } from 'astro:content'

export async function getStaticPaths() {
  // The use page has its own route, which renders its devices around the markdown.
  const entries = (await getMarkdownEntries()).filter((entry) => entry.data.link !== 'use')
  return entries.map((entry) => ({
    params: { slug: entry.data.link },
    props: { entry },
  }))
}

type Props = { entry: Awaited<ReturnType<typeof getMarkdownEntries>>[number] }
const { entry } = Astro.props as Props
const post = entry.collection === 'posts' ? (entry as PostEntry) : null
const article = post
  ? {
      author: 'Hyoban',
      publishedTime: post.data.pubDate.toISOString(),
      telegramChannel: '@hyoban',
    }
  : undefined
const wordCount = post ? countPostWords(post.body ?? '') : 0
const { Content } = await render(entry)
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  image={`/og/${entry.data.link}.png`}
  article={article}
>
  {
    post
      ? (
          <main class="relative mx-auto mt-6 max-w-[40rem] leading-7">
            <a
              href="/"
              class="mb-8 inline-flex items-center gap-1.5 whitespace-nowrap text-tx-2 no-underline transition-colors hover:text-tx min-[64rem]:absolute min-[64rem]:top-0 min-[64rem]:right-full min-[64rem]:mr-16 min-[64rem]:mb-0"
            >
              <span class="i-lucide-undo-2 size-3.5" aria-hidden="true" />
              返回
            </a>
            <header class="mb-8">
              <h1 class="font-medium">{entry.data.title}</h1>
              <p class="text-tx-2">
                <time datetime={post.data.pubDate.toISOString()}>{formatPostFullDate(post.data.pubDate)}</time>
                <span aria-hidden="true"> · </span>
                <span>{formatPostWordCount(wordCount)}</span>
              </p>
            </header>
            <article class="prose">
              <Content />
            </article>
          </main>
        )
      : (
          <SitePage title={entry.data.title} description={entry.data.description}>
            <article class="prose">
              <Content />
            </article>
          </SitePage>
        )
  }
</Layout>
