---
import Review from '@/components/Review.astro'
import { getMoments } from '@/moments'
import { getReviewYears } from '@/year-review'

// A year's review (src/components/Review.astro), between the years before and after it.
export async function getStaticPaths() {
  const years = getReviewYears(await getMoments())
  return years.map((year, index) => ({
    params: { year: String(year) },
    props: { year, previous: years[index - 1], next: years[index + 1], years },
  }))
}

const { year, previous, next, years } = Astro.props as {
  year: number
  previous?: number
  next?: number
  years: number[]
}
---

<Review year={year} previous={previous} next={next} years={years} />
