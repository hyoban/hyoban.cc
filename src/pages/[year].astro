---
import { getThumbnailUrl } from '@/asset-url'
import SitePage from '@/components/SitePage.astro'
import YearFootprint from '@/components/YearFootprint.astro'
import YearMosaic from '@/components/YearMosaic.astro'
import cities from '@/data/boundaries/cities.json'
import Layout from '@/layouts/Layout.astro'
import {
  getMomentHeadline,
  getMomentPagePath,
  getMomentPath,
  getMoments,
  getTrips,
  type Moment,
} from '@/moments'
import { getShowcaseMedia } from '@/moments/showcase'
import { getTripCollage } from '@/moments/trip-images'
import { getPageCardPath, getPageTitle } from '@/page-cards'
import { buildRouteGlyph, buildYearMap, getTripLine } from '@/year-map'
import { buildYearReview, getReviewYears } from '@/year-review'
import YearClock from '@/components/YearClock.astro'
import { readDevices } from '@/data/store'
import { getSortedPosts } from '@/utils'
import type { FogRegions } from '@hyoban/trip-map'

// A year at a glance (src/year-review.ts): its counts against the year before, its
// footprint on a map drawn at build time (src/year-map.ts), the cities it first reached,
// every day of it as a tile, its trips by the shapes of their routes, a few days worth
// going back to, the devices bought, and when it was written.
export async function getStaticPaths() {
  const years = getReviewYears(await getMoments())
  return years.map((year, index) => ({
    params: { year: String(year) },
    props: { year, previous: years[index - 1], next: years[index + 1] },
  }))
}

const { year, previous, next } = Astro.props as { year: number; previous?: number; next?: number }
const moments = await getMoments()
const regions = cities as FogRegions
const numberFormat = new Intl.NumberFormat('zh-CN')
const formatNumber = (value: number) => numberFormat.format(value)
const formatDay = (dateKey: string) => {
  const [, month, day] = dateKey.split('-').map(Number)
  return `${month} 月 ${day} 日`
}
const allTrips = getTrips(moments)
const review = buildYearReview(year, moments, allTrips, regions)
const lastDateKey = moments.at(-1)?.dateKey ?? ''
const ongoing = lastDateKey.startsWith(String(year)) && year >= new Date().getFullYear()
// The year before, up to the same day while this one isn't over, to compare the counts with.
const sameDayBefore = ongoing ? `${previous}-${lastDateKey.slice(5)}` : `${previous}-12-31`
const before =
  previous === undefined
    ? undefined
    : buildYearReview(
        previous,
        moments.filter((moment) => moment.dateKey <= sameDayBefore),
        allTrips.filter((trip) => trip.start <= sameDayBefore),
        regions,
      )

const map = buildYearMap(
  regions,
  Object.fromEntries(review.cities.lit.map((city) => [city.id, city.count])),
  review.trips.map((trip) => ({ id: trip.id, lines: getTripLine(trip.legs) })),
  review.moments.flatMap((moment) =>
    moment.locations.map(({ latitude, longitude }) => [longitude, latitude] as const),
  ),
)
const trips = review.trips.map((trip) => ({
  trip,
  glyph: buildRouteGlyph(getTripLine(trip.legs)),
  cover: getTripCollage(trip, review.moments, 1)[0],
}))
const topCities = review.cities.lit.slice(0, 6)
const firstVisits = Map.groupBy(review.firstVisits, (visit) => Number(visit.dateKey.slice(5, 7)))
const postLinks = new Set((await getSortedPosts()).map((post) => post.data.link))
const devices = Object.entries(readDevices())
  .filter(([, device]) => device.bought.on.startsWith(String(year)))
  .sort(([, first], [, second]) => first.bought.on.localeCompare(second.bought.on))
  .map(([id, device]) => ({
    ...device,
    // Its own post, when one was written about it.
    href: postLinks.has(id) ? `/${id}/` : '/use/',
  }))
/** The stills of these Moments, photos and videos' posters but no utility ones, `width` wide. */
const photosOf = (dayMoments: Moment[], width: number) =>
  dayMoments
    .flatMap((moment) => getShowcaseMedia(moment.media))
    .map((item) => (item.type === 'video' ? item.poster : item.src))
    .filter((image) => image !== undefined)
    .map((image) => getThumbnailUrl(image.sources[0]?.src ?? image.src, width))
/** The first still of these Moments, `width` wide. */
const photoOf = (dayMoments: Moment[], width: number) => photosOf(dayMoments, width)[0]
const between = (start: string, end: string) =>
  review.moments.filter((moment) => moment.dateKey >= start && moment.dateKey <= end)

// The year's numerals cut out of its photos: each month's fullest Moment, two rows of them.
const collage = Array.from({ length: 12 }, (_, index) => {
  const key = `${year}-${String(index + 1).padStart(2, '0')}`
  const month = review.moments
    .filter((moment) => moment.dateKey.startsWith(key))
    .sort(
      (first, second) =>
        getShowcaseMedia(second.media).length - getShowcaseMedia(first.media).length,
    )
  return photoOf(month, 480)
}).filter((photo) => photo !== undefined)
const collageColumns = Math.ceil(collage.length / 2)
const collageStyle =
  collage.length >= 4
    ? [
        `background-image: ${collage.map((photo) => `url("${photo}")`).join(', ')}`,
        `background-position: ${collage
          .map((_, index) => {
            const column = index % collageColumns
            const row = Math.floor(index / collageColumns)
            return `${collageColumns > 1 ? (column / (collageColumns - 1)) * 100 : 0}% ${row * 100}%`
          })
          .join(', ')}`,
        `background-size: ${100 / collageColumns}% 50%`,
      ].join('; ')
    : undefined

const headline = (moment: Moment) => getMomentHeadline(moment, 24)?.headline ?? '一张照片'

const description = ongoing
  ? `${year} 年到 ${formatDay(lastDateKey)}为止，记下了什么，去了哪里。`
  : `${year} 年记下了什么，去了哪里。`
const [firstMoment] = review.moments
const lastMoment = review.moments.at(-1)
const statsOf = (of: typeof review) => [
  { value: of.moments.length, label: '个时刻' },
  { value: of.photoCount, label: '张照片' },
  { value: of.dayCount, label: '天有记录' },
  { value: of.cities.lit.length, label: '个城市' },
  { value: of.drivingKm, label: '公里自驾' },
]
const beforeStats = before && statsOf(before)
const stats = statsOf(review)
  .map((stat, index) => {
    const was = beforeStats?.[index]?.value
    const change = was ? Math.round(((stat.value - was) / was) * 100) : undefined
    return { ...stat, change }
  })
  .filter((stat) => stat.label !== '公里自驾' || stat.value > 100)
/** `+36%`, or `×5.6` once it's more than doubled, where a percentage stops meaning much. */
const formatChange = (change: number) =>
  change >= 100
    ? `×${Number((1 + change / 100).toFixed(1))}`
    : change > 0
      ? `+${change}%`
      : change < 0
        ? `−${-change}%`
        : '持平'
const highlights = [
  firstMoment && {
    kicker: '第一条',
    title: headline(firstMoment),
    date: formatDay(firstMoment.dateKey),
    href: getMomentPagePath(firstMoment),
    layout: 'single',
    photos: photosOf([firstMoment], 480).slice(0, 1),
  },
  review.busiestDay.count > 1 && {
    kicker: '最满的一天',
    title: `记了 ${review.busiestDay.count} 条`,
    date: formatDay(review.busiestDay.dateKey),
    href: getMomentPath(review.busiestDay.dateKey),
    // The day's photos, four of them in a grid.
    layout: 'grid',
    photos: photosOf(between(review.busiestDay.dateKey, review.busiestDay.dateKey), 320).slice(0, 4),
  },
  review.streak.days > 1 && {
    kicker: '最长连续记录',
    title: `连续 ${review.streak.days} 天`,
    date: `${formatDay(review.streak.start)}起`,
    href: getMomentPath(review.streak.start),
    // A strip for each day of the run, its first photo in it.
    layout: 'strips',
    photos: Map.groupBy(between(review.streak.start, review.streak.end), (moment) => moment.dateKey)
      .values()
      .map((dayMoments) => photoOf(dayMoments, 320))
      .filter((photo) => photo !== undefined)
      .take(7)
      .toArray(),
  },
  lastMoment &&
    lastMoment !== firstMoment && {
      kicker: ongoing ? '最近一条' : '最后一条',
      title: headline(lastMoment),
      date: formatDay(lastMoment.dateKey),
      href: getMomentPagePath(lastMoment),
      layout: 'single',
      photos: photosOf([lastMoment], 480).slice(0, 1),
    },
].filter((highlight) => highlight !== undefined && highlight !== false)
---

<Layout
  title={getPageTitle({ heading: String(year) })}
  shareTitle={`${year} 年`}
  description={description}
  image={await getPageCardPath(Astro.url.pathname)}
>
  <SitePage>
    {/* Hides what's still to come in until the script below reveals it; without it, all shows. */}
    <script is:inline>document.documentElement.classList.add('year-motion')</script>
    <header class="year-hero">
      <h1 class:list={{ 'is-collage': collageStyle }} style={collageStyle}>{year}</h1>
      <dl class="year-stats">
        {
          stats.map((stat, index) => (
            <div style={`--index: ${index}`}>
              <dt>{stat.label}</dt>
              <dd>
                <span class="year-stats__value">
                  {/* The final count, unseen, holds its width while the shown one rolls up to it. */}
                  <span class="year-stats__final" aria-hidden="true">{formatNumber(stat.value)}</span>
                  <span data-value={stat.value}>{formatNumber(stat.value)}</span>
                </span>
                {stat.change !== undefined && (
                  <span
                    class:list={['year-stats__change', { 'is-up': stat.change > 0 }]}
                    title={ongoing ? `比 ${previous} 年同期` : `比 ${previous} 年`}
                  >
                    {formatChange(stat.change)}
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </header>

    {
      review.cities.lit.length > 0 && (
        <section class="year-section year-wide" aria-labelledby="year-footprint">
          <h2 id="year-footprint">足迹</h2>
          <YearFootprint map={map} label={`${year} 年去过的 ${review.cities.lit.length} 个城市和走过的路线`} />
          <ol class="year-cities" aria-label="记下最多的城市">
            {topCities.map((city, index) => (
              <li style={`--share: ${city.count / topCities[0]!.count}; --index: ${index}`}>
                <span class="year-cities__name">{city.name}</span>
                <span class="year-cities__bar" />
                <span class="year-cities__count">{city.count}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      before && review.firstVisits.length > 0 && (
        <section class="year-section" aria-labelledby="year-first">
          <h2 id="year-first">第一次去</h2>
          <ol class="year-first">
            {Array.from({ length: 12 }, (_, index) => (
              <li class:list={{ 'is-empty': !firstVisits.has(index + 1) }} style={`--month: ${index}`}>
                <span class="year-first__month">{index + 1}月</span>
                {(firstVisits.get(index + 1) ?? []).map((visit, order) => (
                  <span class="year-first__city" title={formatDay(visit.dateKey)} style={`--index: ${order}`}>
                    {visit.name}
                  </span>
                ))}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="year-section year-wide" aria-labelledby="year-days">
      <h2 id="year-days">每一天</h2>
      <YearMosaic year={year} moments={review.moments} trips={review.trips} />
    </section>

    {
      trips.length > 0 && (
        <section class="year-section" aria-labelledby="year-trips">
          <h2 id="year-trips">出行</h2>
          <ul class="year-trips">
            {trips.map(({ trip, glyph, cover }, index) => (
              <li style={`--index: ${index}`}>
                <a href={`/trip/${trip.id.slice(0, 4)}/${trip.id.slice(5)}/`}>
                  <span class="year-trips__art">
                    {cover && <img src={cover.thumbnail} alt="" loading="lazy" decoding="async" />}
                    <svg viewBox={`0 0 ${glyph.width} ${glyph.width}`} aria-hidden="true">
                      <path d={glyph.d} transform={`translate(0 ${(glyph.width - glyph.height) / 2})`} pathLength="1" />
                    </svg>
                  </span>
                  <span class="year-trips__title">{trip.title}</span>
                  <span class="year-trips__meta">
                    {formatDay(trip.start)} · {trip.dayCount} 天
                    {trip.drivingKm > 0 && ` · ${formatNumber(trip.drivingKm)} 公里`}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      devices.length > 0 && (
        <section class="year-section" aria-labelledby="year-devices">
          <h2 id="year-devices">添置的</h2>
          <ul class="year-devices">
            {devices.map((device) => (
              <li>
                <a href={device.href}>
                  <span class="year-devices__category">{device.category}</span>
                  <span class="year-devices__name">{device.name}</span>
                  <span class="year-devices__meta">
                    {formatDay(device.bought.on)} · ¥{formatNumber(device.bought.price)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="year-section" aria-labelledby="year-moments">
      <h2 id="year-moments">一些瞬间</h2>
      <ul class="year-highlights">
        {
          highlights.map((highlight, index) => (
            <li style={`--index: ${index}`}>
              <a href={highlight.href}>
                <span
                  class:list={['year-highlights__art', `is-${highlight.layout}`]}
                  style={`--count: ${highlight.photos.length}`}
                >
                  {highlight.photos.map((photo) => (
                    <img src={photo} alt="" loading="lazy" decoding="async" />
                  ))}
                </span>
                <span class="year-highlights__kicker">{highlight.kicker}</span>
                <span class="year-highlights__title">{highlight.title}</span>
                <span class="year-highlights__date">{highlight.date}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      review.favoriteHour && (
        <section class="year-section" aria-labelledby="year-hours">
          <h2 id="year-hours">什么时候记</h2>
          <YearClock hours={review.hours} favorite={review.favoriteHour} />
        </section>
      )
    }

    {
      (previous !== undefined || next !== undefined) && (
        <nav class="year-nav" aria-label="其他年份">
          {previous !== undefined ? <a href={`/${previous}/`}>← {previous}</a> : <span />}
          {next !== undefined && <a href={`/${next}/`}>{next} →</a>}
        </nav>
      )
    }
  </SitePage>
</Layout>

<script>
  // The page's motion, each piece once: the counts roll up from nothing as it opens, and
  // each section rises in the first time it scrolls into view, its parts following on.
  const DELAY = 250
  const STAGGER = 80
  const DURATION = 1100
  const easeOut = (progress: number) => 1 - (1 - progress) ** 3

  // Each count rolls up from nothing as its stat rises in: the same delay as the CSS gives
  // the stat, one after another.
  function countUp(values: HTMLElement[]) {
    const format = new Intl.NumberFormat('zh-CN')
    for (const element of values) element.textContent = format.format(0)
    const start = performance.now()
    const frame = (now: number) => {
      let running = false
      values.forEach((element, index) => {
        const elapsed = now - start - (DELAY + index * STAGGER)
        const progress = easeOut(Math.min(1, Math.max(0, elapsed / DURATION)))
        if (progress < 1) running = true
        element.textContent = format.format(Math.round(Number(element.dataset.value) * progress))
      })
      if (running) requestAnimationFrame(frame)
    }
    requestAnimationFrame(frame)
  }

  function initializeMotion() {
    const sections = document.querySelectorAll<HTMLElement>('.year-section')
    if (sections.length === 0) return
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      for (const section of sections) section.classList.add('is-revealed')
      return
    }
    countUp([...document.querySelectorAll<HTMLElement>('.year-stats__value [data-value]')])
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add('is-revealed')
          observer.unobserve(entry.target)
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    )
    for (const section of sections) observer.observe(section)
  }

  document.addEventListener('astro:page-load', initializeMotion)
</script>

<style>
  .year-hero {
    & h1 {
      width: fit-content;
      margin-left: -0.06em;
      font-size: clamp(6rem, 31vw, 13rem);
      font-weight: 600;
      line-height: 0.9;
      letter-spacing: -0.06em;
      font-variant-numeric: tabular-nums;

      /* The numerals as windows onto the year's photos. */
      &.is-collage {
        font-weight: 900;
        color: transparent;
        background-color: var(--color-tx);
        background-repeat: no-repeat;
        background-clip: text;
        -webkit-background-clip: text;
      }
    }

  }

  .year-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.25rem;
    margin-top: 2rem;

    & div {
      display: flex;
      flex-direction: column-reverse;
    }

    & dt {
      color: var(--color-tx-2);
      font-size: 0.875rem;
    }

    & dd {
      font-size: 1.5rem;
      font-weight: 600;
      line-height: 2rem;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }
  }

  .year-section {
    margin-top: 4rem;

    & > h2 {
      margin-bottom: 1rem;
      font-weight: 500;
    }
  }

  /* The drawings take more than the column where there's room: up to 56rem, centred on it. */
  .year-wide {
    --wide: min(56rem, 100vw - 2rem);
    width: var(--wide);
    margin-inline: calc((100% - var(--wide)) / 2);

    & > h2 {
      max-width: 40rem;
      margin-inline: auto;
    }
  }

  .year-wide :global(figcaption) {
    max-width: 40rem;
    margin-inline: auto;
  }

  .year-trips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;

    @media (width >= 40rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    & a {
      display: flex;
      flex-direction: column;
      height: 100%;
      text-decoration: none;
    }

    & .year-trips__art path {
      fill: none;
      stroke: #fff;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
  }

  @keyframes year-trip-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* The trip's cover, dimmed, with the shape of its route drawn over it in white. */
  .year-trips__art {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: 0.5rem;
    border-radius: 0.625rem;
    background: var(--color-tx-2);

    & img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.55) saturate(1.1);
      transition:
        scale 180ms var(--ease),
        filter 180ms var(--ease);
    }

    & svg {
      position: absolute;
      inset: 16%;
      width: 68%;
      height: 68%;
      overflow: visible;
      filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4));
    }

    @media (hover: hover) {
      a:hover & img {
        scale: 1.025;
        filter: brightness(0.45) saturate(1.1);
      }
    }
  }

  .year-trips__meta {
    color: var(--color-tx-2);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  /* Cities by how much was written in each, as bars under the map. */
  .year-cities {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.375rem 0.75rem;
    align-items: center;
    max-width: 40rem;
    margin: 1.5rem auto 0;
    font-variant-numeric: tabular-nums;

    & li {
      display: contents;
    }
  }

  .year-cities__bar {
    width: calc(var(--share) * 100%);
    height: 0.625rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-tx) calc(25% + var(--share) * 55%), transparent);
  }

  .year-cities__count {
    color: var(--color-tx-2);
    text-align: right;
  }

  /* The days worth going back to, as cards like the trips': their photos above, laid out
     by what they are (one Moment, a full day, a run of days), the words below. */
  .year-highlights {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.75rem;

    @media (width >= 40rem) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    & a {
      display: flex;
      flex-direction: column;
      text-decoration: none;
    }

    & img {
      width: 100%;
      height: 100%;
      min-width: 0;
      min-height: 0;
      object-fit: cover;
      transition: scale 180ms var(--ease);
    }

    @media (hover: hover) {
      & a:hover img {
        scale: 1.025;
      }
    }
  }

  .year-highlights__art {
    display: grid;
    gap: 2px;
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: 0.5rem;
    border-radius: 0.625rem;
    background: var(--color-inline);
    border: 1px solid var(--color-border);

    &:has(img) {
      border: none;
    }

    &.is-grid {
      grid-template-columns: repeat(min(var(--count), 2), minmax(0, 1fr));
    }

    &.is-grid:has(img:nth-child(3):last-child) img:first-child {
      grid-row: span 2;
    }

    &.is-strips {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }
  }

  .year-highlights__kicker,
  .year-highlights__date {
    color: var(--color-tx-2);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .year-highlights__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .year-highlights img,
    .year-trips__art img {
      transition: none;
    }
  }

  .year-stats__value {
    display: inline-grid;

    & > span {
      grid-area: 1 / 1;
      text-align: right;
    }
  }

  .year-stats__final {
    visibility: hidden;
  }

  .year-stats__change {
    margin-left: 0.375rem;
    color: var(--color-tx-3);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0;
    vertical-align: 0.5rem;

    &.is-up {
      color: var(--color-tx-2);
    }
  }

  /* The cities first reached, under the month they were reached in. */
  .year-first {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 0.75rem;

