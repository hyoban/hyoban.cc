---
import SitePage from '@/components/SitePage.astro'
import Layout from '@/layouts/Layout.astro'
import { formatKilometers, getCarSummary } from '@/car'
import { getDistanceLevel, getYearWeeks, type Outing } from '@/data/vehicle'
import { getMomentPath } from '@/moments'
import { CAR_TEXT, getPageCardPath, getPageTitle } from '@/page-cards'

// The car's days as one contribution graph a year, newest first, and the outings found
// in them: a written-up trip links to its page, any other is told by its Moments' places.
// A day of an outing links down to it.

const car = await getCarSummary()
const firstYear = Number(car.span.start.slice(0, 4))
const lastYear = Number(car.span.end.slice(0, 4))
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, index) => lastYear - index)

const outingByDate = new Map<string, Outing>()
for (const outing of car.outings) {
  for (const date of car.days.keys()) {
    if (outing.start <= date && date <= outing.end) outingByDate.set(date, outing)
  }
}
const getOutingId = (outing: Outing) => `outing-${outing.start}`

const weekdayLabels = ['一', '', '三', '', '五', '', '日']
const getMonthLabels = (weeks: ReturnType<typeof getYearWeeks>) =>
  weeks.map((week) => {
    const first = week.find((cell) => cell?.date.endsWith('-01'))
    return first ? Number(first.date.slice(5, 7)) : undefined
  })
const getYearDistance = (year: number) =>
  [...car.days].reduce(
    (total, [date, meters]) => (date.startsWith(`${year}-`) ? total + meters : total),
    0,
  )

const formatDay = (date: string) => `${Number(date.slice(5, 7))} 月 ${Number(date.slice(8))} 日`
const formatDates = ({ end, start }: Outing) => {
  const from = start.replaceAll('-', '.')
  if (start === end) return from
  return `${from} – ${end.slice(0, 4) === start.slice(0, 4) ? end.slice(5).replace('-', '.') : end.replaceAll('-', '.')}`
}
const getDayCount = ({ end, start }: Outing) =>
  (Date.parse(`${end}T00:00:00Z`) - Date.parse(`${start}T00:00:00Z`)) / 86_400_000 + 1
const unrecorded = car.outings.filter((outing) => !outing.trip).length
---

<Layout
  title={getPageTitle(CAR_TEXT)}
  shareTitle={CAR_TEXT.heading}
  description={CAR_TEXT.description}
  image={await getPageCardPath(Astro.url.pathname)}
>
  <SitePage title={CAR_TEXT.heading} description={CAR_TEXT.description}>
    <dl class="car-stats">
      <div>
        <dt>里程</dt>
        <dd>{formatKilometers(car.distanceMeters)}</dd>
      </div>
      <div>
        <dt>开车的日子</dt>
        <dd>{car.drivenDays} 天</dd>
      </div>
      <div>
        <dt>出行</dt>
        <dd>{car.outings.length} 次</dd>
      </div>
      <div>
        <dt>充电</dt>
        <dd>{car.chargeCount} 次</dd>
      </div>
    </dl>

    {
      years.map((year) => {
        const weeks = getYearWeeks(year, car.days, car.span)
        return (
          <section class="car-year" aria-labelledby={`year-${year}`}>
            <h2 class="car-year__title" id={`year-${year}`}>
              {year}
              <span>{formatKilometers(getYearDistance(year))}</span>
            </h2>
            <div class="car-heatmap" style={`--weeks: ${weeks.length}`}>
              <div class="car-heatmap__months" aria-hidden="true">
                {getMonthLabels(weeks).map((month) => (
                  <span>
                    {month}
                    {month && <span class="car-heatmap__month-unit"> 月</span>}
                  </span>
                ))}
              </div>
              <div class="car-heatmap__weekdays" aria-hidden="true">
                {weekdayLabels.map((label) => (
                  <span>{label}</span>
                ))}
              </div>
              <div class="car-heatmap__grid">
                {weeks.flatMap((week) =>
                  week.map((cell) => {
                    if (!cell) return <span class="car-heatmap__cell" data-outside />
                    if (cell.distanceMeters === undefined) {
                      return <span class="car-heatmap__cell" data-empty title={`${formatDay(cell.date)} · 没有记录`} />
                    }
                    const title = `${formatDay(cell.date)} · ${cell.distanceMeters ? formatKilometers(cell.distanceMeters) : '没开'}`
                    const outing = outingByDate.get(cell.date)
                    return outing ? (
                      <a
                        class="car-heatmap__cell"
                        data-level={getDistanceLevel(cell.distanceMeters)}
                        href={`#${getOutingId(outing)}`}
                        title={`${title} · ${outing.trip?.title ?? '出行'}`}
                        aria-label={title}
                      />
                    ) : (
                      <span class="car-heatmap__cell" data-level={getDistanceLevel(cell.distanceMeters)} title={title} />
                    )
                  }),
                )}
              </div>
            </div>
          </section>
        )
      })
    }

    <div class="car-legend" aria-hidden="true">
      <span>没开</span>
      {[0, 1, 2, 3, 4].map((level) => <span class="car-heatmap__cell" data-level={level} />)}
      <span>300 km+</span>
    </div>

    <section class="car-outings" aria-labelledby="outings">
      <h2 id="outings">出行</h2>
      <p class="car-outings__note">
        开了 150 km 以上的日子连起来，一共 300 km 以上就算一次。{unrecorded} 次没有写成旅程，用那几天的记录推测去了哪。
      </p>
      <ol class="car-outings__list">
        {
          car.outings.map((outing) => (
            <li class="car-outing" id={getOutingId(outing)}>
              <p class="car-outing__title">
                {outing.trip ? (
                  <a href={`/trip/${outing.trip.id}/`}>{outing.trip.title}</a>
                ) : outing.cities.length ? (
                  <>
                    {outing.cities.join('、')}
                    {outing.sights.length > 0 && (
                      <span class="car-outing__sights">{outing.sights.slice(0, 3).join('、')}</span>
                    )}
                  </>
                ) : (
                  <span class="car-outing__unknown">
                    {outing.momentCount ? '记录里没有地点' : '没有记录'}
                  </span>
                )}
                {!outing.trip && <span class="car-outing__badge">没写成旅程</span>}
              </p>
              <p class="car-outing__meta">
                <span>{formatDates(outing)}</span>
                {getDayCount(outing) > 1 && <span>{getDayCount(outing)} 天</span>}
                <span>{formatKilometers(outing.distanceMeters)}</span>
                {outing.fastCharges > 0 && <span>快充 {outing.fastCharges} 次</span>}
                {!outing.trip && outing.momentCount > 0 && (
                  <a href={getMomentPath(outing.start)}>{outing.momentCount} 条记录</a>
                )}
              </p>
            </li>
          ))
        }
      </ol>
    </section>
  </SitePage>
</Layout>

<style>
  .car-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;

    @media (width >= 40rem) {
      grid-template-columns: repeat(4, 1fr);
    }

    dt {
      color: var(--color-tx-3);
      font-size: 0.875rem;
    }

    dd {
      font-size: 1.25rem;
      font-variant-numeric: tabular-nums;
    }
  }

  .car-year {
    margin-bottom: 1.5rem;
  }

  .car-year__title {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 0.5rem;
    font-weight: 500;

    span {
      color: var(--color-tx-3);
      font-size: 0.875rem;
      font-weight: 400;
      font-variant-numeric: tabular-nums;
    }
  }

  .car-heatmap {
    --gap: 1px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem;
    color: var(--color-tx-3);
    font-size: 0.625rem;
    line-height: 1;

    @media (width >= 40rem) {
      --gap: 2px;
    }
  }

  .car-heatmap__months,
  .car-heatmap__grid {
    display: grid;
    grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
    column-gap: var(--gap);
    grid-column: 2;
  }

  .car-heatmap__months span {
    overflow: visible;
    white-space: nowrap;
  }

  .car-heatmap__month-unit {
    display: none;

    @media (width >= 40rem) {
      display: inline;
    }
  }

  .car-heatmap__weekdays {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    row-gap: var(--gap);
    grid-row: 2;
  }

  .car-heatmap__grid {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: var(--gap);
  }

  .car-heatmap__cell {
    display: block;
    aspect-ratio: 1;
    border-radius: 1px;
    background: var(--color-hover);

    &[data-outside] {
      background: none;
    }

    &[data-empty] {
      background: none;
      box-shadow: inset 0 0 0 1px var(--color-hover);
    }

    &[data-level='1'] {
      background: color-mix(in srgb, var(--color-tx) 20%, var(--color-hover));
    }

    &[data-level='2'] {
      background: color-mix(in srgb, var(--color-tx) 40%, var(--color-hover));
    }

    &[data-level='3'] {
      background: color-mix(in srgb, var(--color-tx) 65%, var(--color-hover));
    }

    &[data-level='4'] {
      background: var(--color-tx);
    }
  }

  a.car-heatmap__cell:hover {
    outline: 1px solid var(--color-tx);
    outline-offset: 1px;
  }

  .car-legend {
    display: flex;
    gap: 3px;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 2.5rem;
    color: var(--color-tx-3);
    font-size: 0.75rem;

    .car-heatmap__cell {
      width: 0.625rem;
    }

    span:first-child {
      margin-right: 0.25rem;
    }

    span:last-child {
      margin-left: 0.25rem;
    }
  }

  .car-outings h2 {
    font-weight: 500;
  }

  .car-outings__note {
    margin-bottom: 1rem;
    color: var(--color-tx-2);
    font-size: 0.875rem;
  }

  .car-outing {
    padding-block: 0.75rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 1rem;

    &:target {
      background: var(--color-inline);
    }
  }

  .car-outing__title {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;

    a {
      text-decoration: underline;
      text-decoration-color: var(--color-border);
      text-underline-offset: 0.2em;
    }
  }

  .car-outing__sights {
    color: var(--color-tx-2);
    font-size: 0.875rem;
  }

  .car-outing__unknown {
    color: var(--color-tx-3);
  }

  .car-outing__badge {
    padding-inline: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.25rem;
    color: var(--color-tx-3);
    font-size: 0.75rem;
    line-height: 1.25rem;
  }

  .car-outing__meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75rem;
    color: var(--color-tx-3);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;

    a {
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }
  }
</style>
