---
import SitePage from '@/components/SitePage.astro'
import { SITE_TITLE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getMoments, getTrips } from '@/moments'

const trips = getTrips(await getMoments()).toSorted((first, second) =>
  second.start.localeCompare(first.start),
)

const totals = [
  [trips.length, '段旅程'],
  [trips.reduce((total, trip) => total + trip.dayCount, 0), '天'],
  [trips.reduce((total, trip) => total + trip.distanceKm, 0).toLocaleString('zh-CN'), '公里'],
  [trips.reduce((total, trip) => total + trip.drivingHours, 0), '小时车程'],
] as const

function formatDate(dateKey: string, withYear = false) {
  return new Intl.DateTimeFormat('zh-CN', {
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
    ...(withYear ? { year: 'numeric' as const } : {}),
  }).format(new Date(`${dateKey}T00:00:00Z`))
}
---

<Layout title={`旅程 | ${SITE_TITLE}`} description="在地图上按时间回放的几段旅程。">
  <SitePage>
    <p>按时间顺序在地图上回放一段旅程，路线、照片和当时写下的话会一站一站出现。</p>
    <dl class="mt-6 grid grid-cols-4 gap-1 max-[30rem]:grid-cols-2">
      {
        totals.map(([value, label]) => (
          <div class="flex flex-col-reverse rounded-md bg-inline px-3 py-2">
            <dt class="text-xs text-tx-3">{label}</dt>
            <dd class="font-mono text-lg tabular-nums">{value}</dd>
          </div>
        ))
      }
    </dl>
    <ul class="mt-6 flex flex-col gap-1">
      {
        trips.map(trip => (
          <li>
            <a href={`/trip/${trip.id}/`} class="-mx-3 flex items-center gap-4 rounded-md p-3 no-underline transition-colors hover:bg-hover">
              <img class="aspect-[1200/630] w-36 shrink-0 rounded-[0.3125rem] bg-inline object-cover max-[30rem]:w-28" src={`/trip/${trip.id}/thumbnail.webp`} width="480" height="252" alt="" loading="lazy" decoding="async" />
              <span class="flex min-w-0 flex-col gap-1">
                <span>{trip.title}</span>
                <span class="text-sm text-tx-2 tabular-nums">
                  {formatDate(trip.start, true)} – {formatDate(trip.end)}
                </span>
                <span class="text-sm text-tx-3 tabular-nums">
                  {trip.dayCount} 天 · {trip.placeCount} 个地点 · {trip.distanceKm.toLocaleString('zh-CN')} 公里
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </SitePage>
</Layout>
