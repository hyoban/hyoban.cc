---
import CalendarMap from '@/components/CalendarMap.astro'
import { getMappedLocationGroups, getMoments } from '@/moments'

// The map with only the places first recorded in a year, and the trips started then.
export async function getStaticPaths() {
  const years = new Set(getMappedLocationGroups(await getMoments()).map(group => group.firstYear))

  return [...years].map(year => ({ params: { year: String(year) }, props: { year } }))
}

const { year } = Astro.props
---

<CalendarMap year={year} />
