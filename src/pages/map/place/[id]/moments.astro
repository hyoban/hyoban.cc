---
import MomentEntry from '@/components/MomentEntry.astro'
import { getMappedLocationGroups, getMoments } from '@/moments'

// The drawer content for one map place: an HTML fragment the map fetches when the
// place opens, so the map page doesn't carry every place's Moments up front.
export const partial = true

export async function getStaticPaths() {
  return getMappedLocationGroups(await getMoments()).map(group => ({
    params: { id: group.id },
    props: { group },
  }))
}

const { group } = Astro.props
---

<div class="trip-map-drawer__moments min-w-0">
  {group.moments.map(moment => (
    <MomentEntry date="year" exceptLocation={group.id} moment={moment} />
  ))}
</div>
