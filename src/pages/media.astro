---
import { SITE_TITLE } from '@/consts'
import MediaSourceIcon from '@/components/MediaSourceIcon.astro'
import SitePage from '@/components/SitePage.astro'
import generatedMedia from '@/data/media.generated.json'
import mediaRecommendations from '@/data/media-recommendations.json'
import Layout from '@/layouts/Layout.astro'

const pageTitle = `Media | ${SITE_TITLE}`
const pageDescription = '我推荐的电影、剧集和动画'
const TMDB_IMAGE_BASE_URL = 'https://image.tmdb.org/t/p'
const posterImageClass = 'aspect-[2/3] w-full rounded bg-inline object-cover shadow-[0_0_0_1px_var(--color-border)]'
const sourceLinkClass = 'inline-flex items-center no-underline hover:text-tx'
const sourceIconClass = 'inline-block size-[1em] text-current'
const ANIMATION_GENRE_ID = 16
const mediaCategories = [
  { label: '动漫', value: 'anime' },
  { label: '电视剧', value: 'tv' },
  { label: 'TVB', value: 'tvb' },
  { label: '电影', value: 'movie' },
] as const

type MediaCategory = typeof mediaCategories[number]['value']

type MediaRecommendation = {
  doubanId?: number
  note?: string
  playbackSources?: PlaybackSource[]
  type: 'movie' | 'tv'
  tmdbId: number
}

type PlaybackSource = {
  name: string
  url: string
}

type TmdbPerson = {
  job?: string
  name?: string
}

type TmdbCompany = {
  name?: string
}

type TmdbGenre = {
  id?: number
}

type TmdbDetails = {
  created_by?: TmdbPerson[]
  credits?: {
    crew?: TmdbPerson[]
  }
  first_air_date?: string
  genres?: TmdbGenre[]
  name?: string
  networks?: TmdbCompany[]
  original_name?: string
  original_title?: string
  overview?: string
  poster_path?: string | null
  production_companies?: TmdbCompany[]
  release_date?: string
  title?: string
}

type GeneratedMediaItem = {
  type: 'movie' | 'tv'
  tmdbId: number
  data: TmdbDetails
}

const generatedByKey = new Map(
  (generatedMedia.items as GeneratedMediaItem[]).map(item => [
    getMediaKey(item),
    item,
  ]),
)

const sortedRecommendations = [...mediaRecommendations as MediaRecommendation[]].sort(compareMedia)

const mediaWorks = sortedRecommendations.map((recommendation) => {
  const generated = generatedByKey.get(getMediaKey(recommendation))

  if (!generated) {
    throw new Error(
      `Missing generated TMDB data for ${getMediaKey(recommendation)}. Run "pnpm media:generate".`,
    )
  }

  return resolveMediaWork(recommendation, generated)
})

const mediaCategoryCounts = new Map(
  mediaCategories.map(category => [
    category.value,
    mediaWorks.filter(work => work.categories.includes(category.value)).length,
  ]),
)

function resolveMediaWork(recommendation: MediaRecommendation, generated: GeneratedMediaItem) {
  const data = generated.data
  const title = getTitle(generated.type, data)
  const originalTitle = getOriginalTitle(generated.type, data)
  const displayTitle = originalTitle && originalTitle !== title
    ? `${title}（${originalTitle}）`
    : title
  const doubanUrl = recommendation.doubanId
    ? getDoubanUrl(recommendation.doubanId)
    : undefined

  return {
    categories: getMediaCategories(generated.type, data),
    creator: getCreator(generated.type, data),
    displayTitle,
    doubanUrl,
    note: recommendation.note,
    overview: data.overview,
    playbackSources: recommendation.playbackSources ?? [],
    posterUrl: data.poster_path ? `${TMDB_IMAGE_BASE_URL}/w342${data.poster_path}` : undefined,
    tmdbUrl: getTmdbUrl(generated.type, generated.tmdbId),
    year: getYear(generated.type, data),
  }
}

function getMediaCategories(type: GeneratedMediaItem['type'], data: TmdbDetails): MediaCategory[] {
  if (data.genres?.some(genre => genre.id === ANIMATION_GENRE_ID)) {
    return ['anime']
  }

  if (type === 'tv' && isTvbMedia(data)) {
    return ['tvb']
  }

  return [type]
}

function isTvbMedia(data: TmdbDetails) {
  return [...(data.networks ?? []), ...(data.production_companies ?? [])]
    .some(company => company.name && (/(^|\s)TVB($|\s)/i.test(company.name) || company.name.includes('香港电视广播')))
}

function getMediaKey(media: Pick<MediaRecommendation, 'type' | 'tmdbId'>) {
  return `${media.type}:${media.tmdbId}`
}

function getDoubanUrl(doubanId: number) {
  return `https://movie.douban.com/subject/${doubanId}/`
}

function getTmdbUrl(type: GeneratedMediaItem['type'], tmdbId: number) {
  return `https://www.themoviedb.org/${type}/${tmdbId}`
}

function compareMedia(
  first: Pick<MediaRecommendation, 'type' | 'tmdbId'>,
  second: Pick<MediaRecommendation, 'type' | 'tmdbId'>,
) {
  return first.tmdbId - second.tmdbId || first.type.localeCompare(second.type)
}

function getTitle(type: GeneratedMediaItem['type'], data: TmdbDetails) {
  if (type === 'movie') {
    return data.title || getOriginalTitle(type, data) || '未命名电影'
  }

  return data.name || getOriginalTitle(type, data) || '未命名剧集'
}

function getOriginalTitle(type: GeneratedMediaItem['type'], data: TmdbDetails) {
  return type === 'movie'
    ? data.original_title
    : data.original_name
}

function getYear(type: GeneratedMediaItem['type'], data: TmdbDetails) {
  const date = type === 'movie'
    ? data.release_date
    : data.first_air_date

  return date?.slice(0, 4)
}

function getCreator(type: GeneratedMediaItem['type'], data: TmdbDetails) {
  if (type === 'movie') {
    const directors = data.credits?.crew
      ?.filter(person => person.job === 'Director')
      .map(person => person.name)
      .filter(Boolean)

    if (directors?.length) {
      return directors.join(', ')
    }
  } else {
    const creators = data.created_by
      ?.map(person => person.name)
      .filter(Boolean)

    if (creators?.length) {
      return creators.join(', ')
    }
  }

  return data.production_companies?.[0]?.name
    || data.networks?.[0]?.name
    || undefined
}

---

<Layout title={pageTitle} description={pageDescription}>
  <Fragment slot="head">
    <script is:inline data-astro-rerun>
      const mediaCategory = new URL(window.location.href).searchParams.get('category')
      document.documentElement.dataset.mediaCategory = ['anime', 'tv', 'tvb', 'movie'].includes(mediaCategory)
        ? mediaCategory
        : 'anime'
    </script>
  </Fragment>

  <SitePage title="影视推荐" description="一些我觉得值得看的电影、剧集和动画，持续整理更新中。">

    <nav
      class="mb-4 flex w-fit max-w-full items-center gap-5 overflow-x-auto [scrollbar-width:none]"
      aria-label="分类过滤"
      data-media-filters
    >
      {
        mediaCategories.map(category => (
          <a
            href={`/media/?category=${category.value}`}
            class="inline-flex min-h-9 shrink-0 items-center gap-1.5 text-tx-2 no-underline transition-colors hover:text-tx"
            aria-controls="media-list"
            aria-current={category.value === 'anime' ? 'page' : undefined}
            data-media-filter={category.value}
          >
            {category.label}
            <span class="tabular-nums">{mediaCategoryCounts.get(category.value)}</span>
          </a>
        ))
      }
    </nav>

    <ol id="media-list" class="flex flex-col gap-1">
      {
        mediaWorks.map(work => (
          <li class="media-item" data-media-category={work.categories.join(' ')}>
            <article class="-mx-3 grid items-start gap-x-3 gap-y-3 rounded-md p-3 transition-colors hover:bg-hover sm:grid-cols-[6rem_minmax(0,1fr)] sm:gap-x-5 sm:gap-y-1">
              <div class="grid min-w-0 grid-cols-[5rem_minmax(0,1fr)] items-start gap-x-3 gap-y-3 sm:contents">
                {
                  work.posterUrl && (
                    <a
                      href={work.tmdbUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="col-start-1 row-span-2 row-start-1 block w-full self-start"
                    >
                      <img
                        src={work.posterUrl}
                        alt={`${work.displayTitle} poster`}
                        class={posterImageClass}
                        loading="lazy"
                      />
                    </a>
                  )
                }

                <header class="col-start-2 row-start-1 min-w-0 space-y-2">
                  <h2 class="truncate font-medium">
                    <a href={work.tmdbUrl} target="_blank" rel="noopener noreferrer" class="no-underline">
                      {work.displayTitle}
                    </a>
                  </h2>
                  {(work.creator || work.year || work.doubanUrl || work.playbackSources.length > 0) && (
                    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-tx-2">
                      {work.creator && <span>{work.creator}</span>}
                      {work.year && <span>{work.year}</span>}
                      {work.doubanUrl && (
                        <a href={work.doubanUrl} target="_blank" rel="noopener noreferrer" class={sourceLinkClass} aria-label="豆瓣" title="豆瓣">
                          <span class={`${sourceIconClass} i-simple-icons-douban`} aria-hidden="true" />
                        </a>
                      )}
                      {work.playbackSources.map(source => (
                        <a href={source.url} target="_blank" rel="noopener noreferrer" class={sourceLinkClass} aria-label={source.name} title={source.name}>
                          <MediaSourceIcon name={source.name} />
                        </a>
                      ))}
                    </p>
                  )}
                </header>

                {work.note && (
                  <p class="col-start-2 self-end line-clamp-2 leading-relaxed sm:line-clamp-3">{work.note}</p>
                )}

                {work.overview && (
                  <p class="col-start-2 self-end line-clamp-2 leading-relaxed text-tx-2 sm:line-clamp-3">{work.overview}</p>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </SitePage>
</Layout>

<script>
  const DEFAULT_MEDIA_CATEGORY = 'anime'
  const MEDIA_CATEGORIES = new Set(['tv', 'tvb', 'movie', 'anime'])

  function getMediaCategoryFromUrl() {
    const category = new URL(window.location.href).searchParams.get('category')

    return category && MEDIA_CATEGORIES.has(category)
      ? category
      : DEFAULT_MEDIA_CATEGORY
  }

  function updateMediaCategoryUrl(category: string) {
    const url = new URL(window.location.href)
    url.searchParams.set('category', category)
    window.history.replaceState({}, '', url)
  }

  function initializeMediaFilters() {
    const filters = document.querySelector('[data-media-filters]')

    if (!filters) {
      return
    }

    const filterLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-media-filter]'))
    const initialCategory = getMediaCategoryFromUrl()

    document.documentElement.dataset.mediaCategory = initialCategory

    filterLinks.forEach((link) => {
      if (link.dataset.mediaFilter === initialCategory) {
        link.setAttribute('aria-current', 'page')
      } else {
        link.removeAttribute('aria-current')
      }
    })

    if (new URL(window.location.href).searchParams.get('category') !== initialCategory) {
      updateMediaCategoryUrl(initialCategory)
    }
  }

  document.addEventListener('astro:page-load', initializeMediaFilters)
  initializeMediaFilters()
</script>

<style is:global>
  html:not([data-media-category]) [data-media-category]:not([data-media-category~='anime']),
  html[data-media-category='anime'] [data-media-category]:not([data-media-category~='anime']),
  html[data-media-category='tv'] [data-media-category]:not([data-media-category~='tv']),
  html[data-media-category='tvb'] [data-media-category]:not([data-media-category~='tvb']),
  html[data-media-category='movie'] [data-media-category]:not([data-media-category~='movie']) {
    display: none;
  }

  html:not([data-media-category]) [data-media-filter='anime'],
  html[data-media-category='anime'] [data-media-filter='anime'],
  html[data-media-category='tv'] [data-media-filter='tv'],
  html[data-media-category='tvb'] [data-media-filter='tvb'],
  html[data-media-category='movie'] [data-media-filter='movie'] {
    color: var(--color-tx);
  }
</style>
