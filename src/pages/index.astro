---
import SitePage from '@/components/SitePage.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { formatPostListDate, formatPostYear, getSortedPosts } from '@/utils'

const posts = await getSortedPosts()
type Post = (typeof posts)[number]
const postsByYear: Array<{ year: string; posts: Post[] }> = []

for (const post of posts) {
  const year = formatPostYear(post.data.pubDate)
  const lastGroup = postsByYear[postsByYear.length - 1]

  if (lastGroup && lastGroup.year === year) {
    lastGroup.posts.push(post)
  } else {
    postsByYear.push({ year, posts: [post] })
  }
}
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <SitePage>
    <p>我会在这里写一些关于工作和生活的记录。</p>

    <section class="mt-16 flex flex-col gap-10" aria-label="文章">
      {
        postsByYear.map((group) => (
          <section class="grid gap-x-6 gap-y-1 sm:grid-cols-[3.5rem_minmax(0,1fr)]">
            <h2 class="py-1 text-tx-2 tabular-nums sm:sticky sm:top-4 sm:self-start">{group.year}</h2>
            <ul class="flex flex-col">
              {group.posts.map((post) => (
                <li>
                  <a
                    href={`/${post.data.link}/`}
                    class="flex items-baseline justify-between gap-4 py-1 no-underline sm:block"
                  >
                    <span class="link-text min-w-0">{post.data.title}</span>
                    <time class="shrink-0 whitespace-nowrap text-tx-2 tabular-nums sm:ml-2" datetime={post.data.pubDate.toISOString()}>{formatPostListDate(post.data.pubDate)}</time>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </SitePage>
</Layout>
