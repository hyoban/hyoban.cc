---
import SitePage from '@/components/SitePage.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { formatPostListDate, formatPostYear, getSortedPosts } from '@/utils'

const posts = await getSortedPosts()
type Post = (typeof posts)[number]
const postsByYear: Array<{ year: string; posts: Post[] }> = []

for (const post of posts) {
  const year = formatPostYear(post.data.pubDate)
  const lastGroup = postsByYear[postsByYear.length - 1]

  if (lastGroup && lastGroup.year === year) {
    lastGroup.posts.push(post)
  } else {
    postsByYear.push({ year, posts: [post] })
  }
}
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <SitePage>
    <p>我会在这里写一些关于工作和生活的记录。</p>

    <section class="post-years" aria-label="文章">
      {
        postsByYear.map((group) => (
          <section class="post-year">
            <h2>{group.year}</h2>
            <ul>
              {group.posts.map((post) => (
                <li>
                  <a href={`/${post.data.link}/`}>
                    <span class="link-text">{post.data.title}</span>
                    <time datetime={post.data.pubDate.toISOString()}>{formatPostListDate(post.data.pubDate)}</time>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </section>
  </SitePage>
</Layout>

<style>
  .post-years {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin-top: 4rem;
  }

  /* A year's posts, its number in a column on the left from 40rem that stays in view. */
  .post-year {
    display: grid;
    gap: 0.25rem 1.5rem;

    @media (width >= 40rem) {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }

    & h2 {
      padding-block: 0.25rem;
      color: var(--color-tx-2);
      font-variant-numeric: tabular-nums;

      @media (width >= 40rem) {
        position: sticky;
        top: 1rem;
        align-self: start;
      }
    }

    & ul {
      display: flex;
      flex-direction: column;
    }

    & a {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding-block: 0.25rem;
      text-decoration: none;

      @media (width >= 40rem) {
        display: block;
      }
    }

    & .link-text {
      min-width: 0;
    }

    & time {
      flex-shrink: 0;
      color: var(--color-tx-2);
      white-space: nowrap;
      font-variant-numeric: tabular-nums;

      @media (width >= 40rem) {
        margin-left: 0.5rem;
      }
    }
  }
</style>
