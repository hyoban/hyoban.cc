---
import '@/styles/index.css'

import { getAssetUrl } from '@/asset-url'
import { SITE_TITLE, SITE_URL } from '@/consts'
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from '@/og-layout'
import { ClientRouter, fade } from 'astro:transitions'

interface Props {
  /** The page's own address when another one also leads to it; this one otherwise. */
  canonicalPath?: string | undefined
  title: string
  /** The title a share preview shows; `title` without the site's name, which og:site_name gives. */
  shareTitle?: string | undefined
  description?: string | undefined
  /** A large share preview; pages without one fall back to the site's card. */
  image?: string | undefined
  article?: {
    author: string
    publishedTime: string
    telegramChannel?: string | undefined
  } | undefined
}

const { canonicalPath, title, description, article, image } = Astro.props
const shareTitle = Astro.props.shareTitle ?? title.replace(` | ${SITE_TITLE}`, '')
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, SITE_URL).toString()
// Every card is drawn at one size, so a preview can lay it out before fetching it.
const imageUrl = new URL(image ?? '/og.png', SITE_URL).toString()
const imageType = imageUrl.endsWith('.jpg') ? 'image/jpeg' : 'image/png'
// A post as search engines read it: its headline, author and dates.
const articleData = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: shareTitle,
  description,
  url: canonicalUrl,
  image: imageUrl,
  inLanguage: 'zh-Hans',
  datePublished: article.publishedTime,
  author: { '@type': 'Person', name: article.author, url: SITE_URL },
}

// Telegram Instant View fallback via Teletype's undocumented verification flow.
// References:
// https://seroperson.me/2025/01/03/making-website-telegram-instant-view-compatible/
// https://habr.com/ru/articles/807129/
const TELETYPE_SITE_VERIFICATION = 'g7j8/rPFXfhyrq5q0QQV7EsYWv4='
---

<html
  lang="zh-Hans"
  transition:name="root"
  transition:animate={fade({ duration: '200ms' })}
>
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <!-- Drawn under the notch and the browser's bars too (iOS 26 Safari's floating bar, Chrome
         edge to edge), what sits by an edge kept clear of them with env(safe-area-inset-*). -->
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <link rel="icon" type="image/png" href={getAssetUrl('site/avatar-64.png')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fdfdfc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111110" />

    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
    <!-- A page going back to where it was (the script at the end of the body) isn't drawn
         until it's read and back there, the last frame of the page before held meanwhile:
         Chrome draws a long page's top while the rest is still being read. -->
    <script is:inline>
      if (history.state?.scrollY > 0) {
        const expect = Object.assign(document.createElement('link'), {
          rel: 'expect',
          href: '#page-read',
          blocking: 'render',
        })
        document.head.append(expect)
      }
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={shareTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={shareTitle} />
    {
      article && (
        <>
          <meta property="article:author" content={article.author} />
          <meta property="article:published_time" content={article.publishedTime} />
          {article.telegramChannel && <meta property="telegram:channel" content={article.telegramChannel} />}
          <meta property="tg:site_verification" content={TELETYPE_SITE_VERIFICATION} />
          <script type="application/ld+json" set:html={JSON.stringify(articleData)} />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
    <!-- Where the page was, on a reload or a return to it. The router keeps it in the history
         entry (history.state) as each scroll ends, and restores it itself only once the whole
         page has loaded, the browser's own restoring left off: so the page goes back as soon
         as it's read, before it's first drawn (the script in the head), else it shows its top
         and jumps. Its pictures there, lazy ones it took for out of sight while it was read
         from its top, load now and are drawn with it rather than empty then filled in. A page
         the router swaps in has its scroll seen to by the router. -->
    <script is:inline id="page-read">
      if (document.readyState !== 'complete' && history.state?.scrollY > 0) {
        scrollTo(history.state.scrollX ?? 0, history.state.scrollY)
        for (const image of document.images) {
          const box = image.getBoundingClientRect()
          if (box.width > 0 && box.bottom > 0 && box.top < innerHeight) {
            Object.assign(image, { loading: 'eager', decoding: 'sync' })
          }
        }
      }
    </script>
    <script>
      import '@/trip-transition'
      import '@/year-transition'
      import '@/calendar-month-transition'
      import '@/car-model-mount'
    </script>
  </body>
</html>
