---
import { getAssetUrl } from '@/asset-url'
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts'
---

<header class="mx-auto flex max-w-[40rem] items-center">
  <a href="/" class="inline-flex items-center gap-3 no-underline">
    <img
      src={getAssetUrl('site/avatar-80.webp')}
      alt=""
      width="40"
      height="40"
      class="size-10 rounded-full"
    />
    <span class="flex flex-col">
      <span class="font-medium">{SITE_TITLE}<span class="sr-only"> 首页</span></span>
      <span class="text-tx-2" aria-hidden="true">{SITE_DESCRIPTION}</span>
    </span>
  </a>
</header>
