---
import { getAssetUrl } from '@/asset-url'
import { SITE_TAGLINE, SITE_TITLE } from '@/consts'
import { getMoments } from '@/moments'
import { getReviewYears } from '@/year-review'

const reviewed = getReviewYears(await getMoments()).length > 0
const nav = [
  { href: '/calendar/', label: '日历' },
  { href: '/trip/', label: '旅程' },
  { href: '/media/', label: '影视' },
  // Every year's review, and each year's own under it.
  ...(reviewed ? [{ href: '/life/', label: '回顾', match: /^\/(?:\d{4}|life)\/$/ }] : []),
  { href: '/use/', label: 'Use' },
]
const pathname = Astro.url.pathname
const isCurrent = (item: { href: string; match?: RegExp }) =>
  item.match ? item.match.test(pathname) : pathname.startsWith(item.href)
---

<header class="site-header">
  <a href="/" class="site-header__home">
    <img
      src={getAssetUrl('site/avatar-80.webp')}
      alt=""
      width="40"
      height="40"
      class="site-header__avatar"
    />
    <span class="site-header__name">
      <span class="site-header__title">{SITE_TITLE}<span class="sr-only"> 首页</span></span>
      <span class="site-header__description" aria-hidden="true">{SITE_TAGLINE}</span>
    </span>
  </a>
  <nav aria-label="主导航" class="site-header__nav">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    max-width: 40rem;
    margin-inline: auto;
    line-height: 1.75rem;

    @media (width >= 40rem) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .site-header__home {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .site-header__avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
  }

  .site-header__name {
    display: flex;
    flex-direction: column;
  }

  .site-header__title {
    font-weight: 500;
  }

  .site-header__description {
    color: var(--color-tx-2);
  }

  /* The links light up on a pill a little larger than their text. */
  .site-header__nav {
    isolation: isolate;
    display: flex;
    gap: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: var(--color-tx-2);

    & a {
      position: relative;
      text-decoration: none;
      transition: color 150ms var(--ease);

      &::before {
        content: '';
        position: absolute;
        inset: -0.25rem -0.5rem;
        z-index: -1;
        border-radius: 9999px;
        background: var(--color-hover);
        opacity: 0;
        transition: opacity 150ms var(--ease);
      }

      &[aria-current] {
        color: var(--color-tx);

        &::before {
          opacity: 1;
        }
      }

      @media (hover: hover) {
        &:hover {
          color: var(--color-tx);

          &::before {
            opacity: 1;
          }
        }
      }
    }
  }
</style>
