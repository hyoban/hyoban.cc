---
import { getAssetUrl } from '@/asset-url'
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts'

const nav = [
  { href: '/calendar/', label: '日历' },
  { href: '/trip/', label: '旅程' },
  { href: '/media/', label: '影视' },
  { href: '/use/', label: 'Use' },
]
const pathname = Astro.url.pathname
---

<header class="mx-auto flex max-w-[40rem] flex-col items-start gap-6 leading-7 sm:flex-row sm:items-center sm:justify-between">
  <a href="/" class="inline-flex items-center gap-3 no-underline">
    <img
      src={getAssetUrl('site/avatar-80.webp')}
      alt=""
      width="40"
      height="40"
      class="size-10 rounded-full"
    />
    <span class="flex flex-col">
      <span class="font-medium">{SITE_TITLE}<span class="sr-only"> 首页</span></span>
      <span class="text-tx-2" aria-hidden="true">{SITE_DESCRIPTION}</span>
    </span>
  </a>
  <nav aria-label="主导航" class="isolate flex gap-5 text-sm text-tx-2">
    {
      nav.map(({ href, label }) => (
        <a
          href={href}
          aria-current={pathname.startsWith(href) ? 'page' : undefined}
          class="relative no-underline transition-colors before:absolute before:-inset-x-2 before:-inset-y-1 before:-z-10 before:rounded-full before:bg-hover before:opacity-0 before:transition-opacity hover:text-tx hover:before:opacity-100 aria-[current]:text-tx aria-[current]:before:opacity-100"
        >
          {label}
        </a>
      ))
    }
  </nav>
</header>
