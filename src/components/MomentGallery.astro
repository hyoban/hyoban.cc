---
import { BLANK_IMAGE } from '@/consts'
import { getTextLang } from '@hyoban/trip-map'
import type { ResolvedMomentMedia } from '@/moments'

interface Props {
  media: ResolvedMomentMedia[]
  /** The viewport where this gallery opens the page; its images load first there and not at all elsewhere. */
  priorityMedia?: string | undefined
}

const { media, priorityMedia } = Astro.props
const isSingle = media.length === 1
const imageSizes = isSingle
  ? '(max-width: 640px) calc(100vw - 2rem), 960px'
  : '(max-width: 640px) calc((100vw - 2.25rem) / 2), 480px'
---

<div class:list={['moment-gallery', `moment-gallery--${Math.min(media.length, 4)}`]}>
  {
    media.map((item, index) => item.type !== 'video'
      ? (
          <button
            type="button"
            class="moment-gallery__item moment-gallery__image"
            data-lightbox-item
            data-lightbox-src={item.src.src}
            data-lightbox-alt={item.alt}
            data-lightbox-video={item.type === 'live-photo' ? item.video.src : undefined}
          >
            <span class="sr-only">{`查看${item.type === 'live-photo' ? '实况照片' : '图片'} ${index + 1}`}</span>
            <picture>
              {priorityMedia && priorityMedia !== 'all' && <source media={`not all and ${priorityMedia}`} srcset={BLANK_IMAGE} />}
              <img
                src={item.src.sources.find(source => source.width >= 960)?.src ?? item.src.sources.at(-1)?.src ?? item.src.src}
                srcset={item.src.sources.map(source => `${source.src} ${source.width}w`).join(', ')}
                sizes={imageSizes}
                alt={item.alt}
                lang={getTextLang(item.alt)}
                width={item.src.width}
                height={item.src.height}
                loading={priorityMedia ? 'eager' : 'lazy'}
                fetchpriority={priorityMedia && index === 0 ? 'high' : undefined}
                decoding="async"
              />
            </picture>
            {item.type === 'live-photo' && (
              <span class="moment-gallery__live" aria-hidden="true">
                <span class="i-lucide-circle-dot" /> LIVE
              </span>
            )}
          </button>
        )
      : (
          <div class="moment-gallery__item moment-gallery__video">
            <video
              controls
              preload={item.poster ? 'none' : 'metadata'}
              poster={item.poster?.src}
              aria-label={item.alt || `视频 ${index + 1}`}
              lang={getTextLang(item.alt)}
            >
              <source src={item.src} type={item.contentType} />
            </video>
          </div>
        ))
  }
</div>

<style>
  /* One photo at its own shape, or two to a row cut to 4:3, the first of three as tall
     as the other two. Nothing clips the grid, so a focused photo's ring shows whole. */
  .moment-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;
    margin-top: 0.875rem;
  }

  .moment-gallery--1 {
    grid-template-columns: minmax(0, 1fr);
  }

  .moment-gallery--3 > :first-child {
    grid-row: span 2 / span 2;
  }

  .moment-gallery__item {
    min-width: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0.375rem;
    background: var(--color-inline);

    .moment-gallery--1 > & {
      aspect-ratio: auto;
      max-height: 32rem;
    }

    & :is(img, video) {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;

      .moment-gallery--1 & {
        height: auto;
        max-height: 32rem;
        object-fit: contain;
      }
    }
  }

  .moment-gallery__image {
    position: relative;
    cursor: zoom-in;

    & picture {
      display: contents;
    }
  }

  .moment-gallery__live {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    background: rgb(0 0 0 / 0.55);
    color: white;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.025em;

    & span {
      width: 0.75rem;
      height: 0.75rem;
    }
  }
</style>
