---
import CarModel from '@/components/CarModel.astro'
import { formatKilometers, getCarSummary } from '@/car'
import { DELIVERED_ON, getDistanceLevel, getYearWeeks, type Outing } from '@/data/vehicle'
import {
  CATEGORY_LABELS,
  HOME_KWH_YUAN,
  RUNNING_CATEGORIES,
  formatRate,
  formatYuan,
  getChargePrice,
  getCostBreakdown,
} from '@/data/vehicle-costs'
import { getActiveDateKeys, getMomentPath, getMoments } from '@/moments'

// The year as the car drove it, or every year it did, from data/zeekr: its totals, and a
// contribution graph of every day, a year's each, darker the farther it went, Monday first. A day of an outing links to its
// trip, or to its day in the calendar when it has Moments; one the records don't cover,
// before the car or after the latest capture, is left hollow. Then what it charged, when
// the records have it: how often and how much, and the hours the charges started, fast
// ones on the road over slow ones at home, with what a kWh cost. Then the ledger: what
// the year spent on the car besides buying it, by kind, and a kilometre's running cost;
// and on a life's page, what owning it has cost from the first payment on.

interface Props {
  /** The year, or none for every year the car's records reach into. */
  year?: number
}

const { year } = Astro.props
const car = await getCarSummary()
const activeDates = new Set(getActiveDateKeys(await getMoments()))
const inYear = (date: string) => year === undefined || date.startsWith(`${year}-`)
const firstYear = Number(car.span.start.slice(0, 4))
const heatYears =
  year === undefined
    ? Array.from({ length: Number(car.span.end.slice(0, 4)) - firstYear + 1 }, (_, index) => firstYear + index)
    : [year]
const days = [...car.days].filter(([date]) => inYear(date))
const distance = days.reduce((total, [, meters]) => total + meters, 0)
const drivenDays = days.filter(([, meters]) => meters > 0).length
const charges = car.charges.filter((charge) => inYear(charge.startedAt))
const fast = charges.filter((charge) => charge.type === 'DC').length
const chargedKwh = charges.reduce((total, charge) => total + charge.energyWh, 0) / 1000
// How many charges started in each hour, fast and slow.
const hours = Array.from({ length: 24 }, (_, hour) => {
  const inHour = charges.filter((charge) => Number(charge.startedAt.slice(11, 13)) === hour)
  const dc = inHour.filter((charge) => charge.type === 'DC').length
  return { ac: inHour.length - dc, dc, hour, total: inHour.length }
})
const busiestHour = hours.reduce((best, hour) => (hour.total > best.total ? hour : best))
const hourMax = Math.max(1, busiestHour.total)

const formatNumber = (value: number) => value.toLocaleString('zh-CN', { maximumFractionDigits: 0 })
const expenses = car.expenses.filter((expense) => inYear(expense.at))
const spending = getCostBreakdown(expenses.filter((expense) => expense.category !== 'purchase'))
const running = getCostBreakdown(expenses, RUNNING_CATEGORIES)
// Paired over the whole ledger, so a session late on Dec 31 keeps its payment after midnight.
const fastPrice = getChargePrice(car.chargePayments.filter(({ charge }) => inYear(charge.startedAt)))
// The slow charges are all at home, at its off-peak rate; with the fast ones that were paid
// for, what a kWh cost on average.
const homeKwh =
  charges.filter((charge) => charge.type === 'AC').reduce((total, charge) => total + charge.energyWh, 0) /
  1000
const homeYuan = homeKwh * HOME_KWH_YUAN
const pricedKwh = fastPrice.energyWh / 1000 + homeKwh
const averageKwhYuan = pricedKwh > 0 ? (fastPrice.fen / 100 + homeYuan) / pricedKwh : undefined
// The biggest kinds each get a band of the bar, and two or more left over one band
// together; a single one left keeps its name.
const BANDS = 5
const named = spending.categories.length > BANDS + 1 ? spending.categories.slice(0, BANDS) : spending.categories
const rest = spending.categories.slice(named.length)
const bands = [
  ...named.map(({ category, fen }) => ({ fen, label: CATEGORY_LABELS[category] })),
  ...(rest.length > 0
    ? [{ fen: rest.reduce((total, { fen }) => total + fen, 0), label: '其他' }]
    : []),
]

// Owning it so far, on a life's page only: everything paid up to the latest capture, less
// what had come back by then, counted from the day it was handed over.
const ownedUntil = car.span.end
const owned =
  year === undefined && DELIVERED_ON <= ownedUntil
    ? car.expenses.filter((expense) => expense.at.slice(0, 10) <= ownedUntil)
    : []
const ownedCost = getCostBreakdown(owned, undefined, ownedUntil)
const ownedDays = Math.round((Date.parse(ownedUntil) - Date.parse(DELIVERED_ON)) / 86_400_000) + 1
const ownedDriving = [...car.days].filter(([date]) => date <= ownedUntil)
const ownedMeters = ownedDriving.reduce((total, [, meters]) => total + meters, 0)
// Shared out over the days it was driven, not every day it was owned.
const ownedDrivenDays = ownedDriving.filter(([, meters]) => meters > 0).length
const ownership: Tile[] | false = ownedCost.total > 0 && [
  { label: `提车 ${formatNumber(ownedDays)} 天`, value: formatYuan(ownedCost.total), note: '含购车' },
  ...(ownedDrivenDays > 0
    ? [
        {
          label: '开车的日子',
          value: formatNumber(ownedDrivenDays),
          unit: '天',
          note: `每天 ${formatYuan(ownedCost.total / ownedDrivenDays)}`,
        },
      ]
    : []),
  ...(ownedMeters > 0
    ? [{ label: '每公里', value: formatRate(ownedCost.total / 100 / (ownedMeters / 1000)), note: '含购车' }]
    : []),
]

const longest = days.reduce<[string, number] | undefined>(
  (best, day) => (!best || day[1] > best[1] ? day : best),
  undefined,
)

const outingByDate = new Map<string, Outing>()
for (const outing of car.outings) {
  for (const [date] of days) {
    if (outing.start <= date && date <= outing.end) outingByDate.set(date, outing)
  }
}
// A trip's days all lead to it: Tab stops at its first only, the rest kept for the pointer
// and the screen reader's list of links.
const tabbedHrefs = new Set<string>()
const getOutingHref = (outing: Outing, date: string) =>
  outing.trip
    ? `/trip/${outing.trip.id}/`
    : activeDates.has(date)
      ? getMomentPath(date)
      : undefined

const formatDay = (date: string) =>
  `${year === undefined ? `${date.slice(0, 4)} 年 ` : ''}${Number(date.slice(5, 7))} 月 ${Number(date.slice(8))} 日`
const weekdayLabels = ['一', '', '三', '', '五', '', '日']
const heatmaps = heatYears.map((at) => {
  const weeks = getYearWeeks(at, car.days, car.span)
  const months = weeks.map((week) => {
    const first = week.find((cell) => cell?.date.endsWith('-01'))
    return first ? Number(first.date.slice(5, 7)) : undefined
  })
  // The year in two halves from the week July starts in, side by side as one row where
  // there's room and one over the other on a phone, where a whole year's days would be
  // too small to see.
  const july = months.indexOf(7)
  const split = july > 0 ? july : Math.ceil(weeks.length / 2)
  // A half the records don't reach into at all, before the car, is left out on a phone;
  // in a row it keeps the year whole.
  const halves = [
    { weeks: weeks.slice(0, split), months: months.slice(0, split) },
    { weeks: weeks.slice(split), months: months.slice(split) },
  ].map((half) => ({
    ...half,
    blank: !half.weeks.some((week) => week.some((cell) => cell?.distanceMeters !== undefined)),
  }))
  return { year: at, weeks, halves }
})
// What the graph's readout says while no day is pointed at.
const farthest =
  longest && longest[1] > 0 ? `最远一天 ${formatKilometers(longest[1])}\u2003${formatDay(longest[0])}` : ''
/** A figure under what it counts, with what it's in and a word more under it. */
type Tile = { label: string; value: string; unit?: string; note?: string }
// Fast charges on the road and slow ones at home, each with what a kWh of it cost, then
// all that went in.
const chargingTiles: Tile[] = [
  {
    label: '快充',
    value: formatNumber(fast),
    unit: '次',
    ...(fastPrice.yuanPerKwh !== undefined && { note: `每 kWh ${formatRate(fastPrice.yuanPerKwh)}` }),
  },
  {
    label: '家充',
    value: formatNumber(charges.length - fast),
    unit: '次',
    note: `每 kWh ${formatRate(HOME_KWH_YUAN)}`,
  },
  {
    label: '充入',
    value: formatNumber(chargedKwh),
    unit: 'kWh',
    ...(averageKwhYuan !== undefined && { note: `平均每 kWh ${formatRate(averageKwhYuan)}` }),
  },
]
const spendingTiles: Tile[] = [
  { label: '用车花费', value: formatYuan(spending.total), note: '不含购车' },
  ...(distance > 0 && running.total > 0
    ? [{ label: '开一公里', value: formatRate(running.total / 100 / (distance / 1000)), note: '不含保险' }]
    : []),
]
---

<CarModel />
<p class="year-lead">
  <span>
    {formatNumber(distance / 1000)}<small>km</small>
  </span>
  <span>
    {drivenDays}<small>天开了车</small>
  </span>
</p>
<div class="year-driving__years">
  {
    heatmaps.map(({ year: at, weeks, halves }) => (
      <>
        {heatmaps.length > 1 && <h3 class="year-driving__year">{at}</h3>}
        <div
          class="year-driving"
          style={`--weeks: ${weeks.length}; --half-weeks: ${Math.max(...halves.map((half) => half.weeks.length))}`}
        >
          {halves.map((half, index) => (
            <div
              class:list={['year-driving__half', { 'is-blank': half.blank }]}
              data-half={index}
              style={`--weeks: ${half.weeks.length}`}
            >
              <div class="year-driving__months" aria-hidden="true">
                {half.months.map((month) => (
                  <span>
                    {month}
                    {month && <span class="year-driving__month-unit"> 月</span>}
                  </span>
                ))}
              </div>
              <div class="year-driving__weekdays" aria-hidden="true">
                {weekdayLabels.map((label) => (
                  <span>{label}</span>
                ))}
              </div>
              <div class="year-driving__grid">
                {half.weeks.flatMap((week) =>
                  week.map((cell) => {
                    if (!cell) return <span class="year-driving__cell" data-outside />
                    if (cell.distanceMeters === undefined) {
                      return (
                        <span class="year-driving__cell" data-empty title={`${formatDay(cell.date)}\u2003没有记录`} />
                      )
                    }
                    const title = `${formatDay(cell.date)}\u2003${cell.distanceMeters ? formatKilometers(cell.distanceMeters) : '没开'}`
                    const outing = outingByDate.get(cell.date)
                    const href = outing && getOutingHref(outing, cell.date)
                    const tabbed = href !== undefined && tabbedHrefs.has(href)
                    if (href) tabbedHrefs.add(href)
                    return href ? (
                      <a
                        class="year-driving__cell"
                        data-level={getDistanceLevel(cell.distanceMeters)}
                        href={href}
                        tabindex={tabbed ? -1 : undefined}
                        title={outing.trip ? `${title}\u2003${outing.trip.title}` : title}
                        aria-label={outing.trip ? `${title}，${outing.trip.title}` : title}
                      />
                    ) : (
                      <span class="year-driving__cell" data-level={getDistanceLevel(cell.distanceMeters)} title={title} />
                    )
                  }),
                )}
              </div>
            </div>
          ))}
        </div>
      </>
    ))
  }
</div>
<div class="year-driving__legend" aria-hidden="true">
  <span class="year-driving__readout" data-readout={farthest}>{farthest}</span>
  <span class="year-driving__key">
    <span>没开</span>
    {[0, 1, 2, 3, 4].map((level) => <span class="year-driving__cell" data-level={level} />)}
    <span>300 km+</span>
  </span>
</div>
{
  charges.length > 0 && (
    <>
      <h3 class="year-driving__part">充电</h3>
      <dl class="year-driving__tiles">
        {chargingTiles.map((tile) => (
          <div>
            <dt>{tile.label}</dt>
            <dd>
              {tile.value}
              {tile.unit && <small>{tile.unit}</small>}
            </dd>
            {tile.note && <dd class="year-driving__note">{tile.note}</dd>}
          </div>
        ))}
      </dl>
      <div
        class="year-driving__hours"
        role="img"
        aria-label={`每个小时开始的充电：${hours.filter((hour) => hour.total > 0).map((hour) => `${hour.hour} 点 ${hour.total} 次`).join('，')}`}
      >
        {hours.map((hour) => (
          <span
            class:list={['year-driving__hour', { 'is-top': hour.total === busiestHour.total && hour.total > 0 }]}
            title={`${hour.hour} 点\u2003快充 ${hour.dc} 次\u2003家充 ${hour.ac} 次`}
            style={`--hour: ${hour.hour}`}
          >
            <span class="year-driving__hour-ac" style={`height: ${(hour.ac / hourMax) * 100}%`} />
            <span class="year-driving__hour-dc" style={`height: ${(hour.dc / hourMax) * 100}%`} />
          </span>
        ))}
        {[0, 6, 12, 18].map((hour) => (
          <span class="year-driving__hour-label" style={`grid-column: ${hour + 1}`} aria-hidden="true">
            {hour}
          </span>
        ))}
      </div>
      <div class="year-driving__legend" aria-hidden="true">
        <span class="year-driving__readout" data-readout={`最多在 ${busiestHour.hour} 点`}>
          最多在 {busiestHour.hour} 点
        </span>
        <span class="year-driving__key">
          <span class="year-driving__swatch is-dc" />
          <span>快充</span>
          <span class="year-driving__swatch is-ac" />
          <span>家充</span>
        </span>
      </div>
    </>
  )
}
{
  spending.total > 0 && (
    <>
      <h3 class="year-driving__part">花费</h3>
      <dl class="year-driving__tiles">
        {spendingTiles.map((tile) => (
          <div>
            <dt>{tile.label}</dt>
            <dd>
              {tile.value}
              {tile.unit && <small>{tile.unit}</small>}
            </dd>
            {tile.note && <dd class="year-driving__note">{tile.note}</dd>}
          </div>
        ))}
      </dl>
      <div
        class="year-driving__bar"
        role="img"
        aria-label={`花费构成：${bands.map((band) => `${band.label} ${formatYuan(band.fen)}`).join('，')}`}
      >
        {bands.map((band, index) => (
          <span
            class="year-driving__band"
            data-band={index}
            style={`flex-grow: ${band.fen}`}
            title={`${band.label} ${formatYuan(band.fen)}`}
          />
        ))}
      </div>
      <ul class="year-driving__bands">
        {bands.map((band, index) => (
          <li>
            <span class="year-driving__band year-driving__swatch" data-band={index} />
            {band.label}
            <span class="year-driving__amount">{formatYuan(band.fen)}</span>
          </li>
        ))}
      </ul>
    </>
  )
}
{
  ownership && (
    <>
      <h3 class="year-driving__part">提车以来</h3>
      <dl class="year-driving__tiles">
        {ownership.map((tile) => (
          <div>
            <dt>{tile.label}</dt>
            <dd>
              {tile.value}
              {tile.unit && <small>{tile.unit}</small>}
            </dd>
            {tile.note && <dd class="year-driving__note">{tile.note}</dd>}
          </div>
        ))}
      </dl>
    </>
  )
}

<script>
  // The legend's readout says what the day or hour pointed at was, and goes back to its
  // own words when the pointer leaves.
  function initializeReadouts() {
    for (const readout of document.querySelectorAll<HTMLElement>('.year-driving__readout')) {
      const chart = readout.parentElement?.previousElementSibling
      if (!chart) continue
      const show = (event: Event) => {
        const target = (event.target as Element).closest<HTMLElement>('[title]')
        readout.textContent = target?.title || readout.dataset.readout || ''
        readout.classList.toggle('is-live', Boolean(target))
      }
      chart.addEventListener('pointerover', show)
      chart.addEventListener('focusin', show)
      const reset = () => {
        readout.textContent = readout.dataset.readout ?? ''
        readout.classList.remove('is-live')
      }
      chart.addEventListener('pointerleave', reset)
      chart.addEventListener('focusout', (event) => {
        if (!chart.contains((event as FocusEvent).relatedTarget as Node | null)) reset()
      })
    }
  }

  document.addEventListener('astro:page-load', initializeReadouts)
</script>

<style>
  /* Charging, spending and owning it, each a part of its own well apart from the last. */
  .year-driving__part {
    margin: 3rem 0 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-tx-2);
    font-size: 0.875rem;
    font-weight: 500;
  }

  /* A row of figures, each over what it counts. */
  .year-driving__tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0 0 1.5rem;
    font-variant-numeric: tabular-nums;

    & div {
      display: flex;
      flex-direction: column;
    }

    & dt {
      color: var(--color-tx-2);
      font-size: 0.8125rem;
    }

    & dd {
      font-size: 1.5rem;
      font-weight: 700;
      line-height: 2rem;
      letter-spacing: -0.03em;
      white-space: nowrap;
    }

    & small {
      margin-left: 0.25rem;
      color: var(--color-tx-2);
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0;
    }
  }

  .year-driving__tiles .year-driving__note {
    color: var(--color-tx-3);
    font-size: 0.75rem;
    font-weight: 400;
    line-height: 1rem;
    letter-spacing: 0;
  }

  /* What the chart's pointer is on, in the legend's empty start. */
  .year-driving__legend .year-driving__readout {
    margin-right: auto;
    color: var(--color-tx-2);
    font-variant-numeric: tabular-nums;
    transition: color 140ms var(--ease);

    &.is-live {
      color: var(--color-tx);
      font-weight: 500;
    }
  }

  /* Every year's graph, one under another, each named. */
  .year-driving__year {
    margin: 1.25rem 0 0.375rem;
    color: var(--color-tx-2);
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;

    &:first-child {
      margin-top: 0;
    }
  }

  /* A year's graph: a column for the weekdays' names, then a column a week, which each
     half takes its share of. On a phone the halves are one over the other, as wide as the
     longer; where there's room, side by side, the second without the names again. */
  .year-driving {
    --gap: 2px;
    display: grid;
    grid-template-columns: auto repeat(var(--half-weeks), minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 0.875rem;
    color: var(--color-tx-3);
    font-size: 0.625rem;
    line-height: 1;

    @media (width >= 40rem) {
      grid-template-columns: auto repeat(var(--weeks), minmax(0, 1fr));
    }
  }

  .year-driving__half {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    row-gap: 0.25rem;

    @media (width < 40rem) {
      &.is-blank {
        display: none;
      }
    }

    @media (width >= 40rem) {
      &[data-half='0'] {
        grid-column: 1 / span calc(var(--weeks) + 1);
      }

      &[data-half='1'] {
        grid-row: 1;
        grid-column: span var(--weeks) / -1;

        & .year-driving__weekdays {
          display: none;
        }

        & :is(.year-driving__months, .year-driving__grid) {
          grid-column: 1 / -1;
        }
      }
    }
  }

  .year-driving__months,
  .year-driving__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 2 / span var(--weeks);
  }

  .year-driving__months span {
    white-space: nowrap;
  }

  .year-driving__weekdays {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    row-gap: var(--gap);
    grid-row: 2;
    padding-right: 0.25rem;
  }

  .year-driving__grid {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
    row-gap: var(--gap);
  }

  .year-driving__cell {
    display: block;
    aspect-ratio: 1;
    border-radius: 1px;
    background: var(--color-hover);

    &[data-outside] {
      background: none;
    }

    &[data-empty] {
      background: none;
      box-shadow: inset 0 0 0 1px var(--color-hover);
    }

    &[data-level='1'] {
      background: color-mix(in srgb, var(--color-tx) 20%, var(--color-hover));
    }

    &[data-level='2'] {
      background: color-mix(in srgb, var(--color-tx) 40%, var(--color-hover));
    }

    &[data-level='3'] {
      background: color-mix(in srgb, var(--color-tx) 65%, var(--color-hover));
    }

    &[data-level='4'] {
      background: var(--color-tx);
    }
  }


  /* What the year spent, a band a kind, the biggest darkest. */
  .year-driving__bar {
    display: flex;
    gap: 2px;
    height: 0.75rem;
  }

  .year-driving__bar .year-driving__band {
    flex-basis: 0;
    min-width: 2px;
    border-radius: 1px;
  }

  .year-driving__band {
    &[data-band='0'] {
      background: var(--color-tx);
    }

    &[data-band='1'] {
      background: color-mix(in srgb, var(--color-tx) 75%, var(--color-hover));
    }

    &[data-band='2'] {
      background: color-mix(in srgb, var(--color-tx) 55%, var(--color-hover));
    }

    &[data-band='3'] {
      background: color-mix(in srgb, var(--color-tx) 38%, var(--color-hover));
    }

    &[data-band='4'] {
      background: color-mix(in srgb, var(--color-tx) 22%, var(--color-hover));
    }

    &[data-band='5'] {
      background: color-mix(in srgb, var(--color-tx) 10%, var(--color-hover));
    }
  }

  .year-driving__bands {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--color-tx-2);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;

    li {
      display: flex;
      gap: 0.375rem;
      align-items: center;
    }

    .year-driving__swatch {
      display: block;
    }
  }

  .year-driving__amount {
    color: var(--color-tx-3);
  }

  /* When the charges started, an hour a column, slow ones at the bottom and fast on top. */
  .year-driving__hours {
    display: grid;
    grid-template-columns: repeat(24, minmax(0, 1fr));
    grid-template-rows: 5rem auto;
    column-gap: 2px;
    color: var(--color-tx-3);
    font-size: 0.625rem;
    line-height: 1;
  }

  .year-driving__hour {
    display: flex;
    flex-direction: column-reverse;
    grid-row: 1;
    border-bottom: 1px solid var(--color-border);
  }

  .year-driving__hour-ac,
  .year-driving__swatch.is-ac {
    background: color-mix(in srgb, var(--color-tx) 30%, var(--color-hover));
  }

