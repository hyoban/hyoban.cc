---
import SiteFooter from '@/components/SiteFooter.astro'
import SiteHeader from '@/components/SiteHeader.astro'

interface Props {
  description?: string | undefined
  title?: string | undefined
}

const { description, title } = Astro.props
---

<div class="site-page">
  <SiteHeader />
  <main class="site-page__main">
    {
      title && (
        <header class="site-page__header">
          <h1 class="site-page__title">{title}</h1>
          {description && <p class="site-page__description">{description}</p>}
        </header>
      )
    }
    <slot />
  </main>
  <SiteFooter />
</div>

<style>
  @media (width >= 40rem) {
    .site-page {
      padding-top: 4rem;
    }
  }

  .site-page__main {
    max-width: 40rem;
    margin: 3.5rem auto 0;
    line-height: 1.75rem;
  }

  .site-page__header {
    margin-bottom: 2rem;
  }

  .site-page__title {
    font-weight: 500;
  }

  .site-page__description {
    color: var(--color-tx-2);
  }
</style>
