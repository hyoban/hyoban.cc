---
import { formatChange, type YearTopic } from '@/year-review'

// What the year was written about, under the clock: a bar for each topic as long as how
// much was written on it, the most written dark, with its count and how it moved from the
// year before.

interface Props {
  topics: YearTopic[]
}

const { topics } = Astro.props
const names: Record<YearTopic['topic'], string> = {
  travel: '旅行',
  food: '吃喝',
  car: '用车',
  photo: '摄影',
  life: '生活',
}
const max = Math.max(1, ...topics.map((topic) => topic.count))
const rows = topics.map((topic, index) => ({
  ...topic,
  index,
  name: names[topic.topic],
  top: topic.count === max,
  width: `${(topic.count / max) * 100}%`,
  change:
    topic.previous === 0
      ? undefined
      : formatChange(Math.round(((topic.count - topic.previous) / topic.previous) * 100)),
}))
---

<ul class="year-topics" aria-label="记了什么，和去年相比">
  {
    rows.map((row) => (
      <li class:list={{ 'is-top': row.top }} style={`--row: ${row.index}`}>
        <span class="year-topics__name">{row.name}</span>
        <span class="year-topics__track" aria-hidden="true">
          <span class="year-topics__bar" style={`width: ${row.width}`} />
        </span>
        <span class="year-topics__count">{row.count}</span>
        <span class="year-topics__change">{row.change}</span>
      </li>
    ))
  }
</ul>

<style>
  .year-topics {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto 3.5rem;
    gap: 0.5rem 0.75rem;
    width: min(100%, 28rem);
    margin: 2rem auto 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;

    & li {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      align-items: center;
    }
  }

  .year-topics__name {
    color: var(--color-tx-2);
  }

  .year-topics__bar {
    display: block;
    height: 0.625rem;
    min-width: 2px;
    border-radius: 3px;
    background: var(--color-tx-3);
    opacity: 0.45;
  }

  .year-topics__count {
    color: var(--color-tx);
    text-align: end;
  }

  .year-topics__change {
    color: var(--color-tx-3);
    font-size: 0.75rem;
  }

  .is-top {
    & .year-topics__bar {
      background: var(--color-tx);
      opacity: 1;
    }

    & .year-topics__name,
    & .year-topics__count {
      color: var(--color-tx);
      font-weight: 600;
    }
  }

  /* The bars grow out from the left, one after another, once the clock and days have. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.is-revealed) .year-topics__bar {
      transform-origin: left center;
      animation: year-topics-grow 700ms var(--ease-out) backwards;
      animation-delay: calc(700ms + var(--row) * 60ms);
    }
  }

  @keyframes year-topics-grow {
    from {
      opacity: 0;
      scale: 0.2 1;
    }
  }
</style>
