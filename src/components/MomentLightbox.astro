---
import MomentLightboxMedia from '@/components/MomentLightboxMedia.astro'
---

<dialog class="moment-lightbox" data-moment-lightbox aria-label="图片查看器">
  <button type="button" class="moment-lightbox__close" data-lightbox-close aria-label="关闭图片"><span class="i-lucide-x" aria-hidden="true" /></button>
  <button type="button" class="moment-lightbox__previous" data-lightbox-previous aria-label="上一张图片"><span class="i-lucide-chevron-left" aria-hidden="true" /></button>
  <MomentLightboxMedia />
  <button type="button" class="moment-lightbox__next" data-lightbox-next aria-label="下一张图片"><span class="i-lucide-chevron-right" aria-hidden="true" /></button>
</dialog>

<script>
  import { initializeLightboxMedia } from '@/moment-lightbox-client'

  let lightboxController: AbortController | undefined

  // Opens every gallery image on the page, stepping through them all in page order.
  function initializeLightbox() {
    lightboxController?.abort()
    lightboxController = new AbortController()
    const { signal } = lightboxController
    const lightbox = document.querySelector<HTMLDialogElement>('[data-moment-lightbox]')
    const lightboxMedia = lightbox ? initializeLightboxMedia(lightbox, signal) : undefined
    const lightboxItems = [...document.querySelectorAll<HTMLElement>('[data-lightbox-item]')]
    let lightboxIndex = 0

    function showLightboxItem(index: number) {
      if (!lightbox || !lightboxMedia || lightboxItems.length === 0) {
        return
      }

      lightboxIndex = (index + lightboxItems.length) % lightboxItems.length
      const item = lightboxItems[lightboxIndex]

      if (!item) {
        return
      }

      lightboxMedia.show(item)
    }

    for (const [index, item] of lightboxItems.entries()) {
      item.addEventListener('click', () => {
        showLightboxItem(index)
        lightbox?.showModal()
      }, { signal })
    }

    lightbox?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => lightbox.close(), { signal })
    lightbox?.querySelector('[data-lightbox-previous]')?.addEventListener('click', () => showLightboxItem(lightboxIndex - 1), { signal })
    lightbox?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => showLightboxItem(lightboxIndex + 1), { signal })
    lightbox?.addEventListener('click', event => {
      if (event.target === lightbox) {
        lightbox.close()
      }
    }, { signal })
    lightbox?.addEventListener('keydown', event => {
      if (event.key === 'ArrowLeft') {
        showLightboxItem(lightboxIndex - 1)
      } else if (event.key === 'ArrowRight') {
        showLightboxItem(lightboxIndex + 1)
      }
    }, { signal })
  }

  document.addEventListener('astro:page-load', initializeLightbox)
  document.addEventListener('astro:before-swap', () => lightboxController?.abort())
  initializeLightbox()
</script>

<style>
  .moment-lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: auto;
    padding: 3rem;
    background: transparent;

    &[open] {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    &::backdrop {
      background: rgb(17 17 16 / 0.92);
    }

    @media (width < 40rem) {
      padding-inline: 1rem;
    }

    /* Clear of the close button above and of the live button and a phone's arrows below. */
    & [data-lightbox-image] {
      max-width: calc(100vw - 10rem);
      max-height: calc(100dvh - 9rem);
      object-fit: contain;

      @media (width < 40rem) {
        max-width: calc(100vw - 2rem);
      }
    }
  }

  :is(.moment-lightbox__close, .moment-lightbox__previous, .moment-lightbox__next) {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.08);
    color: white;
    cursor: pointer;
  }

  .moment-lightbox__close {
    top: 1.25rem;
    right: 1.25rem;
  }

  /* Halfway down the sides, or along the foot on a phone. */
  :is(.moment-lightbox__previous, .moment-lightbox__next) {
    top: calc(50% - 1.25rem);

    @media (width < 40rem) {
      top: auto;
      bottom: 1rem;
    }
  }

  .moment-lightbox__previous {
    left: 1.25rem;
  }

  .moment-lightbox__next {
    right: 1.25rem;
  }
</style>
