---
const links = [
  { href: 'https://x.com/hyoban_cc', label: 'X', icon: 'i-simple-icons-x' },
  { href: 'https://bsky.app/profile/hyoban.cc', label: 'Bluesky', icon: 'i-simple-icons-bluesky' },
  { href: 'https://www.threads.com/@hyoban.cc', label: 'Threads', icon: 'i-simple-icons-threads' },
  { href: 'https://www.instagram.com/hyoban.cc/', label: 'Instagram', icon: 'i-simple-icons-instagram' },
  { href: 'https://t.me/hyoban', label: 'Telegram', icon: 'i-simple-icons-telegram' },
  { href: 'https://t.me/s/hyoban_travel', label: 'Telegram 旅行频道', icon: 'i-lucide-plane' },
  { href: 'https://www.xiaohongshu.com/user/profile/64085a45000000000f01228d', label: '小红书', icon: 'i-simple-icons-xiaohongshu' },
  { href: 'https://space.bilibili.com/223973299', label: '哔哩哔哩', icon: 'i-simple-icons-bilibili' },
  { href: 'https://www.douyin.com/user/MS4wLjABAAAAe8zudLMaaVsjaz6Q1gSengwTquxVRbKjl6OyRytNGac', label: '抖音', icon: 'i-simple-icons-tiktok' },
  { href: 'https://photos.hyoban.cc/', label: 'Photos', icon: 'i-lucide-images' },
  { href: 'https://github.com/hyoban', label: 'GitHub', icon: 'i-simple-icons-github' },
  { href: '/rss.xml', label: 'RSS', icon: 'i-simple-icons-rss' },
  { href: 'mailto:hi@hyoban.cc', label: 'hi@hyoban.cc', icon: 'i-lucide-mail' },
]
---

<footer class="mx-auto mt-20 flex max-w-[40rem] flex-wrap items-center gap-x-5 gap-y-4 pt-8">
  {
    links.map(({ href, label, icon }) => (
      <a
        href={href}
        aria-label={label}
        title={label}
        class="text-tx-3 no-underline transition-colors hover:text-tx"
        {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <span class={`${icon} block size-4`} aria-hidden="true" />
      </a>
    ))
  }
</footer>
