---
import MomentGallery from '@/components/MomentGallery.astro'
import MomentText from '@/components/MomentText.astro'
import { getMomentPagePath, getMomentPath, type Moment } from '@/moments'
import { getMomentTrips } from '@/moments/trip-data'
import type { FoodVerdict } from '@hyoban/data-spec'

interface Props {
  /**
   * Leads the line with its day, linking to the day in the calendar: out of the
   * calendar. `year` says the year too, for Moments of more than one.
   */
  date?: 'day' | 'year' | undefined
  moment: Moment
  /** Passed to the gallery when this entry opens the page. */
  priorityMedia?: string | undefined
  /** The Moment a shared link names, set off from the rest of its day. */
  shared?: boolean
  /** Leaves out one of the places: the one whose drawer the Moment shows in. */
  exceptLocation?: string
  showLocation?: boolean
  /** Links the trip the Moment is a stop of, picked in the trip list; off beside the trip's own link. */
  showTrip?: boolean
  /** In the trip's own sidebar, the link plays the trip from this Moment's card instead. */
  tripLink?: 'pick' | 'play'
}

const { date, exceptLocation, moment, priorityMedia, shared = false, showLocation = true, showTrip = true, tripLink = 'pick' } = Astro.props
const trip = showTrip ? (await getMomentTrips()).get(moment.id) : undefined
// A place opens on the map narrowed to the Moment's month, with its Moments beside it.
const mapMonthPath = `/map/${moment.dateKey.slice(0, 4)}/${moment.dateKey.slice(5, 7)}/place/`
// In the trip's own sidebar, the stop the Moment is: reading the sidebar plays the trip
// along on the map, arriving there as it's reached (see trip-map's trip-scroll.ts).
const stopEntry = tripLink === 'play' ? trip?.anchor : undefined
const weekdayFormatter = new Intl.DateTimeFormat('zh-CN', { timeZone: 'UTC', weekday: 'short' })
const priceFormatter = new Intl.NumberFormat('zh-CN', { maximumFractionDigits: 2 })
const verdictLabels: Record<FoodVerdict, string> = { good: '好吃', ok: '一般', bad: '踩雷' }
// What was eaten, how it was and what it cost, each left out when the record doesn't say.
const food = moment.food
const bill = food?.bill
const foodParts = food
  ? [
      food.dishes.join('、'),
      food.verdict && verdictLabels[food.verdict],
      bill && [`¥${priceFormatter.format(bill.amount)}`, bill.people && `${bill.people} 人`].filter(Boolean).join('\u2003'),
    ].filter(Boolean)
  : []

function formatDay(dateKey: string) {
  const [year, month, day] = dateKey.split('-').map(part => Number.parseInt(part, 10))
  const weekday = weekdayFormatter.format(new Date(`${dateKey}T00:00:00Z`))
  const monthDay = [month, day].join('/')
  return date === 'year' ? `${year}/${monthDay} ${weekday}` : `${monthDay} ${weekday}`
}
---

<article
  class:list={['moment-entry', { 'moment-entry--shared': shared }]}
  data-moment-shared={shared ? '' : undefined}
  data-trip-map-stop-entry={stopEntry}
>
  <!-- One line: the date, the time and the share button whole, and the places cut short
       when the column is too narrow for them. -->
  <header class="moment-entry__header">
    {
      date && (
        <a class="moment-entry__date" href={getMomentPath(moment.dateKey)}>
          <time datetime={moment.dateKey}>{formatDay(moment.dateKey)}</time>
        </a>
      )
    }
    {moment.occurredLabel && <time datetime={moment.occurredAt}>{moment.occurredLabel}</time>}
    {
      showLocation && moment.locations.filter(location => location.id !== exceptLocation).map(location => (
        <a class="moment-entry__location" href={`${mapMonthPath}${location.id}/`} data-trip-map-place-link={location.id}>
          <span class="i-lucide-map-pin" aria-hidden="true" />
          <span class="moment-entry__location-name">{location.name}</span>
        </a>
      ))
    }
    <a class="moment-entry__share" href={getMomentPagePath(moment)} aria-label="分享这条 Moment" title="分享" data-moment-share>
      <span class="i-lucide-share" aria-hidden="true" data-moment-share-icon />
    </a>
  </header>
  <MomentText text={moment.text} />
  {moment.media.length > 0 && <MomentGallery media={moment.media} priorityMedia={priorityMedia} />}
  {
    foodParts.length > 0 && (
      <p class="moment-entry__food">
        <span class="i-lucide-utensils" aria-hidden="true" />
        {foodParts.map(part => <span>{part}</span>)}
      </p>
    )
  }
  {
    trip && (
      tripLink === 'play'
        ? (
            <a class="moment-entry__trip" href={`/trip/${trip.id}/play/${trip.anchor}/`} data-trip-map-stop-play={trip.id} data-trip-map-stop={trip.anchor}>
              <span class="i-lucide-play" aria-hidden="true" />
              从这里回放
            </a>
          )
        : (
            <a class="moment-entry__trip" href={`/trip/${trip.id}/`} data-trip-map-trip-pick={trip.id} aria-label={`旅程：${trip.title}`}>
              <span class="i-lucide-route" aria-hidden="true" />
              <span class="moment-entry__trip-title">{trip.title}</span>
            </a>
          )
    )
  }
</article>

<script>
  import '@/moment-entry-client'
</script>

<style>
  .moment-entry {
    padding-block: 1.5rem;

    & + & {
      border-top: 1px solid var(--color-border);
    }
  }

  /* The Moment a shared link names, on a tint reaching a little past the column. */
  .moment-entry--shared {
    margin-inline: -0.75rem;
    padding-inline: 0.75rem;
    border-radius: 0.625rem;
    background: var(--color-inline);
    scroll-margin-top: 5rem;
  }

  /* Its links are 44px targets, overlapping the lines around them rather than
     spacing them out. */
  .moment-entry__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.625rem;
    color: var(--color-tx-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;

    & > * {
      flex-shrink: 0;
      white-space: nowrap;
    }

    & a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      min-height: 2.75rem;
      margin-block: -0.75rem;
      color: var(--color-tx-3);
      text-decoration: none;

      @media (hover: hover) {
        &:hover {
          color: var(--color-tx);
        }
      }
    }

    & .moment-entry__date {
      justify-content: flex-start;
      color: var(--color-tx-2);
    }

    & .moment-entry__location {
      flex-shrink: 1;
      gap: 0.25rem;
      min-width: 0;
      padding-inline: 0.25rem;
    }

    & .moment-entry__share {
      justify-content: flex-end;
      margin-left: auto;
    }

    & [class^='i-lucide-'] {
      flex-shrink: 0;
      font-size: 0.875rem;
      line-height: 1.25rem;
    }
  }

  .moment-entry__location-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* What was eaten, how it was and what it cost, quiet beside the words. */
  .moment-entry__food {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    margin-top: 0.75rem;
    color: var(--color-tx-2);
    font-size: 0.75rem;
    line-height: 1rem;

    & .i-lucide-utensils {
      flex-shrink: 0;
      color: var(--color-tx-3);
      font-size: 0.875rem;
    }

    & span:not([class]) + span {
      margin-left: 1em;
    }
  }

  /* The trip the Moment is a stop of, or the way to play it from here. */
  .moment-entry__trip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    max-width: 100%;
    margin-top: 0.75rem;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    background: var(--color-inline);
    color: var(--color-tx-2);
    font-size: 0.75rem;
    line-height: 1rem;
    text-decoration: none;

    @media (hover: hover) {
      &:hover {
        background: var(--color-hover);
        color: var(--color-tx);
      }
    }

    & .i-lucide-route {
      flex-shrink: 0;
      font-size: 0.875rem;
      line-height: 1.25rem;
    }

    & .i-lucide-play {
      flex-shrink: 0;
      font-size: 0.75rem;
    }
  }

  .moment-entry__trip-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
