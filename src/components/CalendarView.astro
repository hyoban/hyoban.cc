---
import '@hyoban/drawer/styles.css'
import CalendarBackLink from '@/components/CalendarBackLink.astro'
import CalendarAnniversaryStatus from '@/components/CalendarAnniversaryStatus.astro'
import CalendarDayStatus from '@/components/CalendarDayStatus.astro'
import CalendarModeSwitch from '@/components/CalendarModeSwitch.astro'
import CalendarAgenda from '@/components/CalendarAgenda.astro'
import MomentEntry from '@/components/MomentEntry.astro'
import MomentLightbox from '@/components/MomentLightbox.astro'
import {
  getChinaCalendarDay,
  getChinaCalendarDayDescription,
  type ChinaCalendarDay,
} from '@/china-calendar'
import { getStopAnchor } from '@/moments/trip-data'
import Layout from '@/layouts/Layout.astro'
import {
  getActiveDateKeys,
  getArchiveMonthKeys,
  getCalendarDateKey,
  getMapYears,
  getMomentDateLabel,
  getMomentExcerpt,
  getMomentPagePath,
  getMomentPath,
  getMoments,
  getMonthPath,
  getTrips,
  MOMENT_OG_IMAGES,
  type Moment,
  type ResolvedMomentMedia,
} from '@/moments'
import { BLANK_IMAGE, CALENDAR_DESKTOP_MEDIA, SITE_TITLE } from '@/consts'
import {
  getCalendarAnniversaries,
  type CalendarAnniversary,
} from '@/anniversaries'

interface Props {
  month: number
  /** A Moment of the selected day, shared on its own page: the page is about it. */
  sharedMoment?: Moment | undefined
  selectedDate?: string
  year: number
}

type CalendarDay = {
  anniversaries: CalendarAnniversary[]
  chinaCalendarDay: ChinaCalendarDay | undefined
  dateKey: string
  day: number
  mediaCount: number
  moments: Moment[]
  thumbnail: ResolvedMomentMedia | undefined
}

const { month, selectedDate, sharedMoment, year } = Astro.props
const moments = await getMoments()
const activeDateKeys = getActiveDateKeys(moments)
const monthKeys = getArchiveMonthKeys(moments)
const monthKey = `${year}-${String(month).padStart(2, '0')}`
const currentMonthIndex = monthKeys.indexOf(monthKey)
const previousMonth = currentMonthIndex > 0 ? monthKeys[currentMonthIndex - 1] : undefined
const nextMonth = currentMonthIndex >= 0 && currentMonthIndex < monthKeys.length - 1
  ? monthKeys[currentMonthIndex + 1]
  : undefined
const momentsByDate = Map.groupBy(moments, moment => moment.dateKey)
const daysInMonth = new Date(Date.UTC(year, month, 0)).getUTCDate()
const firstWeekday = (new Date(Date.UTC(year, month - 1, 1)).getUTCDay() + 6) % 7
const calendarDays: Array<CalendarDay | undefined> = Array.from({ length: firstWeekday })

for (let day = 1; day <= daysInMonth; day += 1) {
  const dateKey = `${monthKey}-${String(day).padStart(2, '0')}`
  const dayMoments = momentsByDate.get(dateKey) ?? []
  const allMedia = dayMoments.flatMap(moment => moment.media)
  const thumbnail = allMedia.find(item => item.type !== 'video' || item.poster)

  calendarDays.push({
    anniversaries: getCalendarAnniversaries(dateKey),
    chinaCalendarDay: getChinaCalendarDay(dateKey),
    dateKey,
    day,
    mediaCount: allMedia.length,
    moments: dayMoments,
    thumbnail,
  })
}

while (calendarDays.length % 7 !== 0) {
  calendarDays.push(undefined)
}

const desktopCalendarDays = calendarDays.length === 42
  ? [
      ...calendarDays.slice(0, 7).map((day, weekday) => day ?? calendarDays[35 + weekday]),
      ...calendarDays.slice(7, 35),
    ]
  : calendarDays
const activeCalendarDays = calendarDays.filter(
  (day): day is CalendarDay => Boolean(day && (day.moments.length || day.anniversaries.length)),
)
const today = getCalendarDateKey(new Date())
const selectedMoments = selectedDate ? momentsByDate.get(selectedDate) ?? [] : []
const selectedDateIndex = selectedDate ? activeDateKeys.indexOf(selectedDate) : -1
const previousDate = selectedDateIndex > 0 ? activeDateKeys[selectedDateIndex - 1] : undefined
const nextDate = selectedDateIndex >= 0 && selectedDateIndex < activeDateKeys.length - 1
  ? activeDateKeys[selectedDateIndex + 1]
  : undefined
const groupedMonths = Map.groupBy(monthKeys, key => key.slice(0, 4))
// The map narrowed to this month, or to its year when the month has no Moments (the
// map has no page for it), or the whole map for a year with none at a place.
const mapHref = getMapYears(moments).includes(year)
  ? activeDateKeys.some(key => key.startsWith(`${monthKey}-`))
    ? `/map/${year}/${String(month).padStart(2, '0')}/`
    : `/map/${year}/`
  : '/map/'
const activeMonthKeys = new Set(activeDateKeys.map(key => key.slice(0, 7)))
const description = '一些零碎记录，按发生的日期归档。'
const selectedDateLabel = selectedDate ? formatSelectedDate(selectedDate) : undefined
// A day inside a trip links to that trip's playback.
const selectedTrip = selectedDate
  ? getTrips(moments).find(trip => trip.start <= selectedDate && selectedDate <= trip.end)
  : undefined
// Opens the playback on this day, or the next day with a place when this one has none.
const selectedTripStop = selectedTrip?.stops.find(stop => stop.dateKey >= selectedDate!)
const selectedTripHref = selectedTrip
  ? `/trip/${selectedTrip.id}/play/${selectedTripStop ? `${getStopAnchor(selectedTripStop.id)}/` : ''}`
  : undefined
const sharedExcerpt = sharedMoment ? getMomentExcerpt(sharedMoment, 30) : undefined
const title = sharedMoment
  ? `${sharedExcerpt || selectedDateLabel} | ${SITE_TITLE}`
  : selectedDateLabel
    ? `${selectedDateLabel} · 日历 | ${SITE_TITLE}`
    : `${year} 年 ${month} 月 · 日历 | ${SITE_TITLE}`
const pageDescription = sharedMoment
  ? [getMomentExcerpt(sharedMoment, 120), getMomentDateLabel(sharedMoment)].filter(Boolean).join(' · ')
  : description
const pageImage = sharedMoment && MOMENT_OG_IMAGES ? `${getMomentPagePath(sharedMoment)}og.jpg` : undefined
const closePath = getMonthPath(monthKey)

function formatSelectedDate(dateKey: string) {
  const { dateDay, dateMonth, dateValue } = parseCalendarDate(dateKey)
  const weekday = new Intl.DateTimeFormat('zh-CN', {
    timeZone: 'Asia/Singapore',
    weekday: 'long',
  }).format(dateValue)

  return `${dateMonth} 月 ${dateDay} 日 · ${weekday}`
}

function formatCompactDate(dateKey: string) {
  return `${Number.parseInt(dateKey.slice(5, 7), 10)}/${Number.parseInt(dateKey.slice(8, 10), 10)}`
}

function parseCalendarDate(dateKey: string) {
  const dateYear = Number.parseInt(dateKey.slice(0, 4), 10)
  const dateMonth = Number.parseInt(dateKey.slice(5, 7), 10)
  const dateDay = Number.parseInt(dateKey.slice(8, 10), 10)

  return {
    dateDay,
    dateMonth,
    dateValue: new Date(Date.UTC(dateYear, dateMonth - 1, dateDay)),
  }
}

function getThumbnailImage(media?: ResolvedMomentMedia) {
  if (!media) {
    return undefined
  }

  return media.type === 'video' ? media.poster : media.src
}
---

<Layout title={title} description={pageDescription} image={pageImage}>
  <main
    class:list={['calendar-page', { 'calendar-page--with-drawer': selectedDate }]}
    style={`--calendar-weeks: ${desktopCalendarDays.length / 7}`}
  >
    <header class="calendar-toolbar">
      <CalendarBackLink />

      <nav class="month-navigation" aria-label="月份导航">
        {
          previousMonth
            ? <a class="month-navigation__arrow" href={getMonthPath(previousMonth)} aria-label="上一个月" data-calendar-month-link data-calendar-month-prefetch="load" data-astro-prefetch="false"><span class="i-lucide-chevron-left" aria-hidden="true" /></a>
            : <span class="month-navigation__arrow month-navigation__arrow--disabled"><span class="i-lucide-chevron-left" aria-hidden="true" /></span>
        }

        <details class="month-picker">
          <summary>{year} 年 {month} 月 <span class="i-lucide-chevron-down" aria-hidden="true" /></summary>
          <div class="month-picker__panel">
            {
              [...groupedMonths].map(([pickerYear, pickerMonths]) => (
                <section class="month-picker__year">
                  <h2>{pickerYear}</h2>
                  <div class="month-picker__months">
                    {pickerMonths.map(key => {
                      const pickerMonth = Number.parseInt(key.slice(5), 10)
                      return (
                        <a
                          href={getMonthPath(key)}
                          data-calendar-month-link
                          data-astro-prefetch="false"
                          class:list={[
                            'month-picker__month',
                            {
                              'month-picker__month--current': key === monthKey,
                              'month-picker__month--active': activeMonthKeys.has(key),
                            },
                          ]}
                        >
                          {pickerMonth}
                        </a>
                      )
                    })}
                  </div>
                </section>
              ))
            }
          </div>
        </details>

        {
          nextMonth
            ? <a class="month-navigation__arrow" href={getMonthPath(nextMonth)} aria-label="下一个月" data-calendar-month-link data-calendar-month-prefetch="load" data-astro-prefetch="false"><span class="i-lucide-chevron-right" aria-hidden="true" /></a>
            : <span class="month-navigation__arrow month-navigation__arrow--disabled"><span class="i-lucide-chevron-right" aria-hidden="true" /></span>
        }
      </nav>

      <div class="calendar-toolbar__modes">
        <CalendarModeSwitch mode="calendar" mapHref={mapHref} />
      </div>
    </header>

    <div class="desktop-calendar">
      <div class="weekday-row" aria-hidden="true">
        {['一', '二', '三', '四', '五', '六', '日'].map(day => <span>{day}</span>)}
      </div>

      <section class="calendar-grid" aria-label={`${year} 年 ${month} 月`}>
        {
          desktopCalendarDays.map((calendarDay) => {
          if (!calendarDay) {
            return <div class="calendar-day calendar-day--empty" aria-hidden="true" />
          }

          const thumbnail = getThumbnailImage(calendarDay.thumbnail)
          const isSelected = calendarDay.dateKey === selectedDate
          const isToday = calendarDay.dateKey === today
          const dayStatusDescription = calendarDay.chinaCalendarDay
            ? getChinaCalendarDayDescription(calendarDay.chinaCalendarDay)
            : undefined
          const anniversaryDescription = calendarDay.anniversaries
            .map(anniversary => anniversary.description)
            .join('，')

          if (calendarDay.moments.length === 0) {
            return (
              <div class:list={['calendar-day', { 'calendar-day--today': isToday }] }>
                <span class="calendar-day__number">{String(calendarDay.day).padStart(2, '0')}</span>
                {(calendarDay.chinaCalendarDay || calendarDay.anniversaries.length > 0) && (
                  <div class="calendar-day__statuses">
                    {calendarDay.anniversaries.map(anniversary => (
                      <CalendarAnniversaryStatus anniversary={anniversary} compact />
                    ))}
                    {calendarDay.chinaCalendarDay && (
                      <CalendarDayStatus day={calendarDay.chinaCalendarDay} compact />
                    )}
                  </div>
                )}
              </div>
            )
          }

          return (
            <a
              href={getMomentPath(calendarDay.dateKey)}
              class:list={[
                'calendar-day calendar-day--active',
                {
                  'calendar-day--selected': isSelected,
                  'calendar-day--today': isToday,
                  'calendar-day--with-media': thumbnail,
                },
              ]}
              aria-current={isSelected ? 'date' : undefined}
            >
              {/* Read this in place of the visible day cell, whose parts only make sense laid out. */}
              <span class="sr-only">{`${calendarDay.dateKey}，${calendarDay.moments.length} 条记录${anniversaryDescription ? `，${anniversaryDescription}` : ''}${dayStatusDescription ? `，${dayStatusDescription}` : ''}`}</span>
              {thumbnail && (
                <picture class="calendar-day__picture">
                  <source media={`not all and ${CALENDAR_DESKTOP_MEDIA}`} srcset={BLANK_IMAGE} />
                  <img
                    src={thumbnail.sources.find(source => source.width >= 480)?.src ?? thumbnail.sources.at(-1)?.src ?? thumbnail.src}
                    srcset={thumbnail.sources.map(source => `${source.src} ${source.width}w`).join(', ')}
                    sizes="(min-width: 60rem) 8.6rem, calc((100vw - 2rem) / 7)"
                    alt=""
                    width={thumbnail.width}
                    height={thumbnail.height}
                    decoding="async"
                  />
                </picture>
              )}
              <span class="calendar-day__shade" />
              <span aria-hidden="true" class="calendar-day__number">
                {String(calendarDay.day).padStart(2, '0')}
              </span>
              {(calendarDay.chinaCalendarDay || calendarDay.anniversaries.length > 0) && (
                <div aria-hidden="true" class:list={[
                  'calendar-day__statuses',
                  { 'calendar-day__statuses--beside-count': calendarDay.mediaCount > 1 },
                ]}>
                  {calendarDay.anniversaries.map(anniversary => (
                    <CalendarAnniversaryStatus
                      anniversary={anniversary}
                      compact
                      overMedia={Boolean(thumbnail)}
                    />
                  ))}
                  {calendarDay.chinaCalendarDay && (
                    <CalendarDayStatus day={calendarDay.chinaCalendarDay} compact overMedia={Boolean(thumbnail)} />
                  )}
                </div>
              )}
              {
                thumbnail
                  ? calendarDay.mediaCount > 1 && <span aria-hidden="true" class="calendar-day__count">+{calendarDay.mediaCount - 1}</span>
                  : <span aria-hidden="true" class="calendar-day__activity"><span class="calendar-day__dot" aria-hidden="true" />{calendarDay.moments.length}</span>
              }
            </a>
          )
          })
        }
      </section>
    </div>

    {
      !selectedDate && (
        <CalendarAgenda days={activeCalendarDays} year={year} month={month} />
      )
    }
  </main>

  {
    selectedDate && selectedDateLabel && (
      <>
        <a class="drawer-scrim" href={closePath} aria-label="关闭当天详情" />
        <aside
          class="day-drawer"
          data-calendar-drawer
          data-close-path={closePath}
          data-previous-path={previousDate ? getMomentPath(previousDate) : undefined}
          data-next-path={nextDate ? getMomentPath(nextDate) : undefined}
          aria-label={`${selectedDateLabel}的记录`}
        >
          <header class="day-drawer__header">
            <h2>{selectedDateLabel}</h2>
            <a class="day-drawer__close" href={closePath} aria-label="返回本月">
              <span class="day-drawer__close-icon i-lucide-x" aria-hidden="true" />
              <span class="day-drawer__back-label"><span class="i-lucide-chevron-left" aria-hidden="true" />{month} 月</span>
            </a>
          </header>

          <div class="day-drawer__content" data-drawer-content>
            {
              selectedTrip && (
                <a class="day-drawer__trip" href={selectedTripHref} aria-label={`回放旅程：${selectedTrip.title}`}>
                  <span class="i-lucide-route" aria-hidden="true" />
                  <span class="day-drawer__trip-title">{selectedTrip.title}</span>
                  <span class="i-lucide-chevron-right" aria-hidden="true" />
                </a>
              )
            }
            {
              selectedMoments.map(moment => <MomentEntry moment={moment} shared={moment.id === sharedMoment?.id} showTrip={!selectedTrip} />)
            }
          </div>

          <nav class="day-drawer__navigation" aria-label="日期导航">
            {
              previousDate
                ? <a href={getMomentPath(previousDate)}><span class="i-lucide-chevron-left" aria-hidden="true" />{formatCompactDate(previousDate)}</a>
                : <span />
            }
            <a href={closePath}>本月</a>
            {
              nextDate
                ? <a href={getMomentPath(nextDate)}>{formatCompactDate(nextDate)}<span class="i-lucide-chevron-right" aria-hidden="true" /></a>
                : <span />
            }
          </nav>
        </aside>

      </>
    )
  }

  <MomentLightbox />
</Layout>

<script>
  import '@/calendar-prefetch-client'
  import { createDrawer, createScrollArea, type Drawer, type ScrollArea } from '@hyoban/drawer'
  import { navigate } from 'astro:transitions/client'

  let calendarController: AbortController | undefined
  // A day's Moments are a drawer beside the month on a wide screen, swiped right to close;
  // on a phone they're the page itself.
  const wide = matchMedia('(width >= 56.0625rem)')
  // A mouse or a trackpad: a finger keeps the device's own scrollbar.
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)')
  let dayDrawer: Drawer | undefined
  let dayScrollArea: ScrollArea | undefined

  /** Makes `element` the day's drawer while the screen is wide; it closes to the month. */
  function setUpDayDrawer(element: HTMLElement, open: boolean, signal: AbortSignal) {
    dayDrawer?.destroy()
    dayDrawer = undefined
    dayScrollArea?.destroy()
    dayScrollArea = undefined
    element.hidden = false

    if (!wide.matches || signal.aborted) {
      return
    }

    const closePath = element.dataset.closePath ?? '/calendar'

    dayDrawer = createDrawer({
      defaultOpen: open,
      disablePointerDismissal: true,
      finalFocus: false,
      initialFocus: false,
      modal: false,
      // Gone, by its close button, Escape or a swipe: the month it was over.
      onOpenChangeComplete: (isOpen) => {
        if (!isOpen) {
          void navigate(closePath)
        }
      },
      // The month gives back the room it made for the day as long as the day takes to go,
      // less after a quick swipe (see index.css).
      onOpenChange: (isOpen) => {
        const strength = Number(element.style.getPropertyValue('--drawer-swipe-strength')) || 1

        document.documentElement.style.setProperty(
          '--calendar-drawer-exit',
          isOpen ? '' : `${strength * 400}ms`,
        )
      },
      popup: element,
      signal,
      swipeDirection: 'right',
    })
    dayDrawer.open()

    // Its Moments scroll under the drawer's thin scrollbar, drawn over their edge.
    const content = element.querySelector<HTMLElement>('.day-drawer__content')

    if (content && finePointer.matches) {
      dayScrollArea = createScrollArea({ root: element, signal, viewport: content })
    }
  }

  function initializeCalendar() {
    calendarController?.abort()
    calendarController = new AbortController()
    const { signal } = calendarController
    const drawer = document.querySelector<HTMLElement>('[data-calendar-drawer]')

    document.documentElement.classList.toggle('calendar-drawer-open', Boolean(drawer))

    // Arrived from the month, the day slides in as the month makes room for it; from another
    // day, or loaded as it is, it's there at once.
    const entering = document.documentElement.hasAttribute('data-calendar-day-entering')

    if (drawer) {
      setUpDayDrawer(drawer, !entering, signal)
    }

    document.documentElement.removeAttribute('data-calendar-day-entering')

    if (drawer) {
      wide.addEventListener('change', () => setUpDayDrawer(drawer, true, signal), { signal })
      finePointer.addEventListener('change', () => setUpDayDrawer(drawer, true, signal), { signal })

      // The links back to the month let the drawer slide away first.
      for (const link of document.querySelectorAll<HTMLAnchorElement>('.day-drawer__close, .drawer-scrim')) {
        link.addEventListener('click', (event) => {
          if (dayDrawer?.isOpen && !event.metaKey && !event.ctrlKey && !event.shiftKey) {
            event.preventDefault()
            dayDrawer.close(event, 'close-press')
          }
        }, { signal })
      }

      window.addEventListener('keydown', (event) => {
        const lightbox = document.querySelector<HTMLDialogElement>('[data-moment-lightbox]')

        // While the day is a drawer, Escape is the drawer's.
        if (lightbox?.open || event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) {
          return
        }

        if (event.key === 'Escape') {
          void navigate(drawer.dataset.closePath ?? '/calendar')
          return
        }

        const target = event.target
        const isInteractiveTarget = target instanceof HTMLElement
          && target.closest('a, button, input, select, textarea, video, [contenteditable="true"]')

        if (isInteractiveTarget) {
          return
        }

        if (event.key === 'ArrowLeft' && drawer.dataset.previousPath) {
          void navigate(drawer.dataset.previousPath)
        } else if (event.key === 'ArrowRight' && drawer.dataset.nextPath) {
          void navigate(drawer.dataset.nextPath)
        }
      }, { signal })
    }

    // A <details> only closes from its own summary; close the month picker from outside too.
    const monthPicker = document.querySelector<HTMLDetailsElement>('.month-picker')

    if (monthPicker) {
      document.addEventListener('pointerdown', (event) => {
        if (monthPicker.open && event.target instanceof Node && !monthPicker.contains(event.target)) {
          monthPicker.open = false
        }
      }, { signal })
      monthPicker.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && monthPicker.open) {
          event.stopPropagation()
          monthPicker.open = false
          monthPicker.querySelector('summary')?.focus()
        }
      }, { signal })
    }

    for (const indexButton of document.querySelectorAll<HTMLButtonElement>('[data-agenda-target]')) {
      indexButton.addEventListener('click', () => {
        const targetId = indexButton.dataset.agendaTarget

        if (targetId) {
          document.getElementById(targetId)?.scrollIntoView({ behavior: 'auto', block: 'start' })
        }
      }, { signal })
    }
  }

  document.addEventListener('astro:page-load', initializeCalendar)
  document.addEventListener('astro:before-swap', (event) => {
    calendarController?.abort()

    // A day opening over the month starts with the month as it was and the day out of
    // sight, so the page swapping in shows no jump (see index.css).
    if (
      wide.matches &&
      !document.querySelector('[data-calendar-drawer]') &&
      event.newDocument.querySelector('[data-calendar-drawer]')
    ) {
      event.newDocument.documentElement.setAttribute('data-calendar-day-entering', '')
    }
  })
  initializeCalendar()
</script>

<style>
  /* The month's grid of days on a wide screen, with a day's Moments in a drawer on the
     right; a phone lists the month instead (CalendarAgenda) and opens a day in its place. */
  .calendar-page {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: 100%;
    max-width: 60rem;
    height: calc(100dvh - 4rem);
    margin-inline: auto;

    @media (width < 56rem) {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      max-width: 42rem;
      height: auto;
    }
  }

  .calendar-page--with-drawer {
    @media (width < 56rem) {
      display: none;
    }

    @media (width >= 56.0625rem) {
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  .calendar-toolbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-bottom: 1rem;

    @media (width < 56rem) {
      display: contents;
    }

    & .calendar-back-link {
      grid-column-start: 1;
      justify-self: start;
    }
  }

  .calendar-toolbar__modes {
    display: flex;
    grid-column-start: 3;
    align-items: center;
    justify-self: end;
    gap: 0.5rem;

    @media (width < 56rem) {
      margin-left: auto;
    }
  }

  /* On a phone, a bar of its own under the toolbar that stays at the top. */
  .month-navigation {
    display: flex;
    grid-column-start: 2;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;

    .calendar-page--with-drawer & {
      gap: 0.25rem;
    }

    @media (width < 56rem) {
      position: sticky;
      top: 0;
      z-index: 10;
      order: 1;
      flex-basis: 100%;
      /* As tall as the agenda's index takes it to be, which sticks right under it. */
      height: 2.75rem;
      margin-top: 0.5rem;
      background: var(--color-bg);
      /* Over the page's sides too, where the agenda's dots reach past its line. */
      box-shadow:
        -1rem 0 var(--color-bg),
        1rem 0 var(--color-bg);
    }

    @media (width < 40rem) {
      gap: 0.5rem;
    }
  }

  .month-navigation__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    color: var(--color-tx-2);
    text-decoration: none;

    @media (hover: hover) {
      &:is(a):hover {
        background: var(--color-inline);
        color: var(--color-tx);
      }
    }

    @media (width < 56rem) {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  .month-navigation__arrow--disabled {
    color: var(--color-tx-3);
    opacity: 0.35;
  }

  .month-picker {
    position: relative;

    & summary {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.375rem 0.75rem;
      border-radius: 9999px;
      font-family: var(--font-mono);
      list-style: none;
      cursor: pointer;

      &::-webkit-details-marker {
        display: none;
      }

      @media (hover: hover) {
        &:hover {
          background: var(--color-inline);
        }
      }

