---
import { getCoverThumbnailUrl } from '@/asset-url'
import { getMomentPath, type Moment } from '@/moments'
import { getShowcaseMedia } from '@/moments/showcase'

// The year as a wall of days: a row per month, a tile per day. A day with a photo shows
// it, one with only words is filled, the rest are dots; days on the road sit on a band.
// Hovering a tile lifts it to a size its photo can be seen at. On a phone the wall turns
// on its side, a column per month, so the tiles stay big enough to tell apart.

interface Props {
  year: number
  moments: Moment[]
  trips: { start: string; end: string; title: string }[]
}

const { year, moments, trips } = Astro.props
const byDay = Map.groupBy(moments, (moment) => moment.dateKey)
const tripOn = (dateKey: string) => trips.find((trip) => trip.start <= dateKey && dateKey <= trip.end)

const months = Array.from({ length: 12 }, (_, index) => {
  const month = index + 1
  const length = new Date(Date.UTC(year, month, 0)).getUTCDate()
  const days = Array.from({ length }, (_, dayIndex) => {
    const dateKey = `${year}-${String(month).padStart(2, '0')}-${String(dayIndex + 1).padStart(2, '0')}`
    const dayMoments = byDay.get(dateKey) ?? []
    const media = dayMoments.flatMap((moment) => getShowcaseMedia(moment.media))
    // The day's stills, one of them shown each visit (src/year-random.ts), cropped square
    // like their tiles.
    const photos = media
      .map((item) => (item.type === 'video' ? item.poster : item.src))
      .filter((image) => image !== undefined)
      .slice(0, 6)
      .map((still) => getCoverThumbnailUrl(still, 160, 1))
    return {
      dateKey,
      day: dayIndex + 1,
      count: dayMoments.length,
      photo: photos[0],
      picks: photos.length > 1 ? JSON.stringify(photos) : undefined,
      trip: tripOn(dateKey)?.title,
    }
  })
  return { month, days, count: days.reduce((total, day) => total + day.count, 0) }
})
---

<div class="year-mosaic" role="list" aria-label={`${year} 年的每一天`}>
  {
    months.map(({ month, days, count }) => (
      <div class="year-mosaic__row" role="listitem" style={`--month: ${month}`}>
        <span class="year-mosaic__month">{month}<span class="year-mosaic__unit">月</span></span>
        <ol class="year-mosaic__days">
          {days.map((day) => {
            const label = `${month} 月 ${day.day} 日${day.count > 0 ? `，${day.count} 条` : ''}${day.trip ? `，${day.trip}` : ''}`
            return (
              <li
                class:list={[
                  'year-mosaic__day',
                  day.photo ? 'has-photo' : day.count > 0 ? 'has-words' : 'is-empty',
                  { 'is-trip': day.trip },
                ]}
                style={`--day: ${day.day}`}
              >
                {day.count > 0 ? (
                  <a href={getMomentPath(day.dateKey)} aria-label={label} title={label}>
                    {day.photo && <img src={day.photo} alt="" loading="lazy" decoding="async" data-pick={day.picks} />}
                  </a>
                ) : (
                  <span title={label} />
                )}
              </li>
            )
          })}
        </ol>
        <span class="year-mosaic__count">{count || ''}</span>
      </div>
    ))
  }
</div>

<script>
  // Pops the wall's tiles in turn once its section is revealed, each at its own moment, so
  // only those mid-pop are animating at any time, not every one still waiting its turn.
  const START = 200
  const MONTH = 70
  const DAY = 14

  // Where the page's motion follows the scroll, the wall is wiped in as one once it's come
  // a little way up the screen, as the page opens if it's there already: tied to the scroll
  // itself, a wall part way up the screen as the page opens would sit half drawn.
  function wipeWalls() {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          entry.target.classList.add('is-wiped')
          observer.unobserve(entry.target)
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    )
    for (const mosaic of document.querySelectorAll('.year-mosaic')) observer.observe(mosaic)
  }

  function popDays() {
    // Keeping still, there's none to pop.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
    if (CSS.supports('animation-timeline: view()')) {
      wipeWalls()
      return
    }
    for (const mosaic of document.querySelectorAll<HTMLElement>('.year-mosaic')) {
      const section = mosaic.closest('.year-section')
      const days = [...mosaic.querySelectorAll<HTMLElement>('.year-mosaic__row')]
        .flatMap((row, month) =>
          [...row.querySelectorAll<HTMLElement>('.year-mosaic__day')].map((day, index) => ({
            day,
            at: START + month * MONTH + index * DAY,
          })),
        )
        .sort((a, b) => a.at - b.at)

      const pop = () => {
        const start = performance.now()
        let next = 0
        const frame = (now: number) => {
          while (next < days.length && days[next]!.at <= now - start) {
            days[next]!.day.classList.add('is-popped')
            next += 1
          }
          if (next < days.length) requestAnimationFrame(frame)
        }
        requestAnimationFrame(frame)
      }

      if (!section || section.classList.contains('is-revealed')) {
        pop()
        continue
      }
      const observer = new MutationObserver(() => {
        if (!section.classList.contains('is-revealed')) return
        observer.disconnect()
        pop()
      })
      observer.observe(section, { attributes: true, attributeFilter: ['class'] })
    }
  }

  document.addEventListener('astro:page-load', popDays)
</script>

<style>
  /* One grid for the year, each tile placed by its month and day: rows of months here,
     columns of them on a phone. */
  .year-mosaic {
    --gap: 3px;
    display: grid;
    grid-template-columns: 2.5rem repeat(31, minmax(0, 1fr)) 2.5rem;
    gap: calc(var(--gap) * 2) var(--gap);
    font-variant-numeric: tabular-nums;

    @media (width < 40rem) {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: var(--gap) calc(var(--gap) * 2);
    }
  }

  .year-mosaic__row,
  .year-mosaic__days {
    display: contents;
  }

  .year-mosaic__month,
  .year-mosaic__count {
    align-self: center;
    color: var(--color-tx-3);
    font-size: 0.75rem;
    line-height: 1;
  }

  .year-mosaic__month {
    grid-area: var(--month) / 1;
  }

  .year-mosaic__count {
    grid-area: var(--month) / 33;
    text-align: right;
  }

  @media (width < 40rem) {
    .year-mosaic__month,
    .year-mosaic__count {
      grid-area: 1 / var(--month);
      padding-block: 0.25rem;
      text-align: center;
    }

    .year-mosaic__count {
      grid-row: 33;
    }

    .year-mosaic__unit {
      display: none;
    }
  }

  /* Each day a stacking context of its own, lifted whole when hovered: Safari otherwise
     works out how every tile after a popping one overlaps it, a long frame as the wall
     starts to fill in. */
  .year-mosaic__day {
    --along: calc((var(--day) - 1) / 30 * 100%);
    position: relative;
    isolation: isolate;
    grid-area: var(--month) / calc(var(--day) + 1);
    aspect-ratio: 1;

    &:has(> a:hover, > a:focus-visible) {
      z-index: 2;
    }

    @media (width < 40rem) {
      --along: calc((var(--month) - 1) / 11 * 100%);
      grid-area: calc(var(--day) + 1) / var(--month);
    }

    & > a,
    & > span {
      position: absolute;
      inset: 0;
      display: block;
      overflow: hidden;
      border-radius: 22%;
      transition:
        scale 180ms var(--ease-out),
        box-shadow 180ms var(--ease-out);
    }

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &.is-empty > span {
      inset: 38%;
      border-radius: 50%;
      background: var(--color-border);
    }

    &.has-words > a {
      background: var(--color-tx-3);
    }

    &.has-photo > a {
      background: var(--color-hover);
    }

    /* A trip's days joined by a band behind them, across the gaps between. */
    &.is-trip::before {
      content: '';
      position: absolute;
      inset: -2px calc(var(--gap) / -2 - 0.5px);
      background: color-mix(in srgb, var(--color-tx) 16%, transparent);
    }

    &.is-trip:not(.is-trip + .is-trip)::before {
      left: -2px;
      border-start-start-radius: 30%;
      border-end-start-radius: 30%;
    }

    &.is-trip:not(:has(+ .is-trip))::before {
      right: -2px;
      border-start-end-radius: 30%;
      border-end-end-radius: 30%;
    }

    @media (width < 40rem) {
      &.is-trip::before,
      &.is-trip:not(.is-trip + .is-trip)::before,
      &.is-trip:not(:has(+ .is-trip))::before {
        inset: -1.5px -2px;
        border-radius: 0;
      }

      &.is-trip:not(.is-trip + .is-trip)::before {
        border-start-start-radius: 30%;
        border-start-end-radius: 30%;
      }

      &.is-trip:not(:has(+ .is-trip))::before {
        border-end-start-radius: 30%;
        border-end-end-radius: 30%;
      }
    }

    /* Lifted over its neighbours, from the side it won't spill off the wall. */
    & > a:hover,
    & > a:focus-visible {
      z-index: 2;
      scale: 4;
      border-radius: 12%;
      box-shadow: 0 2px 8px rgb(0 0 0 / 0.25);
      transform-origin: var(--along) 50%;
    }

    @media (width < 40rem) {
      & > a:hover,
      & > a:focus-visible {
        scale: 2.5;
        transform-origin: var(--along) 50%;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      & > a {
        transition: none;
      }
    }
  }

  /* The wall fills in when its section is first seen: a month after another, a day after
     another, each tile popping up from a dot; a trip's band fades in under its days. Each
     waits as it is until the script below pops it, not on an animation delay: a delayed
     animation holds a layer from the start, and the wall would ask for hundreds at once. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.year-motion:not(.is-sharing)) .year-mosaic__day:not(.is-popped) {
      & > a,
      & > span,
      &.is-trip::before {
        opacity: 0;
      }
    }

    .year-mosaic__day.is-popped {
      & > a,
      & > span {
        animation: year-mosaic-pop 450ms var(--ease-out);
      }

      &.is-trip::before {
        animation: year-mosaic-fade 600ms var(--ease);
      }
    }
  }

  /* Where the rest of the page follows the scroll, the wall is uncovered day by day once
     it's in sight (the script above), the year running left to right, down a phone's
     columns: on a clock, not the scroll, so a wall already on screen as the page opens
     doesn't wait half drawn. One animation for the wall, not one a tile: hundreds of tiles
     moving each on its own layer cost more than a frame. Its edges reach past the wall, so
     a tile lifted over its neighbours isn't cut off. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.year-scroll:not(.is-sharing)) .year-mosaic:not(.is-wiped) {
        clip-path: inset(-6rem 100% -6rem -6rem);

        @media (width < 40rem) {
          clip-path: inset(-6rem -6rem 100% -6rem);
        }
      }

      .year-mosaic.is-wiped {
        animation: year-mosaic-wipe 1400ms var(--ease-out);

        @media (width < 40rem) {
          animation-name: year-mosaic-wipe-down;
        }
      }
    }
  }

  @keyframes year-mosaic-wipe {
    from {
      clip-path: inset(-6rem 100% -6rem -6rem);
    }
    to {
      clip-path: inset(-6rem);
    }
  }

  @keyframes year-mosaic-wipe-down {
    from {
      clip-path: inset(-6rem -6rem 100% -6rem);
    }
    to {
      clip-path: inset(-6rem);
    }
  }

  @keyframes year-mosaic-pop {
    from {
      opacity: 0;
      scale: 0.3;
    }
  }

  @keyframes year-mosaic-fade {
    from {
      opacity: 0;
    }
  }
</style>
