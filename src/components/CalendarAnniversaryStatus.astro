---
import type { CalendarAnniversary } from '@/anniversaries'

interface Props {
  anniversary: CalendarAnniversary
  class?: string
  compact?: boolean
  overMedia?: boolean
}

const {
  anniversary,
  class: className,
  compact = false,
  overMedia = false,
} = Astro.props
const icon = anniversary.icon
---

<span
  class:list={[
    'calendar-anniversary-status inline-flex max-w-full items-center gap-1 overflow-hidden rounded-full border px-1.5 py-0.5 font-mono whitespace-nowrap',
    compact ? 'text-[0.625rem] leading-[1.25]' : 'text-[0.6875rem]',
    overMedia
      ? 'border-white/25 bg-[rgb(17_17_16/0.62)] text-white [text-shadow:none]'
      : 'border-border bg-inline text-tx-2',
    className,
  ]}
  aria-label={anniversary.description}
  title={anniversary.description}
>
  <span class:list={['flex-none text-[0.75rem]', icon]} aria-hidden="true" />
  <span class="overflow-hidden text-ellipsis">{anniversary.label}</span>
</span>
