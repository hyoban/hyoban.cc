---
import type { TripImage } from '@/moments/trip-images'

// A trip's photos across the top of its card, as the app lays them out (`CoverCollage`):
// one, two side by side, or one large beside two small, meeting without gaps. Its corners
// are the card's to round.

interface Props {
  images: TripImage[]
  /** How wide the collage is shown, for the photos' srcset. */
  sizes: string
}

const { images, sizes } = Astro.props
const tiles = images.slice(0, 3)
---

{
  tiles.length > 0 && (
    <div class:list={['trip-cover-collage', `trip-cover-collage--${tiles.length}`]} aria-hidden="true">
      {tiles.map(image => (
        <img src={image.src} srcset={image.srcset} sizes={sizes} width={image.width} height={image.height} alt="" loading="lazy" decoding="async" />
      ))}
    </div>
  )
}

<style>
  .trip-cover-collage {
    display: grid;
    overflow: hidden;
    border-radius: 0.5rem;
    background: var(--color-inline);

    & img {
      width: 100%;
      height: 100%;
      min-height: 0;
      object-fit: cover;
    }
  }

  .trip-cover-collage--1 {
    aspect-ratio: 16 / 9;
  }

  .trip-cover-collage--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    aspect-ratio: 16 / 9;
  }

  .trip-cover-collage--3 {
    grid-template-columns: 2fr 1fr;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    aspect-ratio: 16 / 10;

    & img:first-child {
      grid-row: span 2 / span 2;
    }
  }
</style>
