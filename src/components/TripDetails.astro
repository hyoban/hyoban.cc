---
import MomentEntry from '@/components/MomentEntry.astro'
import TripCoverCollage from '@/components/TripCoverCollage.astro'
import { CATEGORY_LABELS, formatRate, formatYuan } from '@/data/vehicle-costs'
import { getMomentTripCosts, getMomentTripOdometer, type Moment, type MomentTrip } from '@/moments'
import { getTripCollage } from '@/moments/trip-images'

// A trip's sidebar beside the map: its photos and totals, the button that plays it, and
// its days' Moments in order, each stop playing the trip from its own card. The map
// fetches it as a fragment (see pages/trip/[id]/moments.astro); a trip's page renders
// it in place.

interface Props {
  /** Every Moment, of which the trip's days are shown. */
  moments: Moment[]
  trip: MomentTrip
}

const { moments, trip } = Astro.props
const tripMoments = moments.filter(moment => moment.dateKey >= trip.start && moment.dateKey <= trip.end)
const totals = [
  `${trip.dayCount} 天`,
  `${trip.placeCount} 个地点`,
  ...(trip.drivingKm > 0 ? [`自驾 ${trip.drivingKm.toLocaleString('zh-CN')} 公里`] : []),
  `${tripMoments.length} 条记录`,
].join('\u2003')
// What the car charged on the way, when it drove the whole trip and the records have it:
// how often, how much, and how often fast.
const odometer = getMomentTripOdometer(trip)
const charges = odometer?.charges ?? []
const fastCharges = charges.filter(charge => charge.type === 'DC').length
const chargedKwh = charges.reduce((total, charge) => total + charge.energyWh, 0) / 1000
const charging = charges.length > 0 && [
  `充电 ${charges.length} 次`,
  `${chargedKwh.toLocaleString('zh-CN', { maximumFractionDigits: 1 })} kWh`,
  ...(fastCharges > 0 ? [fastCharges === charges.length ? '都是快充' : `快充 ${fastCharges} 次`] : []),
].join('\u2003')
// And what it spent on the road, from the car's ledger: in all, by kind, and a kilometre.
const costs = odometer && getMomentTripCosts(trip, odometer)
const spending = costs && [
  `花费 ${formatYuan(costs.total)}`,
  ...costs.categories.map(({ category, fen }) => `${CATEGORY_LABELS[category]} ${formatYuan(fen)}`),
  ...(costs.distanceMeters > 0 ? [`每公里 ${formatRate(costs.total / 100 / (costs.distanceMeters / 1000))}`] : []),
].join('\u2003')
---

<div class="trip-details">
  <TripCoverCollage images={getTripCollage(trip, moments)} priority sizes="(max-width: 48rem) 100vw, 26rem" />
  <p class="trip-details__totals">{totals}</p>
  {charging && <p class="trip-details__totals">{charging}</p>}
  {spending && <p class="trip-details__totals">{spending}</p>}
  <a class="trip-details__play" href={`/trip/${trip.id}/play/`} data-trip-map-stop-play={trip.id}>
    <span class="i-lucide-play" aria-hidden="true" />
    回放旅程
  </a>
</div>
<div class="trip-details__moments">
  {tripMoments.map(moment => <MomentEntry date="day" moment={moment} tripLink="play" />)}
</div>

<style>
  .trip-details {
    padding-top: 1rem;

    & .trip-cover-collage {
      margin-bottom: 0.75rem;
    }
  }

  .trip-details__totals {
    color: var(--color-tx-2);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .trip-details__play {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2.5rem;
    margin-top: 0.75rem;
    border-radius: 9999px;
    background: var(--color-tx);
    color: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: calc(1.25 / 0.875);
    text-decoration: none;

    @media (hover: hover) {
      &:hover {
        color: var(--color-bg);
        opacity: 0.9;
      }
    }

    &:focus-visible {
      outline: 2px solid var(--color-tx);
      outline-offset: 2px;
    }

    & span {
      font-size: 0.8125rem;
    }
  }

  .trip-details__moments {
    min-width: 0;
    margin-top: 0.5rem;
  }
</style>
