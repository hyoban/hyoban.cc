  }

  .year-highlights__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .year-highlights img,
    .year-trips img {
      transition: none;
    }
  }

  .year-stats__value {
    display: inline-grid;

    & > span {
      grid-area: 1 / 1;
      text-align: right;
    }
  }

  .year-stats__final {
    visibility: hidden;
  }

  /* How it moved from the year before, as a chip by the count: dark when it grew. */
  .year-stats__change {
    margin-left: 0.375rem;
    padding: 0.0625rem 0.375rem;
    border-radius: 999px;
    background: var(--color-hover);
    color: var(--color-tx-2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0;
    vertical-align: 0.875rem;

    &.is-up {
      background: var(--color-tx);
      color: var(--color-bg);
    }
  }

  /* A life's years, a row each: the year large, what it adds up to beside it, the row
     linking to the year's own review. */
  .year-years {
    display: grid;
    border-top: 1px solid var(--color-border);

    & a {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 1.25rem;
      padding-block: 0.875rem;
      border-bottom: 1px solid var(--color-border);
      text-decoration: none;

      @media (hover: hover) {
        &:hover .year-years__year {
          text-decoration: underline;
          text-decoration-thickness: 2px;
          text-underline-offset: 0.15em;
        }
      }
    }
  }

  .year-years__year {
    font-size: 2rem;
    font-weight: 700;
    line-height: 2.5rem;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .year-years__counts {
    color: var(--color-tx-2);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  /* A life's days, a year's wall each, under its year. */
  .year-days__year {
    max-width: 40rem;
    margin: 2rem auto 0.5rem;
    color: var(--color-tx-2);
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;

    h2 + & {
      margin-top: 0;
    }
  }

  /* The cities first reached, under the month they were reached in. */
  .year-first {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem 0.75rem;

    @media (width >= 40rem) {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    & li {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      padding-top: 0.5rem;
      border-top: 2px solid var(--color-tx);

      &.is-empty {
        border-top-color: var(--color-border);
      }
    }

    /* On a phone, only the months that reached somewhere new, so a column isn't spent on
       each that didn't. */
    @media (width < 40rem) {
      & li.is-empty {
        display: none;
      }
    }
  }

  /* A life's, under the year: a row each, its cities running on across it. */
  .year-first.is-years {
    grid-template-columns: minmax(0, 1fr);

    & li {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.25rem 0.875rem;
    }

    & .year-first__month {
      width: 100%;
    }
  }

  .year-first__month {
    color: var(--color-tx-3);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .year-first__city {
    font-weight: 500;
  }

  /* The places by kind, each kind a carousel of cards (src/year-carousel.ts): a photo
     from there behind its name, linking to the place on the map. Without the script, or
     with reduced motion, a row of same-sized cards scrolled sideways. */
  .year-places {
    /* One height before the script and after it, so the page doesn't move when it takes
       the row over, or when a reload has already scrolled past it. */
    --row: 12rem;
    margin-top: 1.5rem;

    & h3 {
      display: flex;
      align-items: baseline;
      gap: 0.375rem;
      font-weight: 500;
    }

    & ul {
      display: grid;
      grid-auto-columns: calc(var(--row) * 0.8);
      grid-auto-flow: column;
      gap: 0.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    & li {
      scroll-snap-align: start;
    }

    & a {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      padding: 0.625rem;
      border-radius: 0.75rem;
      background: var(--color-hover);
      text-decoration: none;

      &:focus-visible {
        outline: 2px solid var(--color-tx);
        outline-offset: -2px;
      }

      /* A photo darkened at the foot, where the name sits on it. */
      &.has-photo {
        background: var(--color-border);
        color: #fff;

        &::after {
          position: absolute;
          inset: 0;
          background: linear-gradient(to top, rgb(0 0 0 / 0.65), rgb(0 0 0 / 0) 60%);
          content: '';
        }
      }

      & img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: scale 180ms var(--ease);
      }

      @media (hover: hover) {
        &:hover img {
          scale: 1.04;
        }
      }
    }

    /* Each item a step of the scroller, its card the large size, moved and masked to its
       place by the script; the words keep to what the mask shows. No will-change: a layer
       for each of a row's dozens of cards costs a phone more than repainting the few shown. */
    &.is-multi-browse {
      & ul {
        position: relative;
        display: flex;
        gap: 0;
        height: var(--row);
      }

      & li {
        position: relative;
        flex: none;
      }

      & a {
        position: absolute;
        inset: 0 auto 0 0;
        width: var(--large);
        aspect-ratio: auto;
      }

      & .year-places__words {
        position: absolute;
        right: calc(var(--inset) + 0.625rem);
        bottom: 0.625rem;
        left: calc(var(--inset) + 0.625rem);
        opacity: var(--words);
      }
    }

    /* All of a kind at once, wrapping, as Material asks for a carousel on a scrolling page. */
    &.is-expanded ul {
      grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
      grid-auto-flow: row;
      overflow: visible;
    }
  }

  .year-places__words {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .year-places__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2rem;
    margin-bottom: 0.625rem;
  }

  .year-places__actions {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
  }

  .year-places__all {
    min-height: 2.25rem;
    white-space: nowrap;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    color: var(--color-tx-2);
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 140ms var(--ease);

    &:hover {
      background: var(--color-hover);
      color: var(--color-tx);
    }

    & .year-places__all-hide {
      display: none;
    }

    .is-expanded & {
      & .year-places__all-show {
        display: none;
      }

      & .year-places__all-hide {
        display: inline;
      }
    }
  }

  /* Paging by what shows, for a mouse; a finger swipes instead. */
  .year-places__nav {
    display: flex;
    gap: 0.25rem;

    &[hidden] {
      display: none;
    }

    @media (hover: none) {
      display: none;
    }

    & button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2rem;
      height: 2rem;
      border: 1px solid var(--color-border);
      border-radius: 9999px;
      color: var(--color-tx-2);
      cursor: pointer;
      transition:
        background-color 140ms var(--ease),
        opacity 140ms var(--ease);

      &:hover:not(:disabled) {
        background: var(--color-hover);
        color: var(--color-tx);
      }

      &:active:not(:disabled) {
        scale: 0.95;
      }

      &:disabled {
        opacity: 0.35;
        cursor: default;
      }
    }
  }

  .year-places__count {
    color: var(--color-tx-3);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .year-places__name {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .year-places__city {
    color: var(--color-tx-3);
    font-size: 0.75rem;

    .has-photo & {
      color: rgb(255 255 255 / 0.8);
    }
  }

  /* The meals as a menu card: a framed page with its year and title set like a
     restaurant's, the courses under it, each dish a photo on a plate with its name, day
     and price, dots leading to its city; the bad ones struck out. Two columns where
     there's room. */
  .year-menu {
    --menu-serif: 'Songti SC', 'Noto Serif SC', 'Source Han Serif SC', serif;
    padding: 2rem 1rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-inline);
    box-shadow:
      inset 0 0 0 0.375rem var(--color-bg),
      inset 0 0 0 calc(0.375rem + 1px) var(--color-border);

    @media (width >= 40rem) {
      padding: 2.25rem 2.25rem 1.75rem;
    }
  }

  .year-menu__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .year-menu__year {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-tx-3);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-indent: 0.3em;
    font-variant-numeric: tabular-nums;

    &::before,
    &::after {
      width: 2.5rem;
      height: 1px;
      background: currentColor;
      opacity: 0.5;
      content: '';
    }
  }

  .year-menu__title {
    font-family: var(--menu-serif);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 2.25rem;
    letter-spacing: 0.5em;
    text-indent: 0.5em;
  }

  .year-menu__count {
    color: var(--color-tx-2);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .year-menu__course {
    & + & {
      margin-top: 1.75rem;
    }

    & h3 {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.5rem;
      font-family: var(--menu-serif);
      font-size: 1.125rem;
      font-weight: 700;
      letter-spacing: 0.25em;
    }

    & ul {
      display: grid;
      column-gap: 2.25rem;

      @media (width >= 40rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    & a {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding-block: 0.375rem;
      text-decoration: none;

      @media (width >= 40rem) {
        padding-block: 0.5rem;
      }

      @media (hover: hover) {
        &:hover .year-menu__plate {
          rotate: -12deg;
          scale: 1.08;
        }

        &:hover .year-menu__name {
          text-decoration: underline;
          text-underline-offset: 0.2em;
        }
      }
    }
  }

  .year-menu__note {
    flex-shrink: 0;
    color: var(--color-tx-3);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    font-variant-numeric: tabular-nums;
  }

  .year-menu__rule {
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  /* A photo of the dish on a plate: round, with a rim. */
  .year-menu__plate {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 3px;

    @media (width >= 40rem) {
      width: 2.75rem;
      height: 2.75rem;
    }

    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-bg);
    color: var(--color-tx-3);
    transition:
      rotate 300ms var(--ease-out),
      scale 300ms var(--ease-out);

    & img {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      border-radius: inherit;
      object-fit: cover;
    }
  }

  .year-menu__dish {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .year-menu__name {
    overflow: hidden;
    line-height: 1.375rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .year-menu__meta,
  .year-menu__city {
    flex-shrink: 0;
    color: var(--color-tx-3);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .year-menu__city {
    color: var(--color-tx-2);
  }

  .year-menu__leader {
    flex: 1;
    min-width: 1rem;
    align-self: center;
    border-bottom: 1px dotted var(--color-tx-3);
    opacity: 0.6;
  }

  .is-struck {
    & .year-menu__name {
      color: var(--color-tx-2);
      text-decoration: line-through;
      text-decoration-thickness: 1px;
    }

    & .year-menu__plate img {
      filter: grayscale(1);
    }
  }

  .year-devices {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem;

    & a {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: 0.875rem 1rem;
      border: 1px solid var(--color-border);
      border-radius: 0.625rem;
      text-decoration: none;
      transition: background-color 140ms var(--ease);

      &:hover {
        background: var(--color-hover);
      }
    }
  }

  /* Its picture, when it has one, tilted in from the card's corner and lifting on hover. */
  .year-devices .has-image {
    position: relative;
    overflow: hidden;
    padding-right: 4.5rem;
  }

  .year-devices__image {
    position: absolute;
    right: 0.375rem;
    bottom: -1.25rem;
    width: 4rem;
    height: 5rem;
    object-fit: contain;
    rotate: 12deg;
    transition: translate 300ms var(--ease-out);

    @media (hover: hover) {
      a:hover > & {
        translate: 0 -0.5rem;
      }
    }
  }

  .year-devices__category,
  .year-devices__meta {
    color: var(--color-tx-2);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  /* The day and the price each kept whole, the price going under when they don't fit. */
  .year-devices__meta span {
    white-space: nowrap;
  }

  .year-devices__name {
    font-weight: 500;
  }

  .year-nav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    margin-top: 4rem;
    font-variant-numeric: tabular-nums;
  }

  .year-nav__next {
    justify-self: end;
  }

  .year-share {
    position: relative;
  }

  .year-share__toggle {
    padding: 0.25rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-tx-2);
    font: inherit;
    font-size: 0.875rem;
    transition:
      background-color 140ms var(--ease),
      color 140ms var(--ease),
      scale 140ms var(--ease-out);

    @media (hover: hover) and (pointer: fine) {
      &:hover {
        background: var(--color-hover);
        color: var(--color-tx);
      }
    }

    &:active {
      scale: 0.97;
    }

    &[aria-disabled='true'] {
      cursor: progress;
    }
  }

  /* The two ways to share, above the button. */
  .year-share__options {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    z-index: 1;
    display: grid;
    width: max-content;
    padding: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
    translate: -50% 0;
    transform-origin: bottom center;

    &:not([hidden]) {
      animation: year-share-open 160ms var(--ease-out);
    }

    & button {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding: 0.375rem 0.75rem;
      border-radius: 0.5rem;
      color: var(--color-tx);
      font: inherit;
      font-size: 0.875rem;
      text-align: start;

      @media (hover: hover) and (pointer: fine) {
        &:hover {
          background: var(--color-hover);
        }
      }

      &:focus-visible {
        background: var(--color-hover);
      }
    }

    & span {
      color: var(--color-tx-3);
      font-size: 0.75rem;
    }
  }

  @keyframes year-share-open {
    from {
      opacity: 0;
      scale: 0.96;
    }
  }

  .year-share-mark {
    display: none;
    align-items: center;
    gap: 0.75rem;
    margin-top: 4rem;
    color: var(--color-tx-2);

    & img {
      border-radius: 999px;
    }

    & span:first-of-type {
      color: var(--color-tx);
      font-weight: 500;
    }
  }

  .year-share-mark__url {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  /* While the share picture is drawn: its mark shown, and nothing caught mid-motion. */
  :global(.is-sharing) {
    & .year-share-mark {
      display: flex;
    }

    & *,
    & *::before,
    & *::after {
      animation: none !important;
      transition: none !important;
    }
  }

  /* Motion, once each: the year rises in as the page opens and its counts follow; every
     section rises in the first time it scrolls into view, then its parts in turn. A
     section waits hidden only while the page's script is there to reveal it. */
  @media (prefers-reduced-motion: no-preference) {
    .year-hero h1 {
      animation: year-rise 900ms var(--ease-out) backwards;
    }

    .year-stats div {
      animation: year-rise 700ms var(--ease-out) backwards;
      animation-delay: calc(250ms + var(--index) * 80ms);
    }

    .year-stats__change {
      animation: year-fade 500ms var(--ease) backwards;
      animation-delay: calc(250ms + var(--index) * 80ms + 1100ms);
    }

    .year-section {
      transition:
        opacity 700ms var(--ease-out),
        translate 700ms var(--ease-out);
    }

    :global(.year-motion) .year-section:not(.is-revealed) {
      opacity: 0;
      translate: 0 2rem;
    }

    .is-revealed {
      & .year-cities__bar {
        animation: year-bar-wipe 900ms var(--ease-out) backwards;
        animation-delay: calc(500ms + var(--index) * 90ms);
      }

      & .year-first li {
        animation: year-wipe 700ms var(--ease-out) backwards;
        animation-delay: calc(150ms + var(--month) * 60ms);
      }

      & .year-first__city {
        animation: year-rise 500ms var(--ease-out) backwards;
        animation-delay: calc(350ms + var(--month) * 60ms + var(--index) * 70ms);
      }

      /* A row's first few are all that show as it rises in; the rest come in as it scrolls,
         and animating them too would make dozens of layers at once for nothing. */
      & .year-places li:nth-child(-n + 8),
      & .year-menu li {
        animation: year-rise 600ms var(--ease-out) backwards;
        animation-delay: calc(150ms + min(var(--order), 8) * 60ms);
      }

      & .year-trips li,
      & .year-highlights li,
      & .year-years li {
        animation: year-rise 600ms var(--ease-out) backwards;
        animation-delay: calc(150ms + min(var(--index), 12) * 90ms);
      }

      & .year-devices__image {
        animation: year-device-peek 900ms var(--ease-out) backwards;
        animation-delay: calc(300ms + var(--index) * 120ms);
      }

      & .year-trips path {
        animation: year-trip-draw 1600ms var(--ease-out) backwards;
        animation-delay: calc(500ms + min(var(--index), 12) * 150ms);
      }
    }
  }

  /* Where the browser ties animations to scrolling, all below the top moves with it instead
     (the page's script leaves them to it): each part rises, wipes or draws in as it comes
     into view, by how far it has, and once all the way in stays so (keepPlayed). Nothing waits
     hidden for a script, and a page restored part way down is simply as far along as it's
     scrolled. Here and in the parts, each is written out property by property, never as the
     animation shorthand: the build's minifier folds a timeline into the shorthand, which
     browsers don't take yet, dropping the whole declaration. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.year-scroll) {
        & .year-section {
          animation-name: year-rise;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
          animation-range: entry 0% entry 12rem;
        }

        & .year-trips li,
        & .year-highlights li,
        & .year-menu li,
        & .year-devices li,
        & .year-years li,
        & .year-first__city {
          animation-name: year-rise;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
          animation-range: entry 0% entry 100%;
        }

        /* A row of places sits in its own scroller, so its cards follow the row as it comes
           up, one after the other, rather than the scroller they're always in. */
        & .year-places {
          view-timeline: --places;
        }

        & .year-places li {
          animation-name: year-rise;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: --places;
          animation-range: entry calc(min(var(--order), 6) * 8%) entry calc(60% + min(var(--order), 6) * 8%);
        }

        /* A section's figures rise one after the other, the parts' own leads too. */
        & :global(.year-lead > span) {
          animation-name: year-rise;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: view();
          animation-range: entry 0% entry 100%;
        }

        & :global(.year-lead > span + span) {
