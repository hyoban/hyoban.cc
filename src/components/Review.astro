<script>
  import { initializeCarousels } from '@/year-carousel'
  import { dealYear, keepSeed } from '@/year-random'
  import { initializeYearShare } from '@/year-share'

  // The page's motion, each piece once: the counts roll up from nothing as it opens, and
  // each section rises in the first time it scrolls into view, its parts following on.
  const DELAY = 250
  const STAGGER = 80
  const DURATION = 1100
  const easeOut = (progress: number) => 1 - (1 - progress) ** 3

  // Each count rolls up from nothing as its stat rises in: the same delay as the CSS gives
  // the stat, one after another.
  function countUp(values: HTMLElement[]) {
    const format = new Intl.NumberFormat('zh-CN')
    for (const element of values) element.textContent = format.format(0)
    const start = performance.now()
    const frame = (now: number) => {
      let running = false
      values.forEach((element, index) => {
        const elapsed = now - start - (DELAY + index * STAGGER)
        const progress = easeOut(Math.min(1, Math.max(0, elapsed / DURATION)))
        if (progress < 1) running = true
        element.textContent = format.format(Math.round(Number(element.dataset.value) * progress))
      })
      if (running) requestAnimationFrame(frame)
    }
    requestAnimationFrame(frame)
  }

  // Pointing at a city in the list or on the map marks it in both.
  function initializeCityLinks() {
    const section = document.querySelector<HTMLElement>('[aria-labelledby="year-footprint"]')
    if (!section) return
    const mark = (id?: string) => {
      for (const element of section.querySelectorAll<HTMLElement | SVGElement>('[data-city]'))
        element.classList.toggle('is-active', element.dataset.city === id)
    }
    section.addEventListener('pointerover', (event) => {
      mark((event.target as Element).closest<HTMLElement>('[data-city]')?.dataset.city)
    })
    section.addEventListener('pointerleave', () => mark())
  }

  // A part that has played all the way in stays in, rather than going back out scrolled
  // back up: cancelled, a CSS animation leaves the part as it is at its end, and isn't
  // started again while its name stays the same.
  function keepPlayed() {
    let playing = document.getAnimations().filter((animation) => !(animation.timeline instanceof DocumentTimeline))
    const controller = new AbortController()
    let frame = 0
    let settle = 0
    const check = () => {
      frame = 0
      playing = playing.filter((animation) => {
        if (animation.effect?.getComputedTiming().progress !== 1) return true
        animation.cancel()
        return false
      })
      if (playing.length === 0) controller.abort()
    }
    // Every frame while it scrolls, and once more after: the timelines can catch up a frame
    // behind the last scroll.
    const schedule = () => {
      frame ||= requestAnimationFrame(check)
      clearTimeout(settle)
      settle = window.setTimeout(check, 150)
    }
    document.addEventListener('scroll', schedule, { capture: true, passive: true, signal: controller.signal })
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal: controller.signal })
    schedule()
  }

  function initializeMotion() {
    const sections = document.querySelectorAll<HTMLElement>('.year-section')
    if (sections.length === 0) return
    const root = document.documentElement.classList
    // The motion follows the scroll where the browser can do that, as the inline script
    // above decided, or here for a page the router swapped in, its inline script not run.
    const scrolled = CSS.supports('animation-timeline: view()')
    if (scrolled) {
      root.add('year-scroll')
      keepPlayed()
    }
    // Back where it was part way down it keeps still, as the inline script above left it,
    // or as the router swapped it in, hiding nothing.
    if (!root.contains('year-motion') && history.state?.scrollY > 0) return
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      for (const section of sections) section.classList.add('is-revealed')
      return
    }
    countUp([...document.querySelectorAll<HTMLElement>('.year-stats__value [data-value]')])
    if (scrolled) return
    // A section rises in once a good part of it is in sight, of it or of the screen, which
    // ever is less: one only peeking in from the bottom would draw its pictures out of sight.
    const SEEN = 0.3
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const sight = Math.min(entry.boundingClientRect.height, entry.rootBounds?.height ?? innerHeight)
          if (entry.intersectionRect.height < sight * SEEN) continue
          entry.target.classList.add('is-revealed')
          observer.unobserve(entry.target)
        }
      },
      { threshold: Array.from({ length: 21 }, (_, step) => step / 20) },
    )
    for (const section of sections) observer.observe(section)
  }

  // First, so the carousels and the motion see the places in their new order: dealing a page
  // the router swapped in, the rest dealt inline already; then keeping the seed.
  document.addEventListener('astro:page-load', () => {
    dealYear()
    keepSeed()
  })
  document.addEventListener('astro:page-load', initializeMotion)
  document.addEventListener('astro:page-load', initializeCityLinks)
  document.addEventListener('astro:page-load', initializeCarousels)
  document.addEventListener('astro:page-load', initializeYearShare)
</script>

