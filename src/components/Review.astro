---
import { getAssetUrl, getCoverThumbnailUrl, getThumbnailUrl } from '@/asset-url'
import SitePage from '@/components/SitePage.astro'
import YearFootprint from '@/components/YearFootprint.astro'
import YearMosaic from '@/components/YearMosaic.astro'
import cities from '@/data/boundaries/cities.json'
import Layout from '@/layouts/Layout.astro'
import {
  getMomentHeadline,
  getMomentPagePath,
  getMomentPath,
  getMoments,
  getTrips,
  type Moment,
} from '@/moments'
import { getLifeCollage, getYearCollage } from '@/card-data'
import { getShowcaseMedia } from '@/moments/showcase'
import { getTripCollage } from '@/moments/trip-images'
import { getPageCardPath, getPageTitle } from '@/page-cards'
import { buildCarFloor, buildRouteGlyph, buildYearMap, getTripLine } from '@/year-map'
import {
  buildYearReview,
  formatChange,
  getCityName,
  getYearMeals,
  getYearPlaces,
} from '@/year-review'
import YearClock from '@/components/YearClock.astro'
import YearDriving from '@/components/YearDriving.astro'
import { getCarSummary } from '@/car'
import YearWeekdays from '@/components/YearWeekdays.astro'
import YearTopics from '@/components/YearTopics.astro'
import { readDevices, readPlaces } from '@/data/store'
import { getDivisionLabel, placeKindLabels } from '@/data/place-info'
import { getSortedPosts } from '@/utils'
import { getShortPlaceName, type FogRegions } from '@hyoban/trip-map'
import { carouselGeometry } from '@/year-carousel'
import { dealYear } from '@/year-random'
import type { PlaceKind } from '@hyoban/data-spec'

// A year at a glance (src/year-review.ts), or a whole life's, every year at once (/life/):
// its counts, a year's against the year before; a life's years, each linking to its own;
// then where it went, from its footprint on a map drawn at build time (src/year-map.ts) and its trips
// by the shapes of their routes, how the car drove it, down to the cities it first reached,
// the places and what it ate; then
// how it went, every day of it as a tile, a few days worth going back to and when it was
// written; and last the devices bought.
//
// Everything here stays inside the page's column at the narrowest wide layout (a 672px
// screen): the share pictures (src/year-share.ts) draw the column alone at that width and
// cut the squares between its children, so what spills past it, sideways or out of its
// part, is cut off or lands on the wrong square. A part that spreads wider on a big screen,
// like .year-wide, must come back to the column's width there.
interface Props {
  /** The year, or none for every year. */
  year?: number
  previous?: number | undefined
  next?: number | undefined
  /** Every year with a review, oldest first. */
  years: number[]
}

const { year, previous, next, years } = Astro.props
const life = year === undefined
const moments = await getMoments()
const { span: carSpan } = await getCarSummary()
// Only the years the car's records reach into, from its first day to the latest capture,
// and a life with a car in it.
const drove =
  life || (carSpan.start.slice(0, 4) <= String(year) && String(year) <= carSpan.end.slice(0, 4))
const regions = cities as FogRegions
const numberFormat = new Intl.NumberFormat('zh-CN')
const formatNumber = (value: number) => numberFormat.format(value)
// A life's days say their year too.
const formatDay = (dateKey: string) => {
  const [dayYear, month, day] = dateKey.split('-').map(Number)
  return `${life ? `${dayYear} 年 ` : ''}${month} 月 ${day} 日`
}
const allTrips = getTrips(moments)
const review = buildYearReview(year, moments, allTrips, regions)
const lastDateKey = moments.at(-1)?.dateKey ?? ''
const ongoing =
  life || (lastDateKey.startsWith(String(year)) && year >= new Date().getFullYear())
// The whole year before, to compare the counts with, even while this one isn't over; a
// life has nothing to compare with.
const yearBeforeEnd = `${previous}-12-31`
const before =
  life || previous === undefined
    ? undefined
    : buildYearReview(
        previous,
        moments.filter((moment) => moment.dateKey <= yearBeforeEnd),
        allTrips.filter((trip) => trip.start <= yearBeforeEnd),
        regions,
      )

const map = buildYearMap(
  regions,
  Object.fromEntries(review.cities.lit.map((city) => [city.id, city.count])),
  review.trips.map((trip) => ({ id: trip.id, lines: getTripLine(trip.legs) })),
  review.moments.flatMap((moment) =>
    moment.locations.map(({ latitude, longitude }) => [longitude, latitude] as const),
  ),
)
// What the car stands on in the driving section: the legs it drove on the trips.
const carFloor = buildCarFloor(review.trips.flatMap((trip) => getTripLine(trip.legs)))
/** The most photos a picture chooses among each visit (src/year-random.ts). */
const PICKS = 6
/** What a picture with others to choose from names for src/year-random.ts. */
const pickFrom = (photos: string[]) =>
  photos.length > 1 ? JSON.stringify(photos.slice(0, PICKS)) : undefined
/** A picture showing the first of `photos` until src/year-random.ts picks one of them. */
const pictureOf = (photos: string[]) => ({ src: photos[0]!, pick: pickFrom(photos) })
const trips = review.trips.map((trip) => ({
  trip,
  glyph: buildRouteGlyph(getTripLine(trip.legs)),
  covers: getTripCollage(trip, review.moments, PICKS),
}))
const tripDays = review.trips.reduce((total, trip) => total + trip.dayCount, 0)
/** The most trips shown as covers; past it, the longest are, the rest longer than a day listed under them. */
const FEATURED_TRIPS = 6
const featuredIds = new Set(
  trips.length <= FEATURED_TRIPS
    ? trips.map(({ trip }) => trip.id)
    : trips
        .toSorted(
          ({ trip: first }, { trip: second }) =>
            second.dayCount - first.dayCount ||
            second.drivingKm - first.drivingKm ||
            second.placeCount - first.placeCount,
        )
        .slice(0, FEATURED_TRIPS)
        .map(({ trip }) => trip.id),
)
const featuredTrips = trips.filter(({ trip }) => featuredIds.has(trip.id))
// With more than the covers, a day's trip isn't listed under them.
const otherTrips = trips.filter(({ trip }) => !featuredIds.has(trip.id) && trip.dayCount > 1)
/** When a trip set out, with its year on a life's page. */
const tripDate = (trip: { start: string }) =>
  `${life ? `${trip.start.slice(0, 4)}.` : ''}${Number(trip.start.slice(5, 7))}.${Number(trip.start.slice(8, 10))}`
/** How long a trip was, and how far the car drove on it. */
const tripMeta = (trip: { dayCount: number; drivingKm: number }) =>
  `${trip.dayCount} 天${trip.drivingKm > 0 ? `\u2003${formatNumber(trip.drivingKm)} km` : ''}`
const topCities = review.cities.lit.slice(0, 6)
// The cities first reached, under the month they were, or a life's under the year.
const firstVisitColumns = life
  ? years.map((at) => ({ key: at, label: String(at) }))
  : Array.from({ length: 12 }, (_, index) => ({ key: index + 1, label: `${index + 1}月` }))
const firstVisits = Map.groupBy(review.firstVisits, (visit) =>
  Number(life ? visit.dateKey.slice(0, 4) : visit.dateKey.slice(5, 7)),
)
/**
 * The stills of these Moments, photos and videos' posters but no utility ones, `width` wide;
 * those taller than the `aspect` of the box they cover come cropped to it.
 */
const photosOf = (dayMoments: Moment[], width: number, aspect = Infinity) =>
  dayMoments
    .flatMap((moment) => getShowcaseMedia(moment.media))
    .map((item) => (item.type === 'video' ? item.poster : item.src))
    .filter((image) => image !== undefined)
    .map((image) => getCoverThumbnailUrl(image, width, aspect))
// The places gone to, the sights in one row and where to eat, stay or shop in another,
// each in the order the year reached it, with its city; the cities are the footprint's,
// and the towns and stations only on the way.
const allPlaces = readPlaces()
const yearPlaces = getYearPlaces(review.moments, allPlaces)
const placeKinds: PlaceKind[] = ['scenic', 'food', 'shopping', 'stay']
const places = yearPlaces
  .filter((place) => place.kind && placeKinds.includes(place.kind))
  .map((place) => {
    const name = getShortPlaceName(place.name)
    const city = place.division?.city && getCityName(place.division.city)
    return {
      ...place,
      name,
      // Its city, unless the name already says it.
      city: city && !name.includes(city) ? city : undefined,
      title: [place.division && getDivisionLabel(place.division), formatDay(place.dateKey)]
        .filter(Boolean)
        .join('\u2003'),
      // The photos from the year's Moments there, one of them shown each visit.
      photos: photosOf(
        review.moments.filter((moment) => moment.locations.some(({ id }) => id === place.id)),
        320,
        5 / 4,
      ),
    }
  })
const placeRows = [
  { title: '景点', kinds: ['scenic'] },
  { title: '吃住逛', kinds: ['food', 'stay', 'shopping'] },
]
  .map((row) => ({
    ...row,
    places: places
      .filter((place) => row.kinds.includes(place.kind!))
      .map((place) => ({
        ...place,
        // A row of more than one kind says each card's.
        meta: [row.kinds.length > 1 && placeKindLabels[place.kind!], place.city]
          .filter(Boolean)
          .join('\u2003'),
      })),
  }))
  .filter((row) => row.places.length > 0)
// The year's meals as a menu: the ones worth having again as its specials, the rest as
// its everyday dishes and the bad ones struck out; each with a photo of it, what it cost
// a head when the bill was kept, and its city unless its name says it, linking to its Moment.
const meals = getYearMeals(review.moments).map((meal) => {
  const division = allPlaces[meal.moment.locations[0]?.id ?? '']?.division
  const city = division?.city && getCityName(division.city)
  const bill = meal.moment.food?.bill
  return {
    ...meal,
    city: city && !meal.name.includes(city) ? city : undefined,
    fullCity: city,
    photo: photosOf([meal.moment], 96, 1)[0],
    price: bill && `¥${formatNumber(Math.round((bill.amount / (bill.people ?? 1)) * 10) / 10)}${bill.people ? '/人' : ''}`,
  }
})
const menuCities = new Set(meals.map((meal) => meal.fullCity).filter(Boolean)).size
const menuRows = [
  { title: '招牌', verdicts: ['good'] },
  { title: '家常', verdicts: ['ok', undefined] },
  { title: '避雷', verdicts: ['bad'] },
]
  .map((row) => ({ ...row, meals: meals.filter((meal) => row.verdicts.includes(meal.verdict)) }))
  .filter((row) => row.meals.length > 0)
const postLinks = new Set((await getSortedPosts()).map((post) => post.data.link))
const devices = Object.entries(readDevices())
  .filter(([, device]) => life || device.bought.on.startsWith(String(year)))
  .sort(([, first], [, second]) => first.bought.on.localeCompare(second.bought.on))
  .map(([id, device]) => ({
    ...device,
    // Its own post, when one was written about it.
    href: postLinks.has(id) ? `/${id}/` : '/use/',
  }))
const devicesSpent = devices.reduce((total, device) => total + device.bought.price, 0)
const between = (start: string, end: string) =>
  review.moments.filter((moment) => moment.dateKey >= start && moment.dateKey <= end)

// The year's numerals, or a life's title, cut out of its photos, a month's each in two
// rows, drawn as one picture by /<year>/collage.webp.ts or /life/collage.webp.ts.
const collage = life ? getLifeCollage(years, moments) : getYearCollage(year, moments)
const collageUrl = life ? '/life/collage.webp' : `/${year}/collage.webp`
const heading = life ? '人生' : String(year)
const name = life ? '这些年' : `${year} 年`
// What the share pictures are named and stamped for, and shared as.
const shareKey = life ? 'life' : String(year)
const shareTitle = life ? '人生' : `${year} 年`

const headline = (moment: Moment) => getMomentHeadline(moment, 24)?.headline ?? '一张照片'

const description = `${name}记下了什么，去了哪里。`
// A life's years, each with what it adds up to, linking to its own review.
const yearRows = life
  ? years.map((at) => {
      const of = buildYearReview(at, moments, allTrips, regions)
      return {
        year: at,
        moments: of.moments.length,
        days: of.dayCount,
        cities: of.cities.lit.length,
        trips: of.trips.length,
      }
    })
  : []
// A life's days, a year's wall of them each.
const mosaics = (life ? years : [year]).map((at) => ({
  year: at,
  moments: review.moments.filter((moment) => moment.dateKey.startsWith(`${at}-`)),
  trips: review.trips.filter((trip) => trip.start.startsWith(`${at}-`)),
}))
const [firstMoment] = review.moments
const lastMoment = review.moments.at(-1)
const statsOf = (of: typeof review) => [
  { value: of.moments.length, label: '个时刻' },
  { value: of.photoCount, label: '张照片' },
  { value: of.dayCount, label: '天有记录' },
  { value: of.cities.lit.length, label: '个城市' },
  { value: of.drivingKm, label: '公里自驾' },
]
const beforeStats = before && statsOf(before)
const stats = statsOf(review)
  .map((stat, index) => {
    const was = beforeStats?.[index]?.value
    const change = was ? Math.round(((stat.value - was) / was) * 100) : undefined
    return { ...stat, change }
  })
  // The car's own distance leads its section in the years it drove, so not here as well.
  .filter((stat) => stat.label !== '公里自驾' || (stat.value > 100 && !drove))
// Each topic beside the whole year before, as the stats are.
const topics = review.topics.map((topic) => ({
  ...topic,
  previous: before?.topics.find((was) => was.topic === topic.topic)?.count ?? 0,
}))
const highlights = [
  firstMoment && {
    kicker: '第一条',
    title: headline(firstMoment),
    date: formatDay(firstMoment.dateKey),
    href: getMomentPagePath(firstMoment),
    layout: 'single',
    pictures: [photosOf([firstMoment], 480, 1)],
  },
  review.busiestDay.count > 1 && {
    kicker: '最满的一天',
    title: `记了 ${review.busiestDay.count} 条`,
    date: formatDay(review.busiestDay.dateKey),
    href: getMomentPath(review.busiestDay.dateKey),
    // Four of the day's photos in a grid, a different four each visit.
    layout: 'grid',
    pictures: photosOf(between(review.busiestDay.dateKey, review.busiestDay.dateKey), 320, 2)
      .slice(0, 4)
      .map((photo) => [photo]),
    set: photosOf(between(review.busiestDay.dateKey, review.busiestDay.dateKey), 320, 2).slice(0, 12),
  },
  review.streak.days > 1 && {
    kicker: '最长连续记录',
    title: `连续 ${review.streak.days} 天`,
    date: `${formatDay(review.streak.start)}起`,
    href: getMomentPath(review.streak.start),
    // A strip for each day of the run, one of its photos in it.
    layout: 'strips',
    pictures: Map.groupBy(between(review.streak.start, review.streak.end), (moment) => moment.dateKey)
      .values()
      .map((dayMoments) => photosOf(dayMoments, 320))
      .filter((photos) => photos.length > 0)
      .take(7)
      .toArray(),
  },
  lastMoment &&
    lastMoment !== firstMoment && {
      kicker: ongoing ? '最近一条' : '最后一条',
      title: headline(lastMoment),
      date: formatDay(lastMoment.dateKey),
      href: getMomentPagePath(lastMoment),
      layout: 'single',
      pictures: [photosOf([lastMoment], 480, 1)],
    },
]
  .filter((highlight) => highlight !== undefined && highlight !== false)
  // Each picture with the photos it may show; a set's share theirs, dealt without repeats.
  .map((highlight) => ({
    ...highlight,
    pictures: highlight.pictures.filter((photos) => photos.length > 0).map(pictureOf),
    set: 'set' in highlight && highlight.set.length > 4 ? JSON.stringify(highlight.set) : undefined,
  }))
---

<Layout
  title={getPageTitle({ heading })}
  shareTitle={shareTitle}
  description={description}
  image={await getPageCardPath(Astro.url.pathname)}
>
  <SitePage>
    {/* Before the page is read: its motion following the scroll where the browser can do
        that; else what's still to come hidden until the script below reveals it, unless the
        page is coming back to where it was part way down (the layout's script), what's on
        screen there at once rather than rising in once it has scrolled. And the year's hand
        begun, ahead of its first picture (src/year-random.ts). Without script, all shows as
        it is. */}
    <script
      is:inline
      set:html={`if (CSS.supports('animation-timeline: view()')) document.documentElement.classList.add('year-scroll'); else if (!(history.state?.scrollY > 0)) document.documentElement.classList.add('year-motion');(${dealYear})('start')`}
    />
    <header class="year-hero" data-year-deal>
      <h1 class:list={{ 'is-collage': collage }} style={collage && `background-image: url("${collageUrl}")`}>
        {heading}
      </h1>
      <dl class="year-stats">
        {
          stats.map((stat, index) => (
            <div style={`--index: ${index}`}>
              <dt>{stat.label}</dt>
              <dd>
                <span class="year-stats__value">
                  {/* The final count, unseen, holds its width while the shown one rolls up to it. */}
                  <span class="year-stats__final" aria-hidden="true">{formatNumber(stat.value)}</span>
                  <span data-value={stat.value}>{formatNumber(stat.value)}</span>
                </span>
                {stat.change !== undefined && (
                  <span
                    class:list={['year-stats__change', { 'is-up': stat.change > 0 }]}
                    title={`比 ${previous} 年`}
                  >
                    {formatChange(stat.change)}
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </header>

    {
      yearRows.length > 0 && (
        <section class="year-section" aria-labelledby="year-years">
          <h2 id="year-years">每一年</h2>
          <p class="year-lead">
            <span>
              {yearRows.length}<small>年</small>
            </span>
          </p>
          <ol class="year-years">
            {yearRows.map((row, index) => (
              <li style={`--index: ${index}`}>
                <a href={`/${row.year}/`}>
                  <span class="year-years__year">{row.year}</span>
                  <span class="year-years__counts">
                    {row.moments} 个时刻&emsp;{row.days} 天&emsp;{row.cities} 个城市
                    {row.trips > 0 && `\u2003${row.trips} 次出行`}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      review.cities.lit.length > 0 && (
        <section class="year-section year-wide" aria-labelledby="year-footprint">
          <h2 id="year-footprint">足迹</h2>
          <p class="year-lead">
            <span>
              {review.cities.provinces}<small>个省</small>
            </span>
          </p>
          <YearFootprint map={map} label={`${name}去过的 ${review.cities.lit.length} 个城市和走过的路线`} />
          <ol class="year-cities" aria-label="记下最多的城市">
            {topCities.map((city, index) => (
              <li data-city={city.id} style={`--share: ${city.count / topCities[0]!.count}; --index: ${index}`}>
                <span class="year-cities__name">{city.name}</span>
                <span class="year-cities__bar" />
                <span class="year-cities__count">{city.count}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      trips.length > 0 && (
        <section class="year-section" aria-labelledby="year-trips">
          <h2 id="year-trips">出行</h2>
          <p class="year-lead">
            <span>
              {trips.length}<small>次</small>
            </span>
            <span>
              {tripDays}<small>天在路上</small>
            </span>
          </p>
          <ul class="year-trips">
            {featuredTrips.map(({ trip, glyph, covers }, index) => (
              <li style={`--index: ${index}`}>
                <a href={`/trip/${trip.id}/`} title={trip.title} data-trip-card={trip.id}>
                  {covers[0] && (
                    <img
                      src={covers[0].thumbnail}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      data-pick={pickFrom(covers.map((cover) => cover.thumbnail))}
                    />
                  )}
                  <svg viewBox={`0 0 ${glyph.width} ${glyph.width}`} aria-hidden="true" data-trip-card-route>
                    <path d={glyph.d} transform={`translate(0 ${(glyph.width - glyph.height) / 2})`} pathLength="1" />
                  </svg>
                  <span class="year-trips__date">{tripDate(trip)}</span>
                  <span class="year-trips__words">
                    <span class="year-trips__title" data-trip-card-title>{trip.title}</span>
                    <span class="year-trips__meta">{tripMeta(trip)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {otherTrips.length > 0 && (
            <ul
              class="year-more-trips"
              style={`--rows: ${Math.ceil(otherTrips.length / 2)}`}
              aria-label="其他出行"
            >
              {otherTrips.map(({ trip }) => (
                <li>
                  <a href={`/trip/${trip.id}/`}>
                    <span class="year-more-trips__date">{tripDate(trip)}</span>
                    <span class="year-more-trips__title">{trip.title}</span>
                    <span class="year-more-trips__meta">{tripMeta(trip)}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )
    }

    {
      drove && (
        <section class="year-section" aria-labelledby="year-driving">
          <h2 id="year-driving">开车</h2>
          <YearDriving {...(life ? {} : { year })} floor={carFloor} />
        </section>
      )
    }

    {
      (life || before) && review.firstVisits.length > 0 && (
        <section class="year-section" aria-labelledby="year-first">
          <h2 id="year-first">第一次去</h2>
          <p class="year-lead">
            <span>
              {review.firstVisits.length}<small>座新城市</small>
            </span>
          </p>
          <ol class:list={['year-first', { 'is-years': life }]}>
            {firstVisitColumns.map((column, index) => (
              <li class:list={{ 'is-empty': !firstVisits.has(column.key) }} style={`--month: ${index}`}>
                <span class="year-first__month">{column.label}</span>
                {(firstVisits.get(column.key) ?? []).map((visit, order) => (
                  <span class="year-first__city" title={formatDay(visit.dateKey)} style={`--index: ${order}`}>
                    {visit.name}
                  </span>
                ))}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      places.length > 0 && (
        <section class="year-section" aria-labelledby="year-places">
          <h2 id="year-places">去过的地方</h2>
          {placeRows.map((row) => (
            <div class="year-places" data-carousel>
              <div class="year-places__head">
                <h3>
                  {row.title}
                  <span class="year-places__count">{row.places.length}</span>
                </h3>
                <div class="year-places__actions" data-share-skip>
                  <div class="year-places__nav" data-carousel-nav hidden>
                    <button type="button" data-carousel-step="-1" aria-label={`上一组${row.title}`} disabled>
                      <span class="i-lucide-chevron-left" aria-hidden="true" />
                    </button>
                    <button type="button" data-carousel-step="1" aria-label={`下一组${row.title}`}>
                      <span class="i-lucide-chevron-right" aria-hidden="true" />
                    </button>
                  </div>
                  {row.places.length > 2 && (
                    <button
                      class="year-places__all"
                      type="button"
                      data-carousel-all
                      aria-expanded="false"
                      aria-label={`全部 ${row.places.length} 个${row.title}`}
                    >
                      <span class="year-places__all-show">全部</span>
                      <span class="year-places__all-hide">收起</span>
