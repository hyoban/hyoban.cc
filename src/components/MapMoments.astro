---
import MomentEntry from '@/components/MomentEntry.astro'
import type { Moment } from '@/moments'

// A year's Moments for the list beside the map, newest first: its months to pick one
// by (or the whole year), then each month's, each with its day and time on one line. The map fetches it as a fragment for a year picked there
// (see pages/map/[year]/moments.astro), and a year's page renders it in place.

interface Props {
  /** The month shown, of those of the year; every month without one. */
  month?: number | undefined
  /** The year's Moments. */
  moments: Moment[]
  year: number
}

const { month: pickedMonth, moments, year } = Astro.props
const getMonth = (moment: Moment) => Number.parseInt(moment.dateKey.slice(5, 7), 10)
const months = [...Map.groupBy(moments, getMonth)]
  .sort(([first], [second]) => second - first)
  // Newest first, down to the time of day: the Moments come oldest first.
  .map(([month, monthMoments]) => ({ month, moments: monthMoments.toReversed() }))
const monthCounts = new Map(months.map(({ month, moments: monthMoments }) => [month, monthMoments.length]))
const chipClass = 'flex h-8 min-w-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent px-2.5 font-mono text-[0.8125rem] text-tx-2 tabular-nums hover:bg-inline hover:text-tx disabled:cursor-default disabled:bg-transparent disabled:text-tx-3 disabled:opacity-40 aria-pressed:bg-tx aria-pressed:text-bg'
---

<!-- The year's months, every one in its place and the empty ones dimmed, and the whole
     year; --moments-nav is how tall it is, for the months' headings to stay below. -->
<nav class="sticky top-0 z-[2] -mx-5 grid grid-cols-[auto_repeat(12,minmax(0,1fr))] items-center gap-0.5 border-b border-border bg-bg px-3 py-2" aria-label={`${year} 年按月份查看`}>
  <button class={chipClass} type="button" data-trip-map-month-all aria-pressed={String(pickedMonth === undefined)}>全年</button>
  {
    Array.from({ length: 12 }, (_, index) => index + 1).map(month => (
      <button class:list={[chipClass, 'px-0']} type="button" data-trip-map-month={month} aria-pressed={String(month === pickedMonth)} aria-label={`${month} 月`} disabled={!monthCounts.has(month)} title={monthCounts.has(month) ? `${month} 月 · ${monthCounts.get(month)} 条记录` : `${month} 月没有记录`}>
        {month}
      </button>
    ))
  }
</nav>
{
  months.map(({ month, moments: monthMoments }) => (
    <section data-trip-map-moments-month={month} data-trip-map-count={monthMoments.length} hidden={pickedMonth !== undefined && month !== pickedMonth} aria-labelledby={`trip-map-moments-${year}-${month}`}>
      <h2 class="sticky top-[3.0625rem] z-[1] -mx-5 border-b border-border bg-bg px-5 py-2 text-sm font-medium" id={`trip-map-moments-${year}-${month}`}>
        {month} 月<span class="ml-2 text-xs font-normal text-tx-3 tabular-nums">{monthMoments.length} 条记录</span>
      </h2>
      {monthMoments.map(moment => <MomentEntry date="day" moment={moment} />)}
    </section>
  ))
}
