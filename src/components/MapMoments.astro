---
import MomentEntry from '@/components/MomentEntry.astro'
import { getMonthPath, type Moment } from '@/moments'

// A year's Moments for the list beside the map, newest first: its months to pick one
// by (or the whole year), then each month's, each with its day and time on one line. The map fetches it as a fragment for a year picked there
// (see pages/map/[year]/moments.astro), and a year's page renders it in place.

interface Props {
  /** The month shown, of those of the year; every month without one. */
  month?: number | undefined
  /** The year's Moments. */
  moments: Moment[]
  year: number
}

const { month: pickedMonth, moments, year } = Astro.props
const getMonth = (moment: Moment) => Number.parseInt(moment.dateKey.slice(5, 7), 10)
const months = [...Map.groupBy(moments, getMonth)]
  .sort(([first], [second]) => second - first)
  // Newest first, down to the time of day: the Moments come oldest first.
  .map(([month, monthMoments]) => ({ month, moments: monthMoments.toReversed() }))
const chipClass = 'flex h-8 min-w-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent px-2.5 font-mono text-[0.8125rem] text-tx-2 tabular-nums hover:bg-inline hover:text-tx aria-pressed:bg-tx aria-pressed:text-bg'
---

<!-- The whole year, and its months with Moments; 3.0625rem tall, which the months'
     headings stay below. -->
<nav class="sticky top-0 z-[2] -mx-5 flex items-center gap-0.5 overflow-x-auto border-b border-border bg-bg px-3 py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" aria-label={`${year} 年按月份查看`}>
  <button class:list={[chipClass, 'shrink-0']} type="button" data-trip-map-month-all aria-pressed={String(pickedMonth === undefined)}>全年</button>
  {
    months.toReversed().map(({ month, moments: monthMoments }) => (
      <button class:list={[chipClass, 'min-w-8 shrink-0 px-1.5']} type="button" data-trip-map-month={month} aria-pressed={String(month === pickedMonth)} aria-label={`${month} 月`} title={`${month} 月 · ${monthMoments.length} 条记录`}>
        {month}
      </button>
    ))
  }
</nav>
{
  months.map(({ month, moments: monthMoments }) => (
    <section data-trip-map-moments-month={month} data-trip-map-count={monthMoments.length} hidden={pickedMonth !== undefined && month !== pickedMonth} aria-labelledby={`trip-map-moments-${year}-${month}`}>
      {/* Only for the whole year: a month picked is the list's own title. */}
      <h2 class="sticky top-[3.0625rem] z-[1] -mx-5 border-b border-border bg-bg px-5 py-2 text-sm font-medium [&[hidden]]:hidden" id={`trip-map-moments-${year}-${month}`} data-trip-map-moments-heading hidden={pickedMonth !== undefined}>
        <a class="text-inherit no-underline hover:underline" href={getMonthPath(`${year}-${String(month).padStart(2, '0')}`)} title={`在日历中查看 ${year} 年 ${month} 月`}>{month} 月</a>
        <span class="ml-2 text-xs font-normal text-tx-3 tabular-nums">{monthMoments.length} 条记录</span>
      </h2>
      {monthMoments.map(moment => <MomentEntry date="day" moment={moment} />)}
    </section>
  ))
}
