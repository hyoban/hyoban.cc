---
import MomentEntry from '@/components/MomentEntry.astro'
import { getMonthPath, type Moment } from '@/moments'

// A year's Moments for the list beside the map, newest first: its months to pick one
// by (or the whole year), then each month's, each with its day and time on one line. The map fetches it as a fragment for a year picked there
// (see pages/map/[year]/moments.astro), and a year's page renders it in place. A month's
// page renders only that month's, leaving the rest to the fragment, which the map
// fetches once another is picked (`data-trip-map-moments-month-only`).

interface Props {
  /** The one month rendered, of those of the year; every month without one. */
  month?: number | undefined
  /** The year's Moments. */
  moments: Moment[]
  year: number
}

const { month: pickedMonth, moments, year } = Astro.props
const getMonth = (moment: Moment) => Number.parseInt(moment.dateKey.slice(5, 7), 10)
const months = [...Map.groupBy(moments, getMonth)]
  .sort(([first], [second]) => second - first)
  // Newest first, down to the time of day: the Moments come oldest first.
  .map(([month, monthMoments]) => ({ month, moments: monthMoments.toReversed() }))
const firstMoment = months.find(({ month }) => pickedMonth === undefined || month === pickedMonth)?.moments[0]
---

<!-- The whole year, and its months with Moments; 3.0625rem tall, which the months'
     headings stay below. -->
<nav class="map-moments__months" aria-label={`${year} 年按月份查看`}>
  <button class="map-moments__month" type="button" data-trip-map-month-all aria-pressed={pickedMonth === undefined ? 'true' : 'false'}>全年</button>
  {
    months.toReversed().map(({ month, moments: monthMoments }) => (
      <button class="map-moments__month map-moments__month--number" type="button" data-trip-map-month={month} aria-pressed={month === pickedMonth ? 'true' : 'false'} aria-label={`${month} 月`} title={`${month} 月 · ${monthMoments.length} 条记录`}>
        {month}
      </button>
    ))
  }
</nav>
{
  months.filter(({ month }) => pickedMonth === undefined || month === pickedMonth).map(({ month, moments: monthMoments }) => (
    <section data-trip-map-moments-month={month} data-trip-map-count={monthMoments.length} aria-labelledby={`trip-map-moments-${year}-${month}`}>
      {/* Only for the whole year: a month picked is the list's own title. */}
      <h2 class="map-moments__heading" id={`trip-map-moments-${year}-${month}`} data-trip-map-moments-heading hidden={pickedMonth !== undefined}>
        <a href={getMonthPath(`${year}-${String(month).padStart(2, '0')}`)} title={`在日历中查看 ${year} 年 ${month} 月`}>{month} 月</a>
        <span>{monthMoments.length} 条记录</span>
      </h2>
      {/* The list's first Moment is in view as the sidebar opens, at any width. */}
      {monthMoments.map(moment => <MomentEntry date="day" moment={moment} priorityMedia={moment === firstMoment ? 'all' : undefined} />)}
    </section>
  ))
}

<style>
  /* Both reach out to the sidebar's edges, across its padding. */
  .map-moments__months {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-inline: -1.25rem;
    overflow-x: auto;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .map-moments__month {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    height: 2rem;
    padding-inline: 0.625rem;
    border-radius: 9999px;
    color: var(--color-tx-2);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;

    @media (hover: hover) {
      &:hover {
        background: var(--color-inline);
        color: var(--color-tx);
      }
    }

    &[aria-pressed='true'] {
      background: var(--color-tx);
      color: var(--color-bg);
    }
  }

  .map-moments__month--number {
    min-width: 2rem;
  }

  .map-moments__heading {
    position: sticky;
    top: 3.0625rem;
    z-index: 1;
    margin-inline: -1.25rem;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25rem;

    & a {
      color: inherit;
      text-decoration: none;

      @media (hover: hover) {
        &:hover {
          text-decoration-line: underline;
        }
      }
    }

    & span {
      margin-left: 0.5rem;
      color: var(--color-tx-3);
      font-size: 0.75rem;
      font-weight: 400;
      line-height: 1rem;
      font-variant-numeric: tabular-nums;
    }
  }
</style>
