---
import { getAssetUrl } from '@/asset-url'
import { SITE_TITLE } from '@/consts'
---

<a class="calendar-back-link" href="/" aria-label={`返回 ${SITE_TITLE} 首页`}>
  <img src={getAssetUrl('site/avatar-80.webp')} alt="" width="24" height="24" />
  <span class="calendar-back-link__name">{SITE_TITLE}</span>
</a>

<style>
  .calendar-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    padding: 0.25rem 0.875rem 0.25rem 0.375rem;
    border: 1px solid var(--color-glass-border);
    border-radius: 9999px;
    background: var(--color-glass);
    -webkit-backdrop-filter: blur(1rem);
    backdrop-filter: blur(1rem);
    color: var(--color-tx);
    font-size: 0.8125rem;
    text-decoration: none;

    @media (hover: hover) {
      &:hover {
        background: var(--color-inline);
      }
    }

    & img {
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 9999px;
    }
  }

  .calendar-back-link__name {
    font-weight: 500;
  }

  /* Beside a day's drawer, just the avatar. */
  :global(.calendar-page--with-drawer) .calendar-back-link {
    padding-right: 0.375rem;

    & .calendar-back-link__name {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
