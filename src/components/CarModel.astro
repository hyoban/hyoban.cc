---
import { getAssetUrl } from '@/asset-url'

// The car in 3D at the head of the driving section: a bought model of the 007GT painted in
// its colour, in site/ on the image origin, drawn by src/car-model-client.ts once the
// section nears the screen, where it drives in with the scroll the first time it's seen. It
// comes first in a lighter cut, and the full one takes its place once it has settled. Until
// then, and without the script or WebGL, a still of it.
---

<figure
  class="car-model"
  data-src={getAssetUrl('site/zeekr-007gt-7.glb')}
  data-full-src={getAssetUrl('site/zeekr-007gt-7-full.glb')}
  role="img"
  aria-label="极氪 007GT 的 3D 模型，左右拖动可以转动"
>
  <img src={getAssetUrl('site/zeekr-007gt-7.webp')} alt="" width="1664" height="746" loading="lazy" decoding="async" />
</figure>

<script>
  let disposers: (() => void)[] = []

  // Three.js only loads for a car about to come into sight, and each is let go when the
  // router swaps the page out.
  function initializeCarModels() {
    const frames = document.querySelectorAll<HTMLElement>('.car-model:not(.is-mounted)')
    if (!frames.length) return
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          const frame = entry.target as HTMLElement
          observer.unobserve(frame)
          frame.classList.add('is-mounted')
          import('@/car-model-client')
            .then(({ mountCarModel }) => mountCarModel(frame, frame.dataset.src!, frame.dataset.fullSrc))
            .then((dispose) => disposers.push(dispose))
            .catch(() => frame.classList.remove('is-mounted'))
        }
      },
      { rootMargin: '50% 0px' },
    )
    for (const frame of frames) observer.observe(frame)
  }

  document.addEventListener('astro:page-load', initializeCarModels)
  document.addEventListener('astro:before-swap', () => {
    for (const dispose of disposers) dispose()
    disposers = []
  })
</script>

<style>
  .car-model {
    position: relative;
    /* Above the figures after it, which rise in on a transform of their own. */
    z-index: 1;
    aspect-ratio: 3;
    margin: 0 0 1rem;
    cursor: grab;

    &:active {
      cursor: grabbing;
    }

    /* The car is drawn bigger than the frame it takes up in the page, spilling up over the
       heading, down over the figures, and out to the sides as far as the screen has room,
       for its corners as it turns; only the frame itself takes a drag. */
    --spill: max(0px, min(15%, (100vw - 100%) / 2 - 1rem));

    & img,
    & :global(canvas) {
      position: absolute;
      top: -55%;
      left: calc(-1 * var(--spill));
      z-index: 1;
      width: calc(100% + 2 * var(--spill));
      height: 175%;
      pointer-events: none;
    }

    & img {
      /* Out past the frame like the canvas, not held inside it as images are elsewhere. */
      max-width: none;
      object-fit: contain;
    }

    /* The model takes over from its still once it has drawn. */
    & :global(canvas) {
      opacity: 0;
    }

    &.is-ready :global(canvas) {
      opacity: 1;
    }

    &.is-ready img {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .car-model img,
    .car-model :global(canvas) {
      transition: opacity 200ms var(--ease-out);
    }
  }
</style>
