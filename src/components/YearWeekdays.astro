---
// Which days of the week the year was written on, Monday first: a bar for each as long as
// how much was written on it, the weekend shaded behind, the busiest day dark.

interface Props {
  weekdays: number[]
}

const { weekdays } = Astro.props
const names = ['一', '二', '三', '四', '五', '六', '日']
const max = Math.max(1, ...weekdays)
const top = weekdays.indexOf(Math.max(...weekdays))
const days = weekdays.map((count, index) => ({
  count,
  index,
  name: names[index]!,
  weekend: index >= 5,
  width: `${Math.max(count / max, 0.02) * 100}%`,
}))
---

<ul class="year-weekdays" aria-label={`每周各天记下的条数，最常在周${names[top]}`}>
  {
    days.map((day) => (
      <li class:list={{ 'is-weekend': day.weekend, 'is-top': day.index === top && day.count > 0 }} style={`--day: ${day.index}`}>
        <span class="year-weekdays__name">周{day.name}</span>
        <span class="year-weekdays__track">
          <span class="year-weekdays__bar" style={`width: ${day.width}`} />
        </span>
        <span class="year-weekdays__count">{day.count}</span>
      </li>
    ))
  }
</ul>

<style>
  .year-weekdays {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;

    & li {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      align-items: center;
      padding: 0.125rem 0.5rem;
      border-radius: 0.375rem;
    }

    & li.is-weekend {
      background: var(--color-inline);
    }
  }

  .year-weekdays__name,
  .year-weekdays__count {
    color: var(--color-tx-3);
  }

  .year-weekdays__count {
    text-align: end;
  }

  .year-weekdays__track {
    display: block;
  }

  .year-weekdays__bar {
    display: block;
    height: 0.625rem;
    border-radius: 999px;
    background: var(--color-tx-3);
    opacity: 0.45;
  }

  .is-top {
    & .year-weekdays__bar {
      background: var(--color-tx);
      opacity: 1;
    }

    & .year-weekdays__name,
    & .year-weekdays__count {
      color: var(--color-tx);
      font-weight: 600;
    }
  }

  /* The bars grow out from the left, Monday first, when the section is first seen. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.is-revealed) .year-weekdays__bar {
      transform-origin: left center;
      animation: year-weekdays-grow 700ms var(--ease-out) backwards;
      animation-delay: calc(300ms + var(--day) * 60ms);
    }
  }

  @keyframes year-weekdays-grow {
    from {
      scale: 0 1;
    }
  }
</style>
