---
// Which days of the week the year was written on, a companion to the clock: a column for
// each day, Monday first, as tall as how much was written on it, the weekend shaded
// behind like the clock's night, the busiest day dark.

interface Props {
  weekdays: number[]
}

const { weekdays } = Astro.props
const names = ['一', '二', '三', '四', '五', '六', '日']
const max = Math.max(1, ...weekdays)
const busiest = Math.max(...weekdays)
const days = weekdays.map((count, index) => ({
  count,
  index,
  name: names[index]!,
  top: busiest > 0 && count === busiest,
  height: `${Math.max(count / max, 0.04) * 100}%`,
}))
const label = `每周各天记下的条数：${days.map((day) => `周${day.name} ${day.count} 条`).join('，')}`
---

<div class="year-weekdays" role="img" aria-label={label}>
  <span class="year-weekdays__weekend" aria-hidden="true"></span>
  {
    days.map((day) => (
      <span class:list={['year-weekdays__column', { 'is-top': day.top }]} title={`周${day.name}\u2003${day.count} 条`} style={`grid-column: ${day.index + 1}; --day: ${day.index}`}>
        <span class="year-weekdays__bar" style={`height: ${day.height}`}>
          <span class="year-weekdays__count">{day.count}</span>
        </span>
      </span>
    ))
  }
  {
    days.map((day) => (
      <span class:list={['year-weekdays__name', { 'is-top': day.top }]} style={`grid-column: ${day.index + 1}`} aria-hidden="true">
        {day.name}
      </span>
    ))
  }
</div>

<style>
  .year-weekdays {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    grid-template-rows: 9rem auto;
    column-gap: 0.375rem;
    row-gap: 0.5rem;
    width: min(100%, 17rem);
    margin-inline: auto;
  }

  /* Saturday and Sunday, shaded the way the clock shades the night. */
  .year-weekdays__weekend {
    grid-column: 6 / 8;
    grid-row: 1 / 3;
    margin: -0.375rem -0.1875rem;
    border: 0.5px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-inline);
  }

  .year-weekdays__column {
    grid-row: 1;
    display: flex;
    align-items: end;
    justify-content: center;
    height: 100%;
  }

  .year-weekdays__bar {
    display: block;
    width: min(100%, 1rem);
    border-radius: 3px;
    background: var(--color-tx-3);
    opacity: 0.45;
    transition: opacity 140ms var(--ease);
  }

  .year-weekdays__column:hover .year-weekdays__bar {
    opacity: 0.8;
  }

  /* Each day's count over its column, the busiest's always and the others' when pointed at. */
  .year-weekdays__bar {
    position: relative;
  }

  .year-weekdays__count {
    position: absolute;
    bottom: calc(100% + 0.25rem);
    left: 50%;
    color: var(--color-tx);
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    translate: -50% 0.25rem;
    transition:
      opacity 140ms var(--ease),
      translate 140ms var(--ease-out);

    .year-weekdays__column:hover &,
    .is-top & {
      opacity: 1;
      translate: -50% 0;
    }
  }

  .year-weekdays__column.is-top .year-weekdays__bar {
    background: var(--color-tx);
    opacity: 1;
  }

  .year-weekdays__name {
    grid-row: 2;
    position: relative;
    color: var(--color-tx-3);
    font-size: 10px;
    line-height: 1;
    text-align: center;

    &.is-top {
      color: var(--color-tx);
      font-weight: 600;
    }
  }

  /* The columns grow up from the bottom, Monday first, as the clock's petals grow round it. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.is-revealed) .year-weekdays__bar {
      transform-origin: bottom;
      animation: year-weekdays-grow 700ms var(--ease-out) backwards;
      animation-delay: calc(300ms + var(--day) * 60ms);
    }
  }

  /* Scrolled, where animations can follow it: the columns grow, Monday first, as the chart
     comes up through the screen. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(.year-scroll) {
        & .year-weekdays {
          view-timeline: --week;
        }

        & .year-weekdays__bar {
          transform-origin: bottom;
          animation-name: year-weekdays-grow;
          animation-timing-function: linear;
          animation-fill-mode: both;
          animation-timeline: --week;
          animation-range: entry calc(40% + var(--day) * 4%) cover calc(30% + var(--day) * 2%);
        }
      }
    }
  }

  /* Scale alone: opacity is left to the hover, whose transition an animation of it would
     stop from playing. */
  @keyframes year-weekdays-grow {
    from {
      scale: 1 0;
    }
  }
</style>
