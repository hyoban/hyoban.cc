---
import '@hyoban/trip-map/styles.css'

import CalendarBackLink from '@/components/CalendarBackLink.astro'
import CalendarModeSwitch from '@/components/CalendarModeSwitch.astro'
import MapMoments from '@/components/MapMoments.astro'
import TripCoverCollage from '@/components/TripCoverCollage.astro'
import TripDetails from '@/components/TripDetails.astro'
import MomentLightboxMedia from '@/components/MomentLightboxMedia.astro'
import Layout from '@/layouts/Layout.astro'
import { getActiveDateKeys, getMapYears, getMappedLocationGroups, getMoments, getMonthPath, getTrips } from '@/moments'
import { getTripData, getTripSummary } from '@/moments/trip-data'
import { getTripCollage } from '@/moments/trip-images'
import {
  createYearPalette,
  formatDateRange,
  getMapStats,
  getPlaceMarkers,
  renderShortcuts,
  renderTripPanel,
  renderTripStage,
  toScriptJson,
} from '@hyoban/trip-map'
import { getTripTitle, tripMapBrand, tripMapMessages, tripMapMusic } from '@/trip-map'
import { SITE_TITLE } from '@/consts'

interface Props {
  /** Opens with the list of trips beside the map, this one picked (the /trip/<id>/ pages). */
  pickedTripId?: string
  /** Starts playing this trip when the page loads (the /trip/<id>/play/ pages). */
  tripId?: string
  /** Opens with the list of trips beside the map (the /trip/ page). */
  tripList?: boolean
  /**
   * Opens narrowed to this year, or a month of it, with its Moments beside the map (the
   * /map/<year>/ and /map/<year>/<month>/ pages).
   */
  period?: { month?: number, year: number }
}

const { period, pickedTripId, tripId } = Astro.props
const tripList = Astro.props.tripList ?? false
const pickedYear = period?.year
const moments = await getMoments()
const locationGroups = getMappedLocationGroups(moments)
// Every year with Moments at a place, which the legend narrows the map to.
const years = getMapYears(moments)
const yearColor = createYearPalette(years)
const periodMoments = period
  ? moments.filter(moment => moment.dateKey.startsWith(`${period.year}-`))
  : []
// Each year's latest month with Moments: where the calendar link goes for a whole year.
const latestMonths = Object.fromEntries(getActiveDateKeys(moments).map(dateKey => [dateKey.slice(0, 4), dateKey.slice(0, 7)]))
const getCalendarHref = (picked: typeof period) => {
  const monthKey = picked?.month === undefined
    ? picked && latestMonths[picked.year]
    : `${picked.year}-${String(picked.month).padStart(2, '0')}`

  return monthKey ? getMonthPath(monthKey) : '/calendar/'
}
const periodLabel = period
  ? period.month === undefined ? `${period.year} 年` : `${period.year} 年 ${period.month} 月`
  : undefined
const isInPeriodKey = (dateKey: string) => !period || dateKey.startsWith(
  period.month === undefined ? `${period.year}-` : `${period.year}-${String(period.month).padStart(2, '0')}-`,
)
const periodCount = periodMoments.filter(moment => isInPeriodKey(moment.dateKey)).length
// The places the map shows for the period, as the map's own line says once it runs.
const periodPlaces = locationGroups.filter(group => group.moments.some(moment => isInPeriodKey(moment.dateKey))).length
const periodEyebrow = periodPlaces ? `${periodCount} 条记录 · ${periodPlaces} 个地点` : `${periodCount} 条记录 · 都没有地点`
const mapboxToken = import.meta.env.VITE_MAPBOX_TOKEN ?? ''
const mapTitle = `地图 · 日历 | ${SITE_TITLE}`
const tripListTitle = `旅程 | ${SITE_TITLE}`
const placesJson = toScriptJson(getPlaceMarkers(locationGroups, yearColor))
const trips = getTrips(moments).toSorted((first, second) => second.start.localeCompare(first.start))
const activeTrip = trips.find(trip => trip.id === tripId)
// The trip whose sidebar the page opens on.
const pickedTrip = trips.find(trip => trip.id === pickedTripId)
// The trip the page is about, playing or open in its sidebar: its title, words and image.
const pageTrip = activeTrip ?? pickedTrip
// A trip's page by its year and the rest, /trip/2026/yunnan/, is the one by its id.
const canonicalPath = pageTrip && `/trip/${pageTrip.id}/${activeTrip ? 'play/' : ''}`
// The totals a screenshot of the map puts in its header.
const statsJson = toScriptJson(getMapStats(locationGroups, trips))
// Every trip's route and title for the overview; only the opening trip's playback data
// is inlined, and the player fetches the rest from /trip/<id>/data.json when needed.
const tripsJson = toScriptJson(trips.map(getTripSummary))
const activeTripData = activeTrip ? getTripData(activeTrip) : undefined
const activeTripJson = activeTripData ? toScriptJson(activeTripData) : undefined
// The trip list's line of totals, like the trips page's.
const tripTotals = [
  `${trips.length} 段旅程`,
  `${trips.reduce((total, trip) => total + trip.dayCount, 0)} 天`,
  `${trips.reduce((total, trip) => total + trip.drivingKm, 0).toLocaleString('zh-CN')} 公里自驾`,
].join(' · ')
// The trip list's trips by the year they started, newest first, like the home page's posts.
const tripsByYear = [...Map.groupBy(trips, trip => trip.start.slice(0, 4))]
// The months a period runs from and to, for the trips under way in it.
const periodStart = period ? `${period.year}-${String(period.month ?? 1).padStart(2, '0')}` : ''
const periodEnd = period ? `${period.year}-${String(period.month ?? 12).padStart(2, '0')}` : ''
const isInPeriod = (trip: { end: string, start: string }) =>
  !period || (trip.start.slice(0, 7) <= periodEnd && trip.end.slice(0, 7) >= periodStart)
// The box the place drawer and the trip list share, the map's right side from top to
// bottom (the toolbar's buttons step aside for it, see styles.css), or a phone's bottom:
// most of the screen for a place, and less for the trips, so their routes show above.
const sideClass = 'absolute inset-y-4 right-4 z-10 grid w-[min(28rem,calc(100vw-2rem))] min-w-0 grid-rows-[auto_minmax(0,1fr)] overflow-hidden rounded-xl border border-border bg-bg shadow-[0_1.5rem_5rem_rgb(0_0_0/0.16)] max-[48rem]:inset-x-3 max-[48rem]:bottom-[calc(0.75rem+env(safe-area-inset-bottom))] max-[48rem]:top-auto max-[48rem]:w-auto [&[hidden]]:hidden'
const sideHeaderClass = 'flex items-center justify-between gap-3 border-b border-border py-3 pr-2 pl-5'
const sideCloseClass = 'flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx focus-visible:bg-inline focus-visible:text-tx focus-visible:outline-none'
const title = pageTrip
  ? getTripTitle(pageTrip.title)
  : tripList
    ? tripListTitle
    : periodLabel ? `${periodLabel} · 地图 | ${SITE_TITLE}` : mapTitle
const description = pageTrip
  ? `${pageTrip.title}的旅程回放，按时间顺序走过每一条 Moment。`
  : tripList
    ? '在地图上按时间回放的几段旅程。'
    : periodLabel ? `${periodLabel}的 Moment，在地图上按地点和时间浏览。` : '按地点浏览 Calendar 中记录的 Moment。'
---

<Layout title={title} description={description} image={pageTrip ? `/trip/${pageTrip.id}/og.jpg` : undefined} canonicalPath={canonicalPath}>
  <Fragment slot="head">
    <!-- The map script is large; open the connection for the style and tiles while it loads. -->
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
  </Fragment>
  <main class="trip-map-page @container relative isolate h-dvh w-full overflow-hidden bg-bg" data-trip-map data-trip-map-token={mapboxToken} data-calendar-latest-months={JSON.stringify(latestMonths)} data-trip-map-active={activeTrip ? '' : undefined} transition:persist="trip-map">
    <div class="trip-map-canvas absolute inset-0" data-trip-map-canvas role="region" aria-label="Calendar 地点地图" />

    <header class="trip-map-toolbar pointer-events-none absolute inset-x-4 top-4 z-[5] grid grid-cols-[1fr_auto_1fr] items-center gap-4 max-[48rem]:grid-cols-[auto_minmax(0,1fr)_auto] max-[48rem]:gap-2 [&>*]:pointer-events-auto max-[48rem]:[&_.calendar-back-link]:pr-1.5 max-[48rem]:[&_.calendar-back-link>span]:sr-only min-[48.0625rem]:max-[56rem]:[.trip-map-page:has(:is(.trip-map-drawer,.trip-map-trip-list,.trip-map-moments,.trip-map-trip-details):not([hidden]))_&_.calendar-back-link>span]:sr-only" data-trip-map-toolbar>
      <CalendarBackLink class="justify-self-start" />
      {
        trips.length > 0 && (
          // The routes are drawn on the map; these reach the same trips by keyboard,
          // showing up while one is focused and lifting its route into view.
          <nav class="sr-only min-w-0 justify-self-center focus-within:not-sr-only" aria-label="旅程回放">
            <ul class="flex max-w-full list-none gap-0.5 overflow-x-auto rounded-full border border-[color-mix(in_srgb,var(--color-border)_82%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_88%,transparent)] p-1 shadow-[0_0.5rem_2rem_rgb(0_0_0/0.08)] backdrop-blur-[1rem] [scrollbar-width:none]">
              {trips.map(trip => (
                <li class="shrink-0">
                  <a class="block rounded-full px-3 py-1.5 text-sm whitespace-nowrap text-tx-2 no-underline hover:bg-inline hover:text-tx focus-visible:bg-inline focus-visible:text-tx" href={`/trip/${trip.id}/play/`} data-trip-map-trip-link={trip.id}><span class="sr-only">回放旅程：</span>{trip.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <div class="trip-map-toolbar__actions col-start-3 flex items-center gap-2 justify-self-end">
        <!-- Pressed, a light fog over the map, thinner over a city the more Moments it holds. -->
        <button class="trip-map-fog flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-border)_82%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] text-tx-2 backdrop-blur-[1rem] hover:text-tx aria-pressed:border-tx aria-pressed:bg-tx aria-pressed:text-bg aria-busy:cursor-progress" type="button" data-trip-map-fog aria-pressed="false" aria-label="迷雾地图" title="迷雾地图">
          <span class="i-lucide-cloud-fog text-[0.9375rem]" aria-hidden="true" />
        </button>
        <button class="trip-map-screenshot flex size-10 shrink-0 cursor-pointer items-center justify-center rounded-full border border-[color-mix(in_srgb,var(--color-border)_82%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] text-tx-2 backdrop-blur-[1rem] hover:text-tx disabled:cursor-default disabled:opacity-40 aria-busy:cursor-progress" type="button" data-trip-map-screenshot aria-label="保存地图截图" title="保存地图截图" disabled>
          <span class="i-lucide-camera text-[0.9375rem]" aria-hidden="true" />
        </button>
        <CalendarModeSwitch mode="map" calendarHref={getCalendarHref(period)} />
      </div>
    </header>

    <ol class="trip-map-legend [&[hidden]]:hidden absolute bottom-10 left-1/2 z-[4] flex w-max -translate-x-1/2 list-none items-center gap-3 rounded-full border border-[color-mix(in_srgb,var(--color-border)_82%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] px-3.5 py-2.5 font-mono text-xs shadow-[0_0.5rem_2rem_rgb(0_0_0/0.08)] max-[48rem]:bottom-[calc(1rem+env(safe-area-inset-bottom))]" aria-label="图例：地点按首次记录年份着色" data-trip-map-legend data-trip-map-year-picked={pickedYear !== undefined}>
      {
        // Pressing a year leaves only the places first recorded then on the map.
        years.map(year => (
          <li class="flex items-center">
            <button class="flex cursor-pointer items-center gap-[0.35rem] border-0 bg-transparent p-0 font-inherit text-inherit hover:text-tx-2" type="button" data-trip-map-year={year} aria-pressed={String(year === pickedYear)} title={`只看 ${year} 年的记录`}>
              <span class="block size-2.5 rounded-full border border-white/90 bg-[var(--year-color)] shadow-[0_0_0_1px_rgb(0_0_0/0.12)]" style={`--year-color: ${yearColor(year)}`} aria-hidden="true" />
              {year}
            </button>
          </li>
        ))
      }
      <li class="flex items-center [&[hidden]]:hidden" hidden={pickedYear === undefined}>
        <button class="flex size-4 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-tx-2 hover:text-tx" type="button" data-trip-map-year-clear aria-label="显示全部年份" title="显示全部年份">
          <span class="i-lucide-x text-[0.75rem]" aria-hidden="true" />
        </button>
      </li>
      <li class="border-l border-border pl-3 whitespace-nowrap tabular-nums [&[hidden]]:hidden" data-trip-map-fog-area hidden />
      {
        // The grey lines are trips: say so, and open their list beside the map (the
        // trips page without scripts).
        trips.length > 0 && (
          <li class="flex items-center border-l border-border pl-3">
            <a class="flex items-center gap-[0.35rem] whitespace-nowrap text-inherit no-underline hover:text-tx-2" href="/trip/" data-trip-map-trip-list-open aria-controls="trip-map-trip-list">
              <span class="block h-0.5 w-3.5 rounded-full bg-tx opacity-50" aria-hidden="true" />
              旅程
            </a>
          </li>
        )
      }
    </ol>

    <p class="trip-map-loading absolute left-1/2 top-1/2 z-[3] -translate-1/2 rounded-full border border-border bg-[color-mix(in_srgb,var(--color-bg)_88%,transparent)] px-3.5 py-2.5 [&[hidden]]:hidden" data-trip-map-loading>{activeTripData ? '正在加载旅程地图…' : `正在加载 ${locationGroups.length} 个地点的地图…`}</p>

    <section class="trip-map-fallback absolute left-1/2 top-1/2 z-[6] max-h-[min(36rem,calc(100dvh-8rem))] w-[min(28rem,calc(100vw-2rem))] -translate-1/2 overflow-y-auto rounded-xl border border-border bg-[color-mix(in_srgb,var(--color-bg)_94%,transparent)] p-5 shadow-[0_1rem_4rem_rgb(0_0_0/0.12)] [&[hidden]]:hidden" data-trip-map-fallback aria-live="polite" hidden>
      <p class="mb-4 leading-[1.6] text-tx-2" data-trip-map-fallback-message>地图暂时无法加载。</p>
      <button class="-mt-2 mb-4 inline-flex min-h-9 cursor-pointer items-center gap-1.5 rounded-full border border-border bg-transparent px-3.5 text-[0.8125rem] text-tx hover:bg-inline [&[hidden]]:hidden" type="button" data-trip-map-fallback-retry hidden>
        <span class="i-lucide-rotate-ccw" aria-hidden="true" />
        重新加载
      </button>
      <div class="grid grid-cols-2 gap-1">
        {
          locationGroups.map(group => (
            <button class="grid min-h-11 cursor-pointer grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2 rounded-md border-0 bg-transparent px-2 text-left text-tx hover:bg-inline focus-visible:bg-inline" type="button" data-trip-map-place={group.id}>
              <span class="block size-2.5 rounded-full border border-white/90 bg-[var(--year-color)] shadow-[0_0_0_1px_rgb(0_0_0/0.12)]" style={`--year-color: ${yearColor(group.firstYear)}`} aria-hidden="true" />
              <strong class="truncate font-medium">{group.location.name}</strong>
              <small class="text-tx-3">{group.moments.length} 条</small>
            </button>
          ))
        }
      </div>
    </section>

    <!-- The player's parts are the package's: rendered here so a trip page opens on its intro card at once. -->
    <div class="trip-map-stage" data-trip-map-stage set:html={renderTripStage({ brand: tripMapBrand, messages: tripMapMessages })} />

    <section class="trip-map-panel absolute bottom-4 left-4 z-10 flex max-h-[calc(100%-7rem)] w-[min(22rem,calc(100%-2rem))] flex-col overflow-hidden rounded-xl border border-border bg-bg shadow-[0_1.5rem_5rem_rgb(0_0_0/0.16)] @max-[48rem]:inset-x-3 @max-[48rem]:bottom-[calc(0.75rem+env(safe-area-inset-bottom))] @max-[48rem]:max-h-[calc(100%-1.5rem)] @max-[48rem]:w-auto [&[hidden]]:hidden" data-trip-map-panel aria-labelledby="trip-map-panel-title" hidden={!activeTripData} set:html={renderTripPanel({ messages: tripMapMessages, music: tripMapMusic, trip: activeTripData })} />

    <dialog class="trip-map-shortcuts" data-trip-map-shortcuts aria-labelledby="trip-map-shortcuts-title" closedby="any" set:html={renderShortcuts(tripMapMessages)} />

    <!-- A year's Moments, or a month's, while the map is narrowed to it; before the drawer,
         which a place opens over it. -->
    <aside class:list={['trip-map-moments max-[48rem]:h-[min(60dvh,36rem)]', sideClass]} data-trip-map-moments aria-labelledby="trip-map-moments-title" hidden={!period}>
      <header class={sideHeaderClass}>
        <div class="min-w-0">
          <p class="truncate text-xs text-tx-3 tabular-nums" data-trip-map-moments-eyebrow>{period && periodEyebrow}</p>
          <h1 class="truncate text-lg font-medium" id="trip-map-moments-title" data-trip-map-moments-title>{periodLabel}</h1>
        </div>
        <button class={sideCloseClass} type="button" data-trip-map-moments-close aria-label="关闭记录，显示全部年份">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </header>
      <div class="min-w-0 overflow-y-auto overscroll-contain px-5 pb-4" data-trip-map-moments-content data-trip-map-moments-year={period?.year}>
        {period && <MapMoments month={period.month} moments={periodMoments} year={period.year} />}
      </div>
    </aside>

    <aside class:list={['trip-map-drawer max-[48rem]:h-[min(78dvh,42rem)]', sideClass]} data-trip-map-drawer role="dialog" aria-labelledby="trip-map-drawer-title" hidden>
      <!-- Laid out like the trip card's header: a grey line of totals over the name. -->
      <header class={sideHeaderClass}>
        <div class="min-w-0">
          <p class="truncate text-xs text-tx-3 tabular-nums" data-trip-map-drawer-eyebrow />
          <h1 class="truncate text-lg font-medium" id="trip-map-drawer-title" data-trip-map-drawer-title />
        </div>
        <button class={sideCloseClass} type="button" data-trip-map-drawer-close aria-label="关闭地点详情">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </header>
      <div class="trip-map-drawer__content min-w-0 overflow-y-auto overscroll-contain px-5 pb-4" data-trip-map-drawer-content />
    </aside>

    <!-- A trip opened from its row or its route: its Moments, and the button that plays it. -->
    <aside class:list={['trip-map-trip-details max-[48rem]:h-[min(60dvh,36rem)]', sideClass]} data-trip-map-trip-details aria-labelledby="trip-map-trip-details-title" hidden={!pickedTrip}>
      <header class={sideHeaderClass}>
        <div class="min-w-0">
          <p class="truncate text-xs text-tx-3 tabular-nums" data-trip-map-trip-details-eyebrow>{pickedTrip && formatDateRange(pickedTrip.start, pickedTrip.end, 'zh-CN')}</p>
          <h1 class="truncate text-lg font-medium" id="trip-map-trip-details-title" data-trip-map-trip-details-title>{pickedTrip?.title}</h1>
        </div>
        <button class={sideCloseClass} type="button" data-trip-map-trip-details-close aria-label="关闭旅程">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </header>
      <div class="min-w-0 overflow-y-auto overscroll-contain px-5 pb-4" data-trip-map-trip-details-content data-trip-map-trip-details-trip={pickedTrip?.id}>
        {pickedTrip && <TripDetails moments={moments} trip={pickedTrip} />}
      </div>
    </aside>

    {
      // Every trip beside the map by year, a card with its photos as the app has them:
      // resting on one a while lifts its route, and clicking it opens its sidebar.
      trips.length > 0 && (
        <aside class:list={['trip-map-trip-list max-[48rem]:h-[min(60dvh,36rem)]', sideClass]} id="trip-map-trip-list" data-trip-map-trip-list aria-labelledby="trip-map-trip-list-title" hidden={!tripList}>
          <header class={sideHeaderClass}>
            <div class="min-w-0">
              <p class="truncate text-xs text-tx-3 tabular-nums">{tripTotals}</p>
              <h1 class="truncate text-lg font-medium" id="trip-map-trip-list-title">旅程</h1>
            </div>
            <button class={sideCloseClass} type="button" data-trip-map-trip-list-close aria-label="关闭旅程列表">
              <span class="i-lucide-x" aria-hidden="true" />
            </button>
          </header>
          <div class="min-w-0 overflow-y-auto overscroll-contain px-2 pb-2">
            {tripsByYear.map(([year, yearTrips]) => (
              <section aria-labelledby={`trip-map-trip-list-${year}`} data-trip-map-trip-year={year} hidden={!yearTrips.some(isInPeriod)}>
                <h2 class="sticky top-0 z-[1] bg-bg px-3 pt-3 pb-1 font-mono text-xs text-tx-3 tabular-nums" id={`trip-map-trip-list-${year}`}>{year}</h2>
                <ul class="list-none">
                  {yearTrips.map(trip => (
                    <li class="relative" hidden={!isInPeriod(trip)}>
                      <a class="flex flex-col rounded-xl p-2 text-tx no-underline transition-colors duration-140 hover:bg-inline focus-visible:bg-inline focus-visible:outline-none data-trip-map-lifted:bg-inline" href={`/trip/${trip.id}/`} data-trip-map-trip-link={trip.id}>
                        <TripCoverCollage class="rounded-lg" images={getTripCollage(trip, moments)} sizes="(max-width: 48rem) 100vw, 26rem" />
                        <span class="flex min-w-0 flex-col gap-0.5 px-1 pt-2">
                          <span class="truncate font-medium">{trip.title}</span>
                          <span class="truncate text-sm text-tx-2 tabular-nums">{formatDateRange(trip.start, trip.end, 'zh-CN')}</span>
                          <span class="truncate text-sm text-tx-3 tabular-nums">
                            {trip.dayCount} 天 · {trip.placeCount} 个地点{trip.drivingKm > 0 && ` · 自驾 ${trip.drivingKm.toLocaleString('zh-CN')} 公里`}
                          </span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </aside>
      )
    }

    <dialog class="trip-map-lightbox m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-black/88 p-16 backdrop:bg-transparent max-[48rem]:px-4 max-[48rem]:py-12" data-trip-map-lightbox aria-label="图片查看器">
      <button type="button" class="fixed right-4 top-4 z-[1] flex size-11 cursor-pointer items-center justify-center border-0 bg-transparent text-white" data-trip-map-lightbox-close aria-label="关闭图片">
        <span class="i-lucide-x" aria-hidden="true" />
      </button>
      <button type="button" class="fixed left-2 top-1/2 z-[1] flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center border-0 bg-transparent text-white max-[48rem]:bottom-4 max-[48rem]:top-auto max-[48rem]:translate-y-0" data-trip-map-lightbox-previous aria-label="上一张图片">
        <span class="i-lucide-chevron-left" aria-hidden="true" />
      </button>
      <MomentLightboxMedia imageClass="mx-auto max-h-[calc(100dvh-8rem)] max-w-full object-contain" />
      <button type="button" class="fixed right-2 top-1/2 z-[1] flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center border-0 bg-transparent text-white max-[48rem]:bottom-4 max-[48rem]:top-auto max-[48rem]:translate-y-0" data-trip-map-lightbox-next aria-label="下一张图片">
        <span class="i-lucide-chevron-right" aria-hidden="true" />
      </button>
    </dialog>

    <script is:inline type="application/json" data-trip-map-places set:html={placesJson} />
    <script is:inline type="application/json" data-trip-map-trips set:html={tripsJson} />
    <script is:inline type="application/json" data-trip-map-stats set:html={statsJson} />
    {activeTripJson && <script is:inline type="application/json" data-trip-map-trip set:html={activeTripJson} />}
  </main>
</Layout>

<script>
  import { SITE_TITLE } from '@/consts'
  import { initializeLightboxMedia } from '@/moment-lightbox-client'
  // The place drawers' Moments, and a year's, are fetched fragments, which bring no
  // script of their own.
  import '@/moment-entry-client'
  import { getTripTitle, tripMapBrand, tripMapMessages, tripMapMusic, tripMapSiteLine } from '@/trip-map'

  type MapClient = typeof import('@hyoban/trip-map/client')
  type TripMap = ReturnType<MapClient['createTripMap']>

  let mapClient: Promise<MapClient> | undefined
  let map: TripMap | undefined

  document.addEventListener('astro:page-load', () => {
    const page = document.querySelector<HTMLElement>('[data-trip-map]')

    // The map persists across the map and trip pages; a page without one only needs
    // the one left behind taken down.
    if (!page) {
      map?.destroy()
      map = undefined
      return
    }

    // Closing a place through history fires page-load for the same persisted map.
    if (map?.page === page) {
      return
    }

    // The map script is large and runs long: let the page paint first, so its
    // toolbar and a trip's intro card show while the map loads.
    requestAnimationFrame(() => {
      setTimeout(() => {
        mapClient ??= import('@hyoban/trip-map/client')
        void mapClient.then((client) => {
          if (!page.isConnected || map?.page === page) {
            return
          }

          map?.destroy()
          map = client.createTripMap({
            brand: tripMapBrand,
            createLightboxMedia: initializeLightboxMedia,
            documentTitle: `地图 · 日历 | ${SITE_TITLE}`,
            getDocumentTitle: (trip) => getTripTitle(trip.title),
            getPeriodTitle: ({ month, year }) =>
              `${month === undefined ? `${year} 年` : `${year} 年 ${month} 月`} · 地图 | ${SITE_TITLE}`,
            messages: tripMapMessages,
            music: tripMapMusic,
            onError: (error) => console.warn('[trip-map]', error.message, error.cause ?? ''),
            // The calendar link goes to the month the map is narrowed to, or the year's latest.
            onPeriodChange: (period) => {
              const link = page.querySelector<HTMLAnchorElement>('[data-calendar-mode-switch] a[data-mode="calendar"]')
              const months = JSON.parse(page.dataset.calendarLatestMonths ?? '{}') as Record<string, string>
              const monthKey = period?.month === undefined
                ? period && months[period.year]
                : `${period.year}-${String(period.month).padStart(2, '0')}`

              link?.setAttribute('href', monthKey ? `/calendar/${monthKey.replace('-', '/')}/` : '/calendar/')
            },
            page,
            screenshotTitle: `${SITE_TITLE} 的足迹`,
            siteLine: tripMapSiteLine,
            tripListTitle: `旅程 | ${SITE_TITLE}`,
          })
        })
      })
    })
  })

  // The map's own addresses: the map, a year or a month of it, a place on it, the trip
  // list with a trip picked or not, and a trip playing, from a card of it or not (a
  // trip by its id or by its year and the rest).
  const ownPathPattern = /^\/(?:map(?:\/\d{4}(?:\/\d{2})?)?(?:\/place\/[^/]+)?|trip(?:(?:\/\d{4})?\/[^/]+(?:\/play(?:\/[^/]+)?)?)?)\/$/
  // Set while the router goes back or forward between them.
  let ownTraversal = false

  // Back and forward between the map's own addresses are the map's to follow, as it
  // listens for popstate itself. The router takes them for a new page: it would fetch
  // the page again and crossfade it in, over the drawer as it slides away. It is left
  // nothing to load and nothing to swap, and no transition to show.
  document.addEventListener('astro:before-preparation', (event) => {
    const { from, navigationType, to } = event

    ownTraversal = navigationType === 'traverse'
      && Boolean(map?.page.isConnected)
      && from.search === to.search
      && ownPathPattern.test(from.pathname)
      && ownPathPattern.test(to.pathname)

    if (ownTraversal) {
      event.loader = async () => {}
    }
  })

  // Leaving the map for another page takes the map down before the swap; a change of
  // hash or trip on the same map keeps it.
  document.addEventListener('astro:before-swap', (event) => {
    const { from, to } = event

    if (ownTraversal) {
      ownTraversal = false
      event.viewTransition.skipTransition()
      event.swap = () => {}
      return
    }

    if (from.pathname === to.pathname && from.search === to.search) {
      return
    }

    map?.destroy()
    map = undefined
  })
</script>
