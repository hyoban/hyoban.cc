---
import '@hyoban/trip-map/styles.css'

import CalendarBackLink from '@/components/CalendarBackLink.astro'
import CalendarModeSwitch from '@/components/CalendarModeSwitch.astro'
import MapMoments from '@/components/MapMoments.astro'
import TripCoverCollage from '@/components/TripCoverCollage.astro'
import TripDetails from '@/components/TripDetails.astro'
import MomentLightboxMedia from '@/components/MomentLightboxMedia.astro'
import Layout from '@/layouts/Layout.astro'
import { getActiveDateKeys, getMapYears, getMappedLocationGroups, getMomentPath, getMoments, getMonthPath, getTrips } from '@/moments'
import { formatKilometers, getCarSummary } from '@/car'
import { getTripData, getTripSummaries } from '@/moments/trip-data'
import { getTripCollage } from '@/moments/trip-images'
import {
  createYearPalette,
  formatDate,
  formatDateRange,
  getMapStats,
  getPlaceMarkers,
  renderShortcuts,
  renderTripPanel,
  renderTripStage,
  ALL_PLACES_MAX_ZOOM,
  toScriptJson,
} from '@hyoban/trip-map'
import { getTripDescription, getTripTitle, tripMapBrand, tripMapMessages, tripMapMusic } from '@/trip-map'
import { getMapText, getPageCardPath, getPageTitle } from '@/page-cards'
import { getPlaceDetail } from '@/data/place-info'
import { readPlaces } from '@/data/store'
import { canDrawMapPlaceholders, getMapPlaceholderKey,getMapPlaceholderPath, getMapPlaceholderView, MAP_PLACEHOLDER_SIZE } from '@/map-placeholder'

// The map's settings, by the names @hyoban/trip-map reads them by.
const mapStyles = [
  { id: 'standard', label: '标准', hint: '3D 地形与建筑' },
  { id: 'faded', label: '淡雅', hint: '3D，颜色柔和' },
  { id: 'monochrome', label: '单色', hint: '3D，黑白灰' },
  { id: 'classic', label: '经典', hint: '2D，更流畅' },
] as const
const mapLights = [
  { id: 'auto', label: '跟随主题' },
  { id: 'time', label: '按时间' },
  { id: 'day', label: '白天' },
  { id: 'dawn', label: '黎明' },
  { id: 'dusk', label: '黄昏' },
  { id: 'night', label: '夜晚' },
] as const
const mapLayers = [
  { id: 'buildings', label: '3D 建筑与地标', hint: '楼房、树木和地标模型' },
  { id: 'roads', label: '道路名称', hint: '路名和道路编号' },
  { id: 'pois', label: '商铺与场所', hint: '餐厅、商店、景点等' },
  { id: 'transit', label: '交通站点', hint: '地铁、车站和机场' },
  { id: 'landmarks', label: '地标图标', hint: '著名建筑的插画图标' },
] as const
const mapProjections = [
  { id: 'globe', label: '地球', hint: '缩小时是球体' },
  { id: 'mercator', label: '平面', hint: '始终展开平铺' },
] as const

interface Props {
  /** Opens with the list of trips beside the map, this one picked (the /trip/<id>/ pages). */
  pickedTripId?: string
  /** Starts playing this trip when the page loads (the /trip/<id>/play/ pages). */
  tripId?: string
  /** Opens with the list of trips beside the map (the /trip/ page). */
  tripList?: boolean
  /**
   * Opens narrowed to this year, or a month of it, with its Moments beside the map (the
   * /map/<year>/ and /map/<year>/<month>/ pages).
   */
  period?: { month?: number | undefined, year: number }
}

const { period, pickedTripId, tripId } = Astro.props
const tripList = Astro.props.tripList ?? false
const pickedYear = period?.year
const moments = await getMoments()
const locationGroups = getMappedLocationGroups(moments)
// Every year with Moments at a place, which the legend narrows the map to.
const years = getMapYears(moments)
const yearColor = createYearPalette(years)
const periodMoments = period
  ? moments.filter(moment => moment.dateKey.startsWith(`${period.year}-`))
  : []
// Each year's latest month with Moments: where the calendar link goes for a whole year.
const latestMonths = Object.fromEntries(getActiveDateKeys(moments).map(dateKey => [dateKey.slice(0, 4), dateKey.slice(0, 7)]))
const getCalendarHref = (picked: typeof period) => {
  const monthKey = picked?.month === undefined
    ? picked && latestMonths[picked.year]
    : `${picked.year}-${String(picked.month).padStart(2, '0')}`

  return monthKey ? getMonthPath(monthKey) : '/calendar/'
}
// The Moments beside the map are the map's own pages' alone: the trip list takes that side.
const momentsPeriod = tripList ? undefined : period
// The period's part of an address, `2025/` or `2025/07/`: the trip list's opener goes to
// the list for it, or back to the map from the list.
const periodSegment = period
  ? `${period.year}/${period.month === undefined ? '' : `${String(period.month).padStart(2, '0')}/`}`
  : ''
const periodLabel = period
  ? period.month === undefined ? `${period.year} 年` : `${period.year} 年 ${period.month} 月`
  : undefined
const isInPeriodKey = (dateKey: string) => !period || dateKey.startsWith(
  period.month === undefined ? `${period.year}-` : `${period.year}-${String(period.month).padStart(2, '0')}-`,
)
const periodCount = periodMoments.filter(moment => isInPeriodKey(moment.dateKey)).length
// The places the map shows for the period, as the map's own line says once it runs.
const periodPlaces = locationGroups.filter(group => group.moments.some(moment => isInPeriodKey(moment.dateKey))).length
const periodEyebrow = periodPlaces ? `${periodCount} 条记录\u2003${periodPlaces} 个地点` : `${periodCount} 条记录\u2003都没有地点`
const mapboxToken = import.meta.env.VITE_MAPBOX_TOKEN ?? ''
// The map opens framed on the period's places, or every one, beside the sidebar open: a
// picture of that view stands in while it loads.
const showPlaceholder = mapboxToken !== '' && (await canDrawMapPlaceholders())
const placeholderKey = getMapPlaceholderKey(period)
const placeholderView = showPlaceholder
  ? { ...(await getMapPlaceholderView(placeholderKey)), maxZoom: ALL_PLACES_MAX_ZOOM, size: MAP_PLACEHOLDER_SIZE }
  : undefined
const pageText = getMapText(period, tripList)
// Each place with what and where it is, under its name in the drawer.
const placeRecords = readPlaces()
const placesJson = toScriptJson(
  getPlaceMarkers(locationGroups, yearColor).map(marker => {
    const record = placeRecords[marker.id]
    return { ...marker, detail: record && getPlaceDetail(record) }
  }),
)
const trips = getTrips(moments).toSorted((first, second) => second.start.localeCompare(first.start))
const activeTrip = trips.find(trip => trip.id === tripId)
// The trip whose sidebar the page opens on.
const pickedTrip = trips.find(trip => trip.id === pickedTripId)
// The trip the page is about, playing or open in its sidebar: its title, words and image.
const pageTrip = activeTrip ?? pickedTrip
// A trip's page by its year and the rest, /trip/2026/yunnan/, is the one by its id.
const canonicalPath = pageTrip && `/trip/${pageTrip.id}/${activeTrip ? 'play/' : ''}`
// The totals a screenshot of the map puts in its header.
const statsJson = toScriptJson(getMapStats(locationGroups, trips))
// Every trip's route and title for the overview, in a file every map and trip page shares;
// only the opening trip's playback data is inlined, and the player fetches the rest from
// /trip/<id>/data.json when needed.
const tripSummariesPath = (await getTripSummaries()).path
const activeTripData = activeTrip ? getTripData(activeTrip) : undefined
const activeTripJson = activeTripData ? toScriptJson(activeTripData) : undefined
// The trip list's line of totals, like the trips page's.
const tripTotals = [
  `${trips.length} 段旅程`,
  `${trips.reduce((total, trip) => total + trip.dayCount, 0)} 天`,
  `${trips.reduce((total, trip) => total + trip.drivingKm, 0).toLocaleString('zh-CN')} 公里自驾`,
].join('\u2003')
// The trip list's trips by the year they started, newest first, like the home page's posts.
const tripsByYear = [...Map.groupBy(trips, trip => trip.start.slice(0, 4))]
// The outings the car drove that aren't written up as a trip, newest first, under their
// year's trips: where its Moments were then, if any, and how far it went.
const activeDates = new Set(getActiveDateKeys(moments))
const outingsByYear = Map.groupBy(
  (await getCarSummary()).outings.filter(outing => !outing.trip),
  outing => outing.start.slice(0, 4),
)
// The months a period runs from and to, for the trips under way in it.
const periodStart = period ? `${period.year}-${String(period.month ?? 1).padStart(2, '0')}` : ''
const periodEnd = period ? `${period.year}-${String(period.month ?? 12).padStart(2, '0')}` : ''
const isInPeriod = (trip: { end: string, start: string }) =>
  !period || (trip.start.slice(0, 7) <= periodEnd && trip.end.slice(0, 7) >= periodStart)
const title = pageTrip ? getTripTitle(pageTrip.title, Boolean(activeTrip)) : getPageTitle(pageText)
// A month or a year of the trip list with no trips says so, as its card does.
const description = pageTrip
  ? getTripDescription(pageTrip, Boolean(activeTrip))
  : tripList && period && !trips.some(isInPeriod)
    ? `${period.month === undefined ? '这一年' : '这个月'}没有出门。`
    : pageText.description
const image = pageTrip ? `/trip/${pageTrip.id}/og.jpg` : await getPageCardPath(Astro.url.pathname)
---

<Layout title={title} description={description} image={image} canonicalPath={canonicalPath}>
  <Fragment slot="head">
    <!-- The map script is large; open the connection for the style and tiles while it loads. -->
    <link rel="preconnect" href="https://api.mapbox.com" crossorigin />
  </Fragment>
  <main class="trip-map-page" data-trip-map data-trip-map-token={mapboxToken} data-calendar-latest-months={JSON.stringify(latestMonths)} data-trip-map-active={activeTrip ? '' : undefined} data-trip-map-trips-url={tripSummariesPath} transition:persist="trip-map">
    <h1 class="sr-only">地图</h1>
    <div class="trip-map-canvas" data-trip-map-canvas role="region" aria-label="地点地图" />
    {
      placeholderView && (
        <picture class="trip-map-placeholder" data-trip-map-placeholder>
          <source media="(prefers-color-scheme: dark)" srcset={getMapPlaceholderPath(placeholderView.picture, 'dark')} />
          <img src={getMapPlaceholderPath(placeholderView.picture, 'light')} alt="" fetchpriority="high" />
        </picture>
      )
    }
    <script is:inline>
      // The page dark or light by the clock, as the map lit by it will have it, before
      // it's painted (getBasemapScheme in @hyoban/trip-map: dark at dusk, from 18, and
      // by night, until 5), and the picture standing in for the map with it.
      try {
        const page = document.querySelector('[data-trip-map]')
        const settings = JSON.parse(localStorage.getItem('trip-map-settings') ?? 'null')

        if (settings?.light === 'time' && settings.style !== 'classic') {
          const hour = new Date().getHours()
          const scheme = hour >= 5 && hour < 18 ? 'light' : 'dark'

          page.dataset.tripMapScheme = scheme
          page.querySelector('[data-trip-map-placeholder] source')?.setAttribute('media', scheme === 'dark' ? 'all' : 'not all')
        }
      } catch {
        // The page keeps its colour scheme until the map sets it.
      }
    </script>

    <header class="trip-map-toolbar" data-trip-map-toolbar>
      <CalendarBackLink />
      {
        trips.length > 0 && (
          // The routes are drawn on the map; these reach the same trips by keyboard,
          // showing up while one is focused and lifting its route into view. One stop for
          // Tab, the arrow keys going along them (@hyoban/trip-map's trip-map.ts).
          <nav class="trip-map-toolbar__trips" aria-label="旅程回放">
            <ul>
              {trips.map((trip, index) => (
                <li>
                  <a href={`/trip/${trip.id}/play/`} data-trip-map-trip-link={trip.id} tabindex={index === 0 ? undefined : -1}><span class="sr-only">回放旅程：</span>{trip.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <div class="trip-map-toolbar__actions">
        <button class="trip-map-tool" type="button" data-trip-map-reset-view aria-label="回到初始视图" title="回到初始视图" disabled>
          <span class="i-lucide-house" aria-hidden="true" />
        </button>
        <button class="trip-map-tool trip-map-locate" type="button" data-trip-map-locate aria-label="定位到我的位置" title="定位到我的位置" disabled>
          <span class="i-lucide-locate-fixed" aria-hidden="true" />
        </button>
        <button class="trip-map-tool" type="button" data-trip-map-settings-open aria-haspopup="dialog" aria-label="地图设置" title="地图设置">
          <span class="i-lucide-layers" aria-hidden="true" />
        </button>
        <CalendarModeSwitch mode="map" calendarHref={getCalendarHref(period)} />
      </div>
    </header>

    <ol class="trip-map-legend" aria-label="图例：地点按首次记录年份着色" data-trip-map-legend data-trip-map-year-picked={pickedYear !== undefined}>
      {
        // Pressing a year leaves only the places first recorded then on the map: a link to
        // its address, or from the year picked to every year's again.
        years.map(year => (
          <li>
            <a class="trip-map-legend__year" href={`${tripList ? '/trip/' : '/map/'}${year === pickedYear && period?.month === undefined ? '' : `${year}/`}`} data-trip-map-year={year} aria-current={year === pickedYear ? 'true' : undefined} aria-label={String(year)} title={`只看 ${year} 年的记录`}>
              <span class="trip-map-year-dot" style={`--year-color: ${yearColor(year)}`} aria-hidden="true" />
              <span class="trip-map-legend__label"><span class="trip-map-legend__century">{String(year).slice(0, 2)}</span>{String(year).slice(2)}</span>
            </a>
          </li>
        ))
      }
      <li hidden={pickedYear === undefined}>
        <button class="trip-map-legend__clear" type="button" data-trip-map-year-clear aria-label="显示全部年份" title="显示全部年份">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </li>
      <li class="trip-map-legend__fog-area" data-trip-map-fog-area hidden />
      {
        // The grey lines are trips: say so, and open their list beside the map (the
        // trips page without scripts).
        trips.length > 0 && (
          <li class="trip-map-legend__trips">
            <a href={`${tripList ? '/map/' : '/trip/'}${periodSegment}`} data-trip-map-trip-list-open aria-controls="trip-map-trip-list">
              <span aria-hidden="true" />
              旅程
            </a>
          </li>
        )
      }
    </ol>

    <!-- Under the placeholder the picture says the map is coming; the line waits for a slow load. -->
    <p class="trip-map-loading" data-trip-map-loading hidden={showPlaceholder}>{activeTripData ? '正在加载旅程地图…' : `正在加载 ${locationGroups.length} 个地点的地图…`}</p>

    <section class="trip-map-fallback" data-trip-map-fallback aria-live="polite" hidden>
      <p class="trip-map-fallback__message" data-trip-map-fallback-message>地图暂时无法加载。</p>
      <button class="trip-map-fallback__retry" type="button" data-trip-map-fallback-retry hidden>
        <span class="i-lucide-rotate-ccw" aria-hidden="true" />
        重新加载
      </button>
      <div class="trip-map-fallback__places">
        {
          locationGroups.map(group => (
            <a href={`/map/place/${encodeURIComponent(group.id)}/`} data-trip-map-place={group.id}>
              <span class="trip-map-year-dot" style={`--year-color: ${yearColor(group.firstYear)}`} aria-hidden="true" />
              <strong>{group.location.name}</strong>
              <small>{group.moments.length} 条</small>
            </a>
          ))
        }
      </div>
    </section>

    <!-- The player's parts are the package's: rendered here so a trip page opens on its intro card at once. -->
    <div class="trip-map-stage" data-trip-map-stage set:html={renderTripStage({ brand: tripMapBrand, messages: tripMapMessages })} />

    <section class="trip-map-panel" data-trip-map-panel aria-labelledby="trip-map-panel-title" hidden={!activeTripData} set:html={renderTripPanel({ messages: tripMapMessages, music: tripMapMusic, trip: activeTripData })} />

    <!-- The map's settings, remembered in this browser; each shows on the map behind at once. -->
    <dialog class="trip-map-side trip-map-settings" data-trip-map-settings aria-labelledby="trip-map-settings-title">
      <header class="trip-map-side__header">
        <div>
          <p>保存在此浏览器</p>
          <h1 id="trip-map-settings-title">地图设置</h1>
        </div>
        <button class="trip-map-side__close" type="button" data-trip-map-settings-close aria-label="关闭地图设置">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </header>
      <form class="trip-map-side__content trip-map-settings__form" data-drawer-content>
        <fieldset>
          <legend>样式</legend>
          <div class="trip-map-settings__choices">
            {mapStyles.map(style => (
              <label class="trip-map-settings__choice">
                <input class="sr-only" type="radio" name="style" value={style.id} />
                <span>{style.label}</span>
                <small>{style.hint}</small>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset data-trip-map-standard>
          <legend>光照</legend>
          <div class="trip-map-settings__chips">
            {mapLights.map(light => (
              <label class="trip-map-settings__choice">
                <input class="sr-only" type="radio" name="light" value={light.id} />
                <span>{light.label}</span>
              </label>
            ))}
          </div>
          <p class="trip-map-settings__note">经典样式没有这项设置</p>
        </fieldset>
        <fieldset data-trip-map-standard>
          <legend>显示</legend>
          {mapLayers.map(layer => (
            <label class="trip-map-settings__switch">
              <span>
                {layer.label}
                <small>{layer.hint}</small>
              </span>
              <input type="checkbox" role="switch" name={layer.id} />
            </label>
          ))}
          <p class="trip-map-settings__note">经典样式没有这些设置</p>
        </fieldset>
        <fieldset data-trip-map-standard>
          <legend>视角</legend>
          <label class="trip-map-settings__switch">
            <span>
              随缩放倾斜
              <small>看全国时平视，靠近街道时倾斜</small>
            </span>
            <input type="checkbox" role="switch" name="tilt" />
          </label>
          <p class="trip-map-settings__note">经典样式始终平视</p>
        </fieldset>
        <fieldset>
          <legend>投影</legend>
          <div class="trip-map-settings__choices">
            {mapProjections.map(projection => (
              <label class="trip-map-settings__choice">
                <input class="sr-only" type="radio" name="projection" value={projection.id} />
                <span>{projection.label}</span>
                <small>{projection.hint}</small>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>迷雾</legend>
          <!-- On, a light fog over the map, thinner over a city the more Moments it holds. -->
          <label class="trip-map-settings__switch">
            <span>
              迷雾地图
              <small>去过的城市拨开迷雾，记录越多越清晰</small>
            </span>
            <!-- Not restored by the browser on a reload: the fog says whether it's on. -->
            <input type="checkbox" role="switch" data-trip-map-fog autocomplete="off" />
          </label>
        </fieldset>
        <div class="trip-map-settings__actions">
          <button class="trip-map-settings__reset" type="button" data-trip-map-settings-reset>恢复默认</button>
          <button class="trip-map-settings__reset trip-map-screenshot" type="button" data-trip-map-screenshot disabled>
            <span class="i-lucide-camera" aria-hidden="true" />
            保存截图
          </button>
        </div>
      </form>
    </dialog>

    <dialog class="trip-map-shortcuts" data-trip-map-shortcuts aria-labelledby="trip-map-shortcuts-title" closedby="any" set:html={renderShortcuts(tripMapMessages)} />

    <!-- A year's Moments, or a month's, while the map is narrowed to it; before the drawer,
         which a place opens over it. -->
    <aside class="trip-map-side trip-map-moments" data-trip-map-moments aria-labelledby="trip-map-moments-title" hidden={!momentsPeriod}>
      <header class="trip-map-side__header">
        <div>
          <p data-trip-map-moments-eyebrow>{momentsPeriod && periodEyebrow}</p>
          <h1 id="trip-map-moments-title" data-trip-map-moments-title>{momentsPeriod && periodLabel}</h1>
        </div>
        <button class="trip-map-side__close" type="button" data-trip-map-moments-close aria-label="关闭记录，显示全部年份">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </header>
      <div class="trip-map-side__content" data-drawer-content data-trip-map-moments-content data-trip-map-moments-year={momentsPeriod?.year} data-trip-map-moments-month-only={momentsPeriod?.month}>
        {momentsPeriod && <MapMoments month={momentsPeriod.month} moments={periodMoments} year={momentsPeriod.year} />}
      </div>
    </aside>

    <aside class="trip-map-side trip-map-drawer" data-trip-map-drawer role="dialog" aria-labelledby="trip-map-drawer-title" hidden>
      <!-- Laid out like the trip card's header: a grey line of totals over the name. -->
      <header class="trip-map-side__header">
        <div>
          <p data-trip-map-drawer-eyebrow />
          <h1 id="trip-map-drawer-title" data-trip-map-drawer-title />
          <p data-trip-map-drawer-detail hidden />
        </div>
        <button class="trip-map-side__close" type="button" data-trip-map-drawer-close aria-label="关闭地点详情">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </header>
      <div class="trip-map-side__content trip-map-drawer__content" data-drawer-content data-trip-map-drawer-content />
    </aside>

    <!-- A trip opened from its row or its route: its Moments, and the button that plays it. -->
    <aside class="trip-map-side trip-map-trip-details" data-trip-map-trip-details aria-labelledby="trip-map-trip-details-title" hidden={!pickedTrip}>
      <header class="trip-map-side__header">
        <div>
          <p data-trip-map-trip-details-eyebrow>{pickedTrip && formatDateRange(pickedTrip.start, pickedTrip.end, 'zh-CN')}</p>
          <h1 id="trip-map-trip-details-title" data-trip-map-trip-details-title>{pickedTrip?.title}</h1>
        </div>
        <button class="trip-map-side__close" type="button" data-trip-map-trip-details-close aria-label="关闭旅程">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </header>
      <div class="trip-map-side__content" data-drawer-content data-trip-map-trip-details-content data-trip-map-trip-details-trip={pickedTrip?.id}>
        {pickedTrip && <TripDetails moments={moments} trip={pickedTrip} />}
      </div>
    </aside>

    {
      // Every trip beside the map by year, a card with its photos as the app has them:
      // resting on one a while lifts its route, and clicking it opens its sidebar.
      trips.length > 0 && (
        <aside class="trip-map-side trip-map-trip-list" id="trip-map-trip-list" data-trip-map-trip-list aria-labelledby="trip-map-trip-list-title" hidden={!tripList}>
          <header class="trip-map-side__header">
            <div>
              <p>{tripTotals}</p>
              <h1 id="trip-map-trip-list-title">旅程</h1>
            </div>
            <button class="trip-map-side__close" type="button" data-trip-map-trip-list-close aria-label="关闭旅程列表">
              <span class="i-lucide-x" aria-hidden="true" />
            </button>
          </header>
          <div class="trip-map-side__content trip-map-trip-list__content" data-drawer-content>
            {tripsByYear.map(([year, yearTrips]) => (
              <section aria-labelledby={`trip-map-trip-list-${year}`} data-trip-map-trip-year={year} hidden={!yearTrips.some(isInPeriod) && !(outingsByYear.get(year) ?? []).some(isInPeriod)}>
                <h2 class="trip-map-trip-list__year" id={`trip-map-trip-list-${year}`}>{year}</h2>
                <ul>
                  {yearTrips.map(trip => (
                    <li hidden={!isInPeriod(trip)}>
                      <a class="trip-map-trip-list__trip" href={`/trip/${trip.id}/`} data-trip-map-trip-link={trip.id}>
                        <TripCoverCollage images={getTripCollage(trip, moments)} sizes="(max-width: 48rem) 100vw, 26rem" />
                        <span class="trip-map-trip-list__text">
                          <span class="trip-map-trip-list__title">{trip.title}</span>
                          <span class="trip-map-trip-list__dates">{formatDateRange(trip.start, trip.end, 'zh-CN')}</span>
                          <span class="trip-map-trip-list__totals">
                            {trip.dayCount} 天&emsp;{trip.placeCount} 个地点{trip.drivingKm > 0 && `\u2003自驾 ${trip.drivingKm.toLocaleString('zh-CN')} 公里`}
                          </span>
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
                {(outingsByYear.get(year) ?? []).length > 0 && (
                  <div class="trip-map-trip-list__outings" data-trip-map-dates-group hidden={!(outingsByYear.get(year) ?? []).some(isInPeriod)}>
                    <h3>没写成旅程的出行</h3>
                    <ul>
                      {outingsByYear.get(year)!.map(outing => {
                        const where = outing.cities.length > 0 ? outing.cities.join('、') : '没有记录'
                        // Its first day with Moments, in the calendar; none, and the row links nowhere.
                        const day = [...activeDates].sort().find(date => outing.start <= date && date <= outing.end)
                        const text = (
                          <>
                            <span class:list={['trip-map-trip-list__outing-where', { 'is-unknown': outing.cities.length === 0 }]}>{where}</span>
                            <span class="trip-map-trip-list__outing-meta">{outing.start === outing.end ? formatDate(outing.start, 'zh-CN') : formatDateRange(outing.start, outing.end, 'zh-CN')}&emsp;{formatKilometers(outing.distanceMeters)}</span>
                          </>
                        )
                        return (
                          <li data-trip-map-dates={`${outing.start}/${outing.end}`} hidden={!isInPeriod(outing)}>
                            {day ? <a class="trip-map-trip-list__outing" href={getMomentPath(day)}>{text}</a> : <span class="trip-map-trip-list__outing">{text}</span>}
                          </li>
                        )
                      })}
                    </ul>
                  </div>
                )}
              </section>
            ))}
          </div>
        </aside>
      )
    }

    <dialog class="trip-map-lightbox" data-trip-map-lightbox aria-label="图片查看器">
      <button type="button" class="trip-map-lightbox__close" data-trip-map-lightbox-close aria-label="关闭图片">
        <span class="i-lucide-x" aria-hidden="true" />
      </button>
      <button type="button" class="trip-map-lightbox__previous" data-trip-map-lightbox-previous aria-label="上一张图片">
        <span class="i-lucide-chevron-left" aria-hidden="true" />
      </button>
      <MomentLightboxMedia />
      <button type="button" class="trip-map-lightbox__next" data-trip-map-lightbox-next aria-label="下一张图片">
        <span class="i-lucide-chevron-right" aria-hidden="true" />
      </button>
    </dialog>

    <script is:inline type="application/json" data-trip-map-places set:html={placesJson} />
    <script is:inline type="application/json" data-trip-map-stats set:html={statsJson} />
    {activeTripJson && <script is:inline type="application/json" data-trip-map-trip set:html={activeTripJson} />}
    {
      placeholderView && (
        // Scales the picture to the view the map opens on, worked out as the map does
        // (getAllPlacesCamera in @hyoban/trip-map): the places framed clear of the toolbar,
        // the legend and the sidebar open, all laid out by now.
        <script is:inline define:vars={{ view: placeholderView }}>
          {
            const page = document.querySelector('[data-trip-map]')
            const picture = page.querySelector('[data-trip-map-placeholder]')
            const image = picture.querySelector('img')
            const box = picture.getBoundingClientRect()
            const narrow = matchMedia('(max-width: 48rem)').matches
            const legend = page.querySelector('[data-trip-map-legend]')?.getBoundingClientRect()
            const list = [...page.querySelectorAll('[data-trip-map-trip-list], [data-trip-map-trip-details], [data-trip-map-moments]')]
              .find(element => !element.hidden)
            let inset = list ? (narrow ? { bottom: list.offsetHeight + 12 } : { right: list.offsetWidth + 16 }) : {}

            // Nothing if what the list leaves is too small to frame anything in.
            if (Math.min(box.width - (inset.right ?? 0), box.height - (inset.bottom ?? 0)) < 240) inset = {}

            const side = narrow ? 20 : 56
            const padding = {
              bottom: inset.bottom === undefined ? Math.max(80, legend?.height ? box.bottom - legend.top + 28 : 0) : 80 + inset.bottom,
              left: side,
              right: side + (inset.right ?? 0),
              top: 88,
            }
            const { maxX, maxY, minX, minY } = view.extent
            const zoom = Math.min(
              view.maxZoom,
              Math.log2((box.width - padding.left - padding.right) / (512 * Math.max(maxX - minX, 1e-9))),
              Math.log2((box.height - padding.top - padding.bottom) / (512 * Math.max(maxY - minY, 1e-9))),
            )
            const world = 512 * 2 ** zoom
            const size = view.size * 2 ** (zoom - view.camera.zoom)
            const x = (minX + maxX) / 2 + (padding.right - padding.left) / 2 / world
            const y = (minY + maxY) / 2 + (padding.bottom - padding.top) / 2 / world

            image.style.cssText = `width: ${size}px; height: ${size}px; left: ${box.width / 2 + (view.center.x - x) * world - size / 2}px; top: ${box.height / 2 + (view.center.y - y) * world - size / 2}px`
            picture.dataset.tripMapPlaced = ''
          }
        </script>
      )
    }
  </main>
</Layout>

<script>
  import { SITE_TITLE } from '@/consts'
  import { initializeLightboxMedia } from '@/moment-lightbox-client'
  // The place drawers' Moments, and a year's, are fetched fragments, which bring no
  // script of their own.
  import '@/moment-entry-client'
  import {
    getDocumentTitle,
    getMapHeading,
    getTripListHeading,
    getTripTitle,
    tripMapBrand,
    tripMapMessages,
    tripMapMusic,
    tripMapSiteLine,
  } from '@/trip-map'

  type MapClient = typeof import('@hyoban/trip-map/client')
  type TripMap = ReturnType<MapClient['createTripMap']>
  type TripSummary = import('@hyoban/trip-map/client').TripSummary

  let mapClient: Promise<MapClient> | undefined
  let map: TripMap | undefined
  // The trips' routes by their file's address, which names its content: fetched once.
  const tripSummaries = new Map<string, Promise<TripSummary[]>>()

  function getTripSummaries(url: string) {
    let request = tripSummaries.get(url)

    if (!request) {
      request = fetch(url)
        .then((response) => {
          if (!response.ok) {
            throw new Error(`${response.status} ${response.statusText}`)
          }

          return response.json() as Promise<TripSummary[]>
        })
        .catch((error: unknown) => {
          // The map goes on without its routes, and the next page tries again.
          tripSummaries.delete(url)
          console.warn('[trip-map] trips', error)
          return []
        })
      tripSummaries.set(url, request)
    }

    return request
  }

  // The pages the browser's bar is kept the colour of, as the map sets them dark or light.
  const schemedPages = new WeakSet<HTMLElement>()

  /** Gives the browser's bar the colour of the page, dark or light by the map's clock. */
  function syncThemeColor(page: HTMLElement) {
    const scheme = page.dataset.tripMapScheme

    for (const meta of document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')) {
      meta.dataset.media ??= meta.media

      const dark = meta.dataset.media.includes('dark')

      meta.media = scheme ? (dark === (scheme === 'dark') ? 'all' : 'not all') : meta.dataset.media
    }
  }

  document.addEventListener('astro:page-load', () => {
    const page = document.querySelector<HTMLElement>('[data-trip-map]')

    // The map persists across the map and trip pages; a page without one only needs
    // the one left behind taken down.
    if (!page) {
      map?.destroy()
      map = undefined
      return
    }

    // The head is the new page's, with the bar's colours by the colour scheme again.
    syncThemeColor(page)

    if (!schemedPages.has(page)) {
      schemedPages.add(page)
      new MutationObserver(() => syncThemeColor(page)).observe(page, {
        attributeFilter: ['data-trip-map-scheme'],
      })
    }

    // Closing a place through history fires page-load for the same persisted map.
    if (map?.page === page) {
      return
    }

    // The routes come while the map script does.
    const trips = getTripSummaries(page.dataset.tripMapTripsUrl ?? '')

    // The map script is large and runs long: let the page paint first, so its
    // toolbar and a trip's intro card show while the map loads.
    requestAnimationFrame(() => {
      setTimeout(() => {
        mapClient ??= import('@hyoban/trip-map/client')
        void Promise.all([mapClient, trips]).then(([client, trips]) => {
          if (!page.isConnected || map?.page === page) {
            return
          }

          map?.destroy()
          map = client.createTripMap({
            brand: tripMapBrand,
            createLightboxMedia: initializeLightboxMedia,
            documentTitle: getDocumentTitle(getMapHeading()),
            getDocumentTitle: (trip) => getTripTitle(trip.title, trip.playing),
            getPeriodTitle: (period) => getDocumentTitle(getMapHeading(period)),
            messages: tripMapMessages,
            music: tripMapMusic,
            onError: (error) => console.warn('[trip-map]', error.message, error.cause ?? ''),
            // The calendar link goes to the month the map is narrowed to, or the year's latest.
            onPeriodChange: (period) => {
              const link = page.querySelector<HTMLAnchorElement>('[data-calendar-mode-switch] a[data-mode="calendar"]')
              const months = JSON.parse(page.dataset.calendarLatestMonths ?? '{}') as Record<string, string>
              const monthKey = period?.month === undefined
                ? period && months[period.year]
                : `${period.year}-${String(period.month).padStart(2, '0')}`

              link?.setAttribute('href', monthKey ? `/calendar/${monthKey.replace('-', '/')}/` : '/calendar/')
            },
            page,
            screenshotTitle: `${SITE_TITLE} 的足迹`,
            siteLine: tripMapSiteLine,
            tripListTitle: (period) => getDocumentTitle(getTripListHeading(period)),
            trips,
          })
        })
      })
    })
  })

  // The map's own addresses: the map, a year or a month of it, a place on it, the trip
  // list with a trip picked or not, and a trip playing, from a card of it or not (a
  // trip by its id or by its year and the rest).
  const ownPathPattern = /^\/(?:map(?:\/\d{4}(?:\/\d{2})?)?(?:\/place\/[^/]+)?|trip(?:(?:\/\d{4})?\/[^/]+(?:\/play(?:\/[^/]+)?)?)?)\/$/
  // Set while the router goes back or forward between them.
  let ownTraversal = false

  // Back and forward between the map's own addresses are the map's to follow, as it
  // listens for popstate itself. The router takes them for a new page: it would fetch
  // the page again and crossfade it in, over the drawer as it slides away. It is left
  // nothing to load and nothing to swap, and no transition to show.
  document.addEventListener('astro:before-preparation', (event) => {
    const { from, navigationType, to } = event

    ownTraversal = navigationType === 'traverse'
      && Boolean(map?.page.isConnected)
      && from.search === to.search
      && ownPathPattern.test(from.pathname)
      && ownPathPattern.test(to.pathname)

    if (ownTraversal) {
      event.loader = async () => {}
    }
  })

  // Leaving the map for another page takes the map down before the swap; a change of
  // hash or trip on the same map keeps it.
  document.addEventListener('astro:before-swap', (event) => {
    const { from, to } = event

    if (ownTraversal) {
      ownTraversal = false
      // Skipped on purpose: its promises rejecting for it is no error.
      for (const promise of [event.viewTransition.ready, event.viewTransition.finished, event.viewTransition.updateCallbackDone]) {
        promise.catch(() => {})
      }
      event.viewTransition.skipTransition()
      event.swap = () => {}
      return
    }

    if (from.pathname === to.pathname && from.search === to.search) {
      return
    }

    map?.destroy()
    map = undefined
  })
</script>

<style>
  /* The page's own parts around the map; what the map client and the player put on the
     page is the package's to style (@hyoban/trip-map/styles.css), which also moves some
     of these aside while a sidebar is open or a trip plays. */
  .trip-map-page {
    /* The glass over the map is all but solid, with no blur: the map under it changes
       every frame it moves, and blurring it again each time costs the GPU more than
       the controls are worth. */
    --color-glass: color-mix(in srgb, var(--color-bg) 92%, transparent);

    position: relative;
    isolation: isolate;
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    background: var(--color-bg);
    container-type: inline-size;

    & :global(:is(.calendar-back-link, .calendar-mode-switch)) {
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  /* Unseen until placed: a long page paints before the script at its end has run, and
     the picture would jump from filling the map to the view it stands for. */
  @media (scripting: enabled) {
    .trip-map-placeholder:not([data-trip-map-placed]) img {
      visibility: hidden;
    }
  }

  /* The back link, the trips by keyboard, and the map's buttons, across the top. */
  .trip-map-toolbar {
    position: absolute;
    top: calc(1rem + env(safe-area-inset-top));
    right: calc(1rem + env(safe-area-inset-right));
    left: calc(1rem + env(safe-area-inset-left));
    z-index: 5;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    pointer-events: none;

    & > :global(*) {
      pointer-events: auto;
    }

    & .calendar-back-link {
      justify-self: start;
    }

    /* On a narrow screen, or beside a sidebar on a middling one, the back link is just
       the avatar. */
    @media (width < 48rem) {
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.5rem;

      & .calendar-back-link {
        padding-right: 0.375rem;
      }
    }
  }

  @media (width < 48rem) {
    .trip-map-toolbar :global(.calendar-back-link > span) {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  @media (width >= 48.0625rem) and (width < 56rem) {
    .trip-map-page:has(:is(.trip-map-drawer, .trip-map-trip-list, .trip-map-moments, .trip-map-trip-details):not([hidden], [data-closed]))
      .trip-map-toolbar
      :global(.calendar-back-link > span) {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  /* Kept for screen readers until one of its links has focus. */
  .trip-map-toolbar__trips {
    justify-self: center;
    min-width: 0;

    &:not(:focus-within) {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    & ul {
      display: flex;
      gap: 0.125rem;
      max-width: 100%;
      overflow-x: auto;
      padding: 0.25rem;
      border: 1px solid var(--color-glass-border);
      border-radius: 9999px;
      background: var(--color-glass);
      box-shadow: 0 0.5rem 2rem rgb(0 0 0 / 0.08);
      scrollbar-width: none;
    }

    & li {
      flex-shrink: 0;
    }

    & a {
      display: block;
      padding: 0.375rem 0.75rem;
      border-radius: 9999px;
      color: var(--color-tx-2);
      font-size: 0.875rem;
      line-height: 1.25rem;
      white-space: nowrap;
      text-decoration: none;

      &:focus-visible {
        background: var(--color-inline);
        color: var(--color-tx);
      }

      @media (hover: hover) {
        &:hover {
          background: var(--color-inline);
          color: var(--color-tx);
        }
      }
    }
  }

  .trip-map-toolbar__actions {
    display: flex;
    grid-column-start: 3;
    align-items: center;
    justify-self: end;
    gap: 0.5rem;
  }

  /* A round button on the glass, like the back link. */
  .trip-map-tool {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-glass-border);
    border-radius: 9999px;
    background: var(--color-glass);
    color: var(--color-tx-2);
    cursor: pointer;

    @media (hover: hover) {
      &:hover {
        color: var(--color-tx);
      }
    }

    &[aria-pressed='true'] {
      border-color: var(--color-tx);
      background: var(--color-tx);
      color: var(--color-bg);
    }

    &:disabled {
      cursor: default;
      opacity: 0.4;
    }

    &[aria-busy='true'] {
      cursor: progress;
    }

    & span {
      font-size: 0.9375rem;
    }
  }

  /* The years the places are colored by, along the foot of the map. */
  .trip-map-legend {
    position: absolute;
    bottom: calc(2.5rem + env(safe-area-inset-bottom));
    left: 50%;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-glass-border);
    border-radius: 9999px;
    background: var(--color-glass);
    box-shadow: 0 0.5rem 2rem rgb(0 0 0 / 0.08);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1rem;
    translate: -50% 0;

    /* On a phone, in the row of the map's logo, at its right end (the attribution's ⓘ goes
       to the top), in line with the sheets' edge, its years a little closer to fit there;
       above the logo where it doesn't (placeLegend in @hyoban/trip-map). */
    @media (width < 48rem) {
      right: 0.75rem;
      bottom: calc(0.5rem + env(safe-area-inset-bottom));
      left: auto;
      gap: 0.5rem;
      translate: none;

      &[data-trip-map-legend-raised] {
        bottom: calc(2.25rem + env(safe-area-inset-bottom));
      }
    }

    & > li {
      display: flex;
      align-items: center;
    }
  }

  .trip-map-legend__year {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: inherit;
    text-decoration: none;

    @media (hover: hover) {
      &:hover {
        color: var(--color-tx-2);
      }
    }
  }

  /* On a phone a year is its last two digits, ’24, so the legend fits beside the map's
     logo; its button keeps the whole year for its name. */
  @media (width < 48rem) {
    .trip-map-legend__century {
      display: none;
    }

    .trip-map-legend__label::before {
      content: '’';
    }
  }

  .trip-map-legend__clear {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border-radius: 9999px;
    color: var(--color-tx-2);
    cursor: pointer;

    @media (hover: hover) {
      &:hover {
        color: var(--color-tx);
      }
    }

    & span {
      font-size: 0.75rem;
    }
  }

  .trip-map-legend__fog-area {
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-border);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .trip-map-legend__trips {
    padding-left: 0.75rem;
    border-left: 1px solid var(--color-border);

    & a {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      color: inherit;
      white-space: nowrap;
      text-decoration: none;

      @media (hover: hover) {
        &:hover {
          color: var(--color-tx-2);
        }
      }
    }

    /* A short grey line, like the routes on the map. */
    & span {
      display: block;
      width: 0.875rem;
      height: 0.125rem;
      border-radius: 9999px;
      background: var(--color-tx);
      opacity: 0.5;
    }
  }

  /* A place's or a year's dot, in the year's color. */
  .trip-map-year-dot {
    display: block;
    width: 0.625rem;
    height: 0.625rem;
    border: 1px solid rgb(255 255 255 / 0.9);
    border-radius: 9999px;
    background: var(--year-color);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  .trip-map-loading {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    translate: -50% -50%;
  }

  /* The places as a list, when the map can't load. */
  .trip-map-fallback {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 6;
    width: min(28rem, calc(100vw - 2rem));
    max-height: min(36rem, calc(100dvh - 8rem));
    overflow-y: auto;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    box-shadow: 0 1rem 4rem rgb(0 0 0 / 0.12);
    translate: -50% -50%;
  }

  .trip-map-fallback__message {
    margin-bottom: 1rem;
    color: var(--color-tx-2);
    line-height: 1.6;
  }

  .trip-map-fallback__retry {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    margin: -0.5rem 0 1rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    color: var(--color-tx);
    font-size: 0.8125rem;
    cursor: pointer;

    @media (hover: hover) {
      &:hover {
        background: var(--color-inline);
      }
    }
  }

  .trip-map-fallback__places {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem;

    & a {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding-inline: 0.5rem;
      border-radius: 0.375rem;
      color: var(--color-tx);
      text-align: left;
      text-decoration: none;

      &:focus-visible {
        background: var(--color-inline);
      }

      @media (hover: hover) {
        &:hover {
          background: var(--color-inline);
        }
      }
    }

    & strong {
      overflow: hidden;
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
