---
import CalendarBackLink from '@/components/CalendarBackLink.astro'
import CalendarModeSwitch from '@/components/CalendarModeSwitch.astro'
import MomentEntry from '@/components/MomentEntry.astro'
import MomentLightboxMedia from '@/components/MomentLightboxMedia.astro'
import Layout from '@/layouts/Layout.astro'
import { getYearColor } from '@/moments/map-locations'
import {
  getMappedLocationGroups,
  getMomentPath,
  getMoments,
  getTrips,
  type ResolvedMomentMedia,
} from '@/moments'
import { getDayOffset, type TripWaypoint } from '@/moments/trips'
import { getAssetUrl } from '@/asset-url'
import { tripVideoMusic } from '@/data/music'
import { SITE_TITLE } from '@/consts'

interface Props {
  /** Starts playing this trip when the page loads (the /trip/<id>/ pages). */
  tripId?: string
}

const { tripId } = Astro.props
const moments = await getMoments()
const locationGroups = getMappedLocationGroups(moments)
const years = [...new Set(locationGroups.map(group => group.latestYear))].sort((a, b) => a - b)
const mapboxToken = import.meta.env.VITE_MAPBOX_TOKEN ?? ''
const mapTitle = `地图 · 日历 | ${SITE_TITLE}`
const markerData = locationGroups.map(group => ({
  color: getYearColor(group.latestYear),
  count: group.moments.length,
  id: group.id,
  latestYear: group.latestYear,
  latitude: group.location.latitude,
  longitude: group.location.longitude,
  name: group.location.name,
}))
const markerDataJson = JSON.stringify(markerData).replaceAll('<', '\\u003c')
const trips = getTrips(moments).toReversed()
const tripData = trips.map(trip => ({
  dateRange: `${formatShortDate(trip.start)} – ${formatShortDate(trip.end)}`,
  dayCount: trip.dayCount,
  distanceKm: trip.distanceKm,
  id: trip.id,
  pageTitle: getTripTitle(trip.title),
  photoCount: trip.stops.reduce((count, stop) => count + stop.media.length, 0),
  placeCount: trip.placeCount,
  covers: getTripCovers(trip),
  stops: trip.stops.map(stop => ({
    date: formatShortDate(stop.dateKey, true),
    day: getDayOffset(trip.start, stop.dateKey) + 1,
    href: getMomentPath(stop.dateKey),
    images: getImages(stop.media),
    name: stop.locations.map(location => location.name).join('、'),
    places: stop.locations.map(toTripPlace),
    text: getPlainText(stop.text),
    time: stop.occurredLabel,
    waypoints: stop.waypoints.map(waypoint => toTripWaypoint(trip.start, waypoint)),
  })),
  title: trip.title,
  trailingWaypoints: trip.trailingWaypoints.map(waypoint => toTripWaypoint(trip.start, waypoint)),
  // Road geometry from one place to the next; null means draw it straight.
  legs: trip.legs.map(leg => leg.route?.coordinates ?? null),
}))
const tripDataJson = JSON.stringify(tripData).replaceAll('<', '\\u003c')
const activeTrip = trips.find(trip => trip.id === tripId)
const title = activeTrip ? getTripTitle(activeTrip.title) : mapTitle
const description = activeTrip
  ? `${activeTrip.title}的旅程回放，按时间顺序走过每一条 Moment。`
  : '按地点浏览 Calendar 中记录的 Moment。'

function toTripPlace(location: { latitude: number; longitude: number; name: string }) {
  return { latitude: location.latitude, longitude: location.longitude, name: location.name }
}

function toTripWaypoint(start: string, waypoint: TripWaypoint) {
  return {
    ...toTripPlace(waypoint.location),
    date: formatShortDate(waypoint.dateKey, true),
    day: getDayOffset(start, waypoint.dateKey) + 1,
    time: waypoint.time,
  }
}

function getTripTitle(tripTitle: string) {
  return `${tripTitle} · 旅程 | ${SITE_TITLE}`
}

function formatShortDate(dateKey: string, weekday = false) {
  return new Intl.DateTimeFormat('zh-CN', {
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
    ...(weekday ? { weekday: 'short' as const } : {}),
  }).format(new Date(`${dateKey}T00:00:00Z`))
}

function getPlainText(text: string) {
  return text
    .split('\n')
    .map(line => line
      .replaceAll(/\[([^\]]*)\]\([^)]*\)/g, '$1')
      .replaceAll(/^[#>\s-]+|[*_`]/g, '')
      .trim())
    .filter(Boolean)
    .join('\n')
}

/** Resolves a trip's chosen cover photos; a typo fails the build instead of dropping a photo. */
function getTripCovers(trip: (typeof trips)[number]) {
  return (trip.covers ?? []).map(cover => {
    const slash = cover.lastIndexOf('/')
    const id = cover.slice(0, slash)
    const file = cover.slice(slash + 1)
    const item = trip.stops
      .find(stop => stop.id === id)
      ?.media.find(media => (media.type === 'video' ? media.poster : media.src)?.src.endsWith(`/${file}`))
    const [image] = item ? getImages([item]) : []

    if (!image) {
      throw new Error(`Cover "${cover}" isn't a photo of a Moment in trip "${trip.id}".`)
    }

    return image
  })
}

function getImages(media: ResolvedMomentMedia[]) {
  return media.flatMap((item) => {
    const image = item.type === 'video' ? item.poster : item.src

    if (!image) {
      return []
    }

    return [{
      alt: item.alt,
      height: image.height,
      src: image.sources.find(source => source.width >= 960)?.src ?? image.sources.at(-1)?.src ?? image.src,
      srcset: image.sources.map(source => `${source.src} ${source.width}w`).join(', '),
      thumbnail: image.sources[0]?.src ?? image.src,
      width: image.width,
    }]
  })
}

function formatDate(dateKey: string) {
  const date = new Date(`${dateKey}T00:00:00Z`)
  return new Intl.DateTimeFormat('zh-CN', {
    day: 'numeric',
    month: 'long',
    timeZone: 'UTC',
    weekday: 'short',
    year: 'numeric',
  }).format(date)
}
---

<Layout title={title} description={description}>
  <main class="calendar-map-page @container relative isolate h-dvh w-full overflow-hidden bg-bg" data-calendar-map data-mapbox-token={mapboxToken} data-map-title={mapTitle} transition:persist="calendar-map">
    <div class="calendar-map-canvas absolute inset-0" data-calendar-map-canvas role="region" aria-label="Calendar 地点地图" />

    <header class="calendar-map-toolbar pointer-events-none absolute inset-x-4 top-4 z-[5] grid grid-cols-[1fr_auto_1fr] items-center gap-4 max-[48rem]:grid-cols-[auto_minmax(0,1fr)_auto] max-[48rem]:gap-2 [&>*]:pointer-events-auto max-[48rem]:[&_.calendar-back-link]:pr-1.5 max-[48rem]:[&_.calendar-back-link>span]:sr-only">
      <CalendarBackLink class="justify-self-start" />
      {
        trips.length > 0
          ? (
              <label class="calendar-map-trip-picker relative col-start-2 flex items-center rounded-full border border-[color-mix(in_srgb,var(--color-border)_82%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] font-mono text-[0.8125rem] backdrop-blur-[1rem] hover:bg-inline min-w-0 justify-self-center max-[48rem]:max-w-full">
                <span class="sr-only">选择要回放的旅程</span>
                <select class="min-h-[2.375rem] w-full max-w-[14rem] min-w-0 cursor-pointer appearance-none truncate rounded-full border-0 bg-transparent pr-8 pl-3.5 text-tx outline-offset-2" data-calendar-map-trip-select>
                  <option value="">全部地点</option>
                  <optgroup label="旅程回放">
                    {trips.map(trip => <option value={trip.id} selected={trip.id === tripId}>{trip.title}</option>)}
                  </optgroup>
                </select>
                <span class="i-lucide-chevrons-up-down pointer-events-none absolute right-3 text-tx-3" aria-hidden="true" />
              </label>
            )
          : (
              <p class="col-start-2 flex min-h-[2.375rem] items-center rounded-full border border-[color-mix(in_srgb,var(--color-border)_82%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] px-3.5 font-mono text-[0.8125rem] backdrop-blur-[1rem] max-[48rem]:hidden">全部地点</p>
            )
      }
      <CalendarModeSwitch class="col-start-3 justify-self-end" mode="map" />
    </header>

    <ol class="calendar-map-legend [&[hidden]]:hidden absolute bottom-10 left-1/2 z-[4] flex -translate-x-1/2 list-none items-center gap-3 rounded-full border border-[color-mix(in_srgb,var(--color-border)_82%,transparent)] bg-[color-mix(in_srgb,var(--color-bg)_82%,transparent)] px-3.5 py-2.5 font-mono text-xs shadow-[0_0.5rem_2rem_rgb(0_0_0/0.08)] max-[48rem]:bottom-[calc(1rem+env(safe-area-inset-bottom))]" aria-label="地点最近记录年份" data-calendar-map-legend>
      {
        years.map(year => (
          <li class="flex items-center gap-[0.35rem]">
            <span class="block size-2.5 rounded-full border border-white/90 bg-[var(--year-color)] shadow-[0_0_0_1px_rgb(0_0_0/0.12)]" style={`--year-color: ${getYearColor(year)}`} aria-hidden="true" />
            {year}
          </li>
        ))
      }
    </ol>

    <p class="calendar-map-loading absolute left-1/2 top-1/2 z-[3] -translate-1/2 rounded-full border border-border bg-[color-mix(in_srgb,var(--color-bg)_88%,transparent)] px-3.5 py-2.5 [&[hidden]]:hidden" data-calendar-map-loading>正在加载地图…</p>

    <section class="calendar-map-fallback absolute left-1/2 top-1/2 z-[6] max-h-[min(36rem,calc(100dvh-8rem))] w-[min(28rem,calc(100vw-2rem))] -translate-1/2 overflow-y-auto rounded-xl border border-border bg-[color-mix(in_srgb,var(--color-bg)_94%,transparent)] p-5 shadow-[0_1rem_4rem_rgb(0_0_0/0.12)] [&[hidden]]:hidden" data-calendar-map-fallback aria-live="polite" hidden>
      <p class="mb-4 leading-[1.6] text-tx-2" data-calendar-map-fallback-message>地图暂时无法加载，仍可通过地点列表浏览记录。</p>
      <div class="grid grid-cols-2 gap-1">
        {
          locationGroups.map(group => (
            <button class="grid min-h-11 cursor-pointer grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2 rounded-md border-0 bg-transparent px-2 text-left text-tx hover:bg-inline focus-visible:bg-inline" type="button" data-map-location-id={group.id}>
              <span class="block size-2.5 rounded-full border border-white/90 bg-[var(--year-color)] shadow-[0_0_0_1px_rgb(0_0_0/0.12)]" style={`--year-color: ${getYearColor(group.latestYear)}`} aria-hidden="true" />
              <strong class="truncate font-medium">{group.location.name}</strong>
              <small class="text-tx-3">{group.moments.length} 条</small>
            </button>
          ))
        }
      </div>
    </section>

    <div class="calendar-map-trip-stage" data-calendar-map-trip-stage>
      <header class="calendar-map-trip-stage__header">
        <p class="calendar-map-trip-stage__eyebrow" data-calendar-map-trip-stage-eyebrow />
        <p class="calendar-map-trip-stage__title" data-calendar-map-trip-stage-title />
      </header>
      <p class="calendar-map-trip-stage__brand">
        <img src={getAssetUrl('site/avatar-cropped.png')} alt="" width="24" height="24" />
        {SITE_TITLE}
      </p>
      <div class="calendar-map-trip-stage__photos" data-calendar-map-trip-stage-photos />
      <div class="calendar-map-trip-stage__center" data-calendar-map-trip-stage-center />
      <div class="calendar-map-trip-stage__progress" data-calendar-map-trip-stage-progress />
      <button class="calendar-map-trip-stage__close" type="button" data-calendar-map-trip-stage-close aria-label="退出放映">
        <span class="i-lucide-x" aria-hidden="true" />
      </button>
    </div>

    <section class="calendar-map-trip absolute bottom-4 left-4 z-10 flex max-h-[calc(100%-7rem)] w-[min(22rem,calc(100%-2rem))] flex-col overflow-hidden rounded-xl border border-border bg-bg shadow-[0_1.5rem_5rem_rgb(0_0_0/0.16)] @max-[48rem]:inset-x-3 @max-[48rem]:bottom-[calc(0.75rem+env(safe-area-inset-bottom))] @max-[48rem]:max-h-[calc(100%-1.5rem)] @max-[48rem]:w-auto [&[hidden]]:hidden" data-calendar-map-trip aria-labelledby="calendar-map-trip-title" hidden>
      <ol class="flex shrink-0 list-none gap-1 px-4 pt-3" data-calendar-map-trip-progress aria-label="旅程进度" />
      <header class="shrink-0 px-4 pt-3" data-calendar-map-trip-header>
        <p class="truncate text-xs text-tx-3 tabular-nums" data-calendar-map-trip-eyebrow />
        <h2 class="truncate text-lg font-medium" id="calendar-map-trip-title" data-calendar-map-trip-title />
      </header>
      <div class="flex min-h-0 flex-col px-4 pt-1 pb-3 @max-[48rem]:overflow-y-auto @max-[48rem]:overscroll-contain" data-calendar-map-trip-body aria-live="polite" />
      <footer class="flex shrink-0 items-center justify-between border-t border-border px-2 py-1">
        <div class="flex items-center [&[hidden]]:hidden" data-calendar-map-trip-controls>
          <button class="flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx disabled:cursor-default disabled:opacity-40 disabled:hover:bg-transparent" type="button" data-calendar-map-trip-previous aria-label="上一站">
            <span class="i-lucide-chevron-left" aria-hidden="true" />
          </button>
          <button class="flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx" type="button" data-calendar-map-trip-play aria-label="暂停">
            <span class="i-lucide-pause" aria-hidden="true" />
          </button>
          <button class="flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx disabled:cursor-default disabled:opacity-40 disabled:hover:bg-transparent" type="button" data-calendar-map-trip-next aria-label="下一站">
            <span class="i-lucide-chevron-right" aria-hidden="true" />
          </button>
        </div>
        <div class="flex items-center [&[hidden]]:hidden" data-calendar-map-trip-actions>
          <button class="flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx aria-pressed:text-tx" type="button" data-calendar-map-trip-music aria-label="背景音乐" aria-pressed="false">
            <span class="i-lucide-volume-x" aria-hidden="true" />
          </button>
          <button class="flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx" type="button" data-calendar-map-trip-present aria-label="放映">
            <span class="i-lucide-tv" aria-hidden="true" />
          </button>
          <button class="flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx [&[hidden]]:hidden" type="button" data-calendar-map-trip-export aria-label="导出视频" hidden>
            <span class="i-lucide-clapperboard" aria-hidden="true" />
          </button>
          <button class="flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx" type="button" data-calendar-map-trip-close aria-label="退出旅程回放">
            <span class="i-lucide-x" aria-hidden="true" />
          </button>
        </div>
        <div class="flex w-full items-center gap-1 [&[hidden]]:hidden" data-calendar-map-trip-export-options role="group" aria-label="导出视频" hidden>
          <label class="relative flex min-w-0 items-center">
            <span class="sr-only">背景音乐</span>
            <span class="i-lucide-music pointer-events-none absolute left-2.5 text-xs text-tx-3" aria-hidden="true" />
            <select class="min-h-9 max-w-[7.5rem] min-w-0 cursor-pointer appearance-none truncate rounded-full border border-border bg-transparent pr-3 pl-7 text-xs text-tx hover:bg-inline" data-calendar-map-trip-export-music>
              {tripVideoMusic.map(track => <option value={track.src}>{track.title}</option>)}
              <option value="">无音乐</option>
            </select>
          </label>
          <button class="min-h-9 cursor-pointer rounded-full border border-border bg-transparent px-2.5 text-xs whitespace-nowrap text-tx hover:bg-inline" type="button" data-calendar-map-trip-export-ratio="portrait">竖屏 9:16</button>
          <button class="min-h-9 cursor-pointer rounded-full border border-border bg-transparent px-2.5 text-xs whitespace-nowrap text-tx hover:bg-inline" type="button" data-calendar-map-trip-export-ratio="landscape">横屏 16:9</button>
          <button class="flex size-9 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-tx-2 hover:bg-inline hover:text-tx ml-auto" type="button" data-calendar-map-trip-export-cancel aria-label="取消导出">
            <span class="i-lucide-x" aria-hidden="true" />
          </button>
        </div>
      </footer>
    </section>

    <aside class="calendar-map-drawer absolute inset-y-4 right-4 z-10 grid w-[min(28rem,calc(100vw-2rem))] min-w-0 grid-rows-[auto_minmax(0,1fr)] overflow-hidden rounded-xl border border-border bg-bg shadow-[0_1.5rem_5rem_rgb(0_0_0/0.16)] max-[48rem]:inset-x-3 max-[48rem]:bottom-[calc(0.75rem+env(safe-area-inset-bottom))] max-[48rem]:top-auto max-[48rem]:h-[min(78dvh,42rem)] max-[48rem]:w-auto [&[hidden]]:hidden" data-calendar-map-drawer role="dialog" aria-labelledby="calendar-map-drawer-title" hidden>
      <header class="flex items-center justify-between border-b border-border px-5 py-4">
        <div class="min-w-0">
          <p class="mb-0.5 font-mono text-[0.6875rem] uppercase text-tx-3">地点</p>
          <h1 class="text-lg font-medium" id="calendar-map-drawer-title" data-calendar-map-drawer-title />
        </div>
        <button class="flex size-11 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent text-inherit hover:bg-inline" type="button" data-calendar-map-drawer-close aria-label="关闭地点详情">
          <span class="i-lucide-x" aria-hidden="true" />
        </button>
      </header>
      <div class="calendar-map-drawer__content min-w-0 overflow-y-auto overscroll-contain px-5 pb-4" data-calendar-map-drawer-content />
    </aside>

    {
      locationGroups.map(group => {
        const groupYears = [...new Set(group.moments.map(moment => Number.parseInt(moment.dateKey.slice(0, 4), 10)))]
          .sort((a, b) => b - a)

        return (
          <template data-calendar-map-template={group.id}>
            <div class="calendar-map-drawer__summary flex items-center gap-1.5 pt-4 pb-1 font-mono text-xs text-tx-3">
              <span>{group.moments.length} 条记录</span>
              <span aria-hidden="true">·</span>
              <span>{groupYears.map(year => `${year} 年`).join('、')}</span>
            </div>
            <div class="calendar-map-drawer__moments min-w-0">
              {group.moments.map(moment => (
                <section class="calendar-map-moment min-w-0 [&+&]:border-t [&+&]:border-border">
                  <a class="calendar-map-moment__date mt-5 inline-block font-mono text-xs text-tx-2 no-underline" href={getMomentPath(moment.dateKey)}>
                    {formatDate(moment.dateKey)}
                  </a>
                  <MomentEntry class="!pt-2.5" moment={moment} showLocation={false} />
                </section>
              ))}
            </div>
          </template>
        )
      })
    }

    <dialog class="calendar-map-lightbox m-0 h-dvh max-h-none w-screen max-w-none border-0 bg-black/88 p-16 backdrop:bg-transparent max-[48rem]:px-4 max-[48rem]:py-12" data-calendar-map-lightbox aria-label="图片查看器">
      <button type="button" class="calendar-map-lightbox__close fixed right-4 top-4 z-[1] flex size-11 cursor-pointer items-center justify-center border-0 bg-transparent text-white" data-map-lightbox-close aria-label="关闭图片">
        <span class="i-lucide-x" aria-hidden="true" />
      </button>
      <button type="button" class="calendar-map-lightbox__previous fixed left-2 top-1/2 z-[1] flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center border-0 bg-transparent text-white max-[48rem]:bottom-4 max-[48rem]:top-auto max-[48rem]:translate-y-0" data-map-lightbox-previous aria-label="上一张图片">
        <span class="i-lucide-chevron-left" aria-hidden="true" />
      </button>
      <MomentLightboxMedia imageClass="mx-auto max-h-[calc(100dvh-8rem)] max-w-full object-contain" />
      <button type="button" class="calendar-map-lightbox__next fixed right-2 top-1/2 z-[1] flex size-11 -translate-y-1/2 cursor-pointer items-center justify-center border-0 bg-transparent text-white max-[48rem]:bottom-4 max-[48rem]:top-auto max-[48rem]:translate-y-0" data-map-lightbox-next aria-label="下一张图片">
        <span class="i-lucide-chevron-right" aria-hidden="true" />
      </button>
    </dialog>

    <script is:inline type="application/json" data-calendar-map-locations set:html={markerDataJson} />
    <script is:inline type="application/json" data-calendar-map-trips set:html={tripDataJson} />
  </main>
</Layout>

<script>
  import '@/calendar-map-client'
</script>
