---
import {
  getDayNumber,
  getDeviceEvents,
  getDeviceLanes,
  getDeviceSpans,
  type DeviceSpan,
  type DeviceStatus,
} from '@/data/devices'
import { readDevices } from '@/data/store'
import { getAssetUrl, getThumbnailUrl } from '@/asset-url'

// The devices on the use page: one lane per category with a bar for each device on wide
// screens, a feed of purchases and sales on narrow ones. Spans still owned end on the
// day the site was built, and so do their daily costs.

const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai' }).format(new Date())
const spans = getDeviceSpans(readDevices(), today)
const events = getDeviceEvents(spans)

const firstYear = Number(spans[0]!.start.slice(0, 4))
const lastYear = Number(today.slice(0, 4)) + 1
const years = Array.from({ length: lastYear - firstYear }, (_, index) => firstYear + index)
const origin = getDayNumber(`${firstYear}-01-01`)
const total = getDayNumber(`${lastYear}-01-01`) - origin
const position = (date: string) => ((getDayNumber(date) - origin) / total) * 100

// A name goes inside its bar when it fits, else beside it: after the bar when there's
// room before the track's end, else before it. Widths are guessed from the characters at
// the bars' text-xs, against the narrowest track a wide screen gives (36rem less gutters).
const TRACK_WIDTH = 540
const GAP = 6
type LabelSide = 'inside' | 'after' | 'before'
const estimateWidth = (text: string) =>
  [...text].reduce((width, character) => width + (character.codePointAt(0)! > 0xff ? 12 : 6.8), 0)
const labels = new Map(
  spans.map((span) => {
    const start = position(span.start)
    const end = position(span.end)
    const width = ((estimateWidth(span.device.name) + 12) / TRACK_WIDTH) * 100
    const outside = ((estimateWidth(span.device.name) + GAP) / TRACK_WIDTH) * 100
    const side: LabelSide =
      width <= end - start ? 'inside' : end + outside <= 100 ? 'after' : 'before'
    const extent =
      side === 'inside'
        ? ([start, end] as const)
        : side === 'after'
          ? ([start, end + outside] as const)
          : ([start - outside, end] as const)
    return [span.id, { extent, side }]
  }),
)
const lanes = getDeviceLanes(spans, (span) => labels.get(span.id)!.extent)

const priceFormatter = new Intl.NumberFormat('zh-CN', {
  currency: 'CNY',
  maximumFractionDigits: 2,
  minimumFractionDigits: 0,
  style: 'currency',
})
const formatPrice = (value: number) => priceFormatter.format(value)
const formatDailyCost = (span: DeviceSpan) => `¥${span.dailyCost.toFixed(2)}/天`

const statusLabel: Record<DeviceStatus, string> = {
  backup: '备用',
  idle: '闲置',
  'in-use': '在用',
  sold: '已卖出',
}
const barFill: Record<DeviceStatus, string | undefined> = {
  backup: 'var(--color-hover)',
  idle: undefined,
  'in-use': 'var(--color-hover)',
  sold: 'var(--color-inline)',
}

/** A bar is filled while the device was the main one and hollow while it was a backup. */
function getBarBackground(span: DeviceSpan) {
  const fill = barFill[span.status]

  if (!fill) {
    return ''
  }

  const start = getDayNumber(span.start)
  const length = getDayNumber(span.end) - start
  const at = (date: string) => `${(((getDayNumber(date) - start) / length) * 100).toFixed(2)}%`
  const stops = [`${fill} 0%`]

  for (const period of span.backup) {
    stops.push(`${fill} ${at(period.start)}`, `transparent ${at(period.start)}`)
    stops.push(`transparent ${at(period.end)}`, `${fill} ${at(period.end)}`)
  }

  return `background-image: linear-gradient(to right, ${stops.join(', ')}, ${fill} 100%)`
}

const eventsByYear = Map.groupBy(events, (event) => event.date.slice(0, 4))
const ROW = 1.75
---

<h2>物品</h2>

<div class="devices-timeline">
  {
    lanes.map((lane) => (
      <div class="devices-timeline__lane">
        <span class="devices-timeline__category">{lane.category}</span>
        <div class="devices-timeline__track" style={`height: ${lane.rows.length * ROW + 0.5}rem`}>
          {years.map((year) => (
            <div class="devices-timeline__year-line" style={`left: ${position(`${year}-01-01`)}%`} />
          ))}
          {lane.rows.map((row, rowIndex) =>
            row.map((span) => {
              const left = position(span.start)
              const { side } = labels.get(span.id)!
              return (
                <div
                  class="device"
                  style={`top: ${0.375 + rowIndex * ROW}rem; left: ${left}%; width: ${position(span.end) - left}%`}
                  tabindex="0"
                >
                  <div
                    style={getBarBackground(span)}
                    class:list={['device__bar', `device-status--${span.status}`, { 'device__bar--labelled': side === 'inside' }]}
                  >
                    {side === 'inside' && span.device.name}
                  </div>
                  {side !== 'inside' && (
                    <span
                      class:list={[
                        'device__name',
                        `device__name--${side}`,
                        { 'device__name--owned': span.status === 'in-use' || span.status === 'backup' },
                      ]}
                    >
                      {span.device.name}
                    </span>
                  )}
                  <div class:list={['device__card', left > 50 ? 'device__card--end' : 'device__card--start']}>
                    <div class="device__card-head">
                      <div>
                        <div class="device__card-title">{span.device.name}</div>
                        <div class="device__card-status">
                          {span.device.category} · {statusLabel[span.status]}
                        </div>
                      </div>
                      {span.device.image && (
                        <img src={getThumbnailUrl(getAssetUrl(span.device.image), 160)} alt="" loading="lazy" decoding="async" />
                      )}
                    </div>
                    <dl>
                      <dt>购入</dt>
                      <dd>
                        {span.start} · {formatPrice(span.device.bought.price)}
                      </dd>
                      {span.device.sold && (
                        <>
                          <dt>卖出</dt>
                          <dd>
                            {span.device.sold.on} · {formatPrice(span.device.sold.price)}
                          </dd>
                        </>
                      )}
                      <dt>持有</dt>
                      <dd>
                        {span.days} 天{span.device.bought.price > 0 && ` · ${formatDailyCost(span)}`}
                      </dd>
                    </dl>
                    {span.device.note && <div class="device__card-note">{span.device.note}</div>}
                  </div>
                </div>
              )
            }),
          )}
        </div>
      </div>
    ))
  }
  <div class="devices-timeline__lane">
    <span />
    <div class="devices-timeline__axis">
      {
        years.map((year) => (
          <span style={`left: ${position(`${year}-01-01`)}%`}>
            {year}
          </span>
        ))
      }
    </div>
  </div>
  <div class="devices-timeline__legend">
    {
      (['in-use', 'backup', 'sold'] as const).map((status) => (
        <span>
          <span
            class:list={['devices-timeline__swatch', `device-status--${status}`]}
            style={status === 'backup' ? '' : `background: ${barFill[status] ?? 'none'}`}
          />
          {statusLabel[status]}
        </span>
      ))
    }
  </div>
</div>

<div class="devices-feed">
  {
    [...eventsByYear].map(([year, yearEvents]) => (
      <section>
        <div class="devices-feed__year">{year}</div>
        {yearEvents.map(({ date, kind, span }) => (
          <div class="devices-feed__event">
            <time datetime={date}>
              {date.slice(5).replace('-', '/')}
            </time>
            <div>
              <span class="devices-feed__kind">{kind === 'bought' ? '购入' : '卖出'}</span>{' '}
              {span.device.name}{' '}
              <span class="devices-feed__aside">
                {formatPrice(kind === 'bought' ? span.device.bought.price : span.device.sold!.price)}
              </span>
              {kind === 'bought' && (span.status === 'idle' || span.status === 'backup') && (
                <span class:list={['devices-feed__status', `device-status--${span.status}`]}>
                  {statusLabel[span.status]}
                </span>
              )}
              {kind === 'sold' && (
                <div class="devices-feed__aside">
                  持有 {span.days} 天 · {formatDailyCost(span)}
                </div>
              )}
              {kind === 'bought' && span.device.note && (
                <div class="devices-feed__aside">{span.device.note}</div>
              )}
            </div>
          </div>
        ))}
      </section>
    ))
  }
</div>

<style>
  /* A device's border and text by its status: solid for one in use or kept as a backup,
     dashed for one lying idle, and faint for one sold. */
  .device-status--in-use {
    border-color: var(--color-border);
    color: var(--color-tx);
  }

  .device-status--backup {
    border-color: var(--color-border);
    color: var(--color-tx-2);
  }

  .device-status--idle {
    border-style: dashed;
    border-color: var(--color-tx-3);
    color: var(--color-tx-2);
  }

  .device-status--sold {
    border-color: var(--color-border);
    color: var(--color-tx-3);
  }

  /* The lanes from 40rem; a feed of purchases and sales below it. */
  .devices-timeline {
    display: none;
    font-size: 0.875rem;
    line-height: 1.25rem;

    @media (width >= 40rem) {
      display: block;
    }
  }

  .devices-timeline__lane {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    border-top: 1px solid var(--color-border);
  }

  .devices-timeline__category {
    padding-block: 0.375rem;
    color: var(--color-tx-2);
  }

  .devices-timeline__track {
    position: relative;
  }

  .devices-timeline__year-line {
    position: absolute;
    inset-block: 0;
    border-left: 1px solid var(--color-border);
  }

  .devices-timeline__axis {
    position: relative;
    height: 1.5rem;

    & span {
      position: absolute;
      top: 0.25rem;
      color: var(--color-tx-3);
      font-size: 0.75rem;
      line-height: 1rem;
      font-variant-numeric: tabular-nums;
      translate: -50% 0;
    }
  }

  .devices-timeline__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.75rem;
    color: var(--color-tx-3);
    font-size: 0.75rem;
    line-height: 1rem;

    & > span {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
    }
  }

  .devices-timeline__swatch {
    display: inline-block;
    width: 1rem;
    height: 0.625rem;
    border-width: 1px;
    border-radius: 0.25rem;
  }

  /* A device's bar, its name inside or beside it, and its card on hover or focus. */
  .device {
    position: absolute;
    outline: none;
  }

  .device__bar {
    height: 1.5rem;
    min-width: 0.25rem;
    overflow: hidden;
    border-width: 1px;
    border-radius: 0.375rem;
    background-color: var(--color-bg);
    font-size: 0.75rem;
    line-height: 1.375rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: border-color 150ms var(--ease);

    .device:focus-visible & {
      border-color: var(--color-tx-2);
    }

    @media (hover: hover) {
      .device:hover & {
        border-color: var(--color-tx-3);
      }
    }
  }

  .device__bar--labelled {
    padding-inline: 0.375rem;
  }

  .device__name {
    position: absolute;
    top: 0;
    color: var(--color-tx-3);
    font-size: 0.75rem;
    line-height: 1.5rem;
    white-space: nowrap;
    transition: color 150ms var(--ease);

    @media (hover: hover) {
      .device:hover & {
        color: var(--color-tx);
      }
    }
  }

  .device__name--owned {
    color: var(--color-tx-2);
  }

  .device__name--after {
    left: 100%;
    margin-left: 0.375rem;
  }

  .device__name--before {
    right: 100%;
    margin-right: 0.375rem;
  }

  .device__card {
    position: absolute;
    top: 100%;
    z-index: 10;
    width: 15rem;
    margin-top: 0.375rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg);
    box-shadow:
      0 1px 3px 0 rgb(0 0 0 / 0.1),
      0 1px 2px -1px rgb(0 0 0 / 0.1);
    font-size: 0.75rem;
    line-height: 1.25rem;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms var(--ease);

    .device:focus-visible & {
      visibility: visible;
      opacity: 1;
    }

    @media (hover: hover) {
      .device:hover & {
        visibility: visible;
        opacity: 1;
      }
    }

    & dl {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.75rem;
      margin-top: 0.5rem;
      color: var(--color-tx-2);
    }

    & dd {
      font-variant-numeric: tabular-nums;
    }
  }

  .device__card--start {
    left: 0;
  }

  .device__card--end {
    right: 0;
  }

  /* Its name and status, with its picture beside them when it has one. */
  .device__card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;

    & img {
      flex-shrink: 0;
      width: auto;
      height: 4rem;
      margin-block: -0.25rem;
    }
  }

  .device__card-title {
    color: var(--color-tx);
    font-weight: 500;
  }

  .device__card-status {
    color: var(--color-tx-3);
  }

  .device__card-note {
    margin-top: 0.5rem;
    color: var(--color-tx-2);
  }

  .devices-feed {
    @media (width >= 40rem) {
      display: none;
    }

    & section + section {
      margin-top: 1rem;
    }
  }

  .devices-feed__year {
    margin-bottom: 0.25rem;
    font-weight: 500;
  }

  .devices-feed__event {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    column-gap: 0.5rem;
    padding-block: 0.25rem;

    & time {
      color: var(--color-tx-3);
      font-variant-numeric: tabular-nums;
    }
  }

  .devices-feed__kind {
    color: var(--color-tx-2);
  }

  .devices-feed__aside {
    color: var(--color-tx-3);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .devices-feed__status {
    margin-left: 0.25rem;
    padding-inline: 0.25rem;
    border-width: 1px;
    border-radius: 0.25rem;
    color: var(--color-tx-2);
    font-size: 0.75rem;
    line-height: 1rem;
  }
</style>
