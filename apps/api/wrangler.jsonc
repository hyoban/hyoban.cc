{
  "name": "hyoban-cc-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-23",
  // The spec's Zod is most of the bundle; minifying takes it from 800 to 480 KiB.
  "minify": true,
  "observability": { "enabled": true },
  // Created with `wrangler d1 create hyoban-cc --location apac`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyoban-cc",
      "database_id": "d4330b94-a98a-4a1e-ae7c-36d0570f4547",
      "migrations_dir": "migrations",
    },
  ],
  // The bucket image.hyoban.cc serves; uploads wait under uploads/ until they publish.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "blog-images" }],
  // Secrets, set with `wrangler secret put` and in `.dev.vars` locally: API_TOKENS, a
  // comma-separated list of bearer tokens, and DEPLOY_HOOK_URL, which a write the site
  // shows calls so the site builds again.
}
