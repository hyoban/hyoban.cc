{
  "name": "hyoban-cc-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-23",
  "observability": { "enabled": true },
  // Created with `wrangler d1 create hyoban-cc --location apac`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyoban-cc",
      "database_id": "d4330b94-a98a-4a1e-ae7c-36d0570f4547",
      "migrations_dir": "migrations",
    },
  ],
  // API_TOKENS, a comma-separated list of bearer tokens, is a secret:
  // `wrangler secret put API_TOKENS`, and `.dev.vars` locally.
}
