<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Moments, places and trips come from the API; the photos from the image origin. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for only when the map is asked to find where the phone is. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".MomentsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moments">
        <!-- Compose lays the app out again on its own when the phone turns, so the
             activity stays: the map, a playing video and the open page carry on as they were. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- moments://moment/{uid}, trip/{id}, day/{date}, place/{id}, settings, map,
                 trips and moments open their pages, from a link or from
                 `adb shell am start -d`; one opened while the app is on screen goes over
                 the page shown rather than starting it again. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moments" />
            </intent-filter>
        </activity>
    </application>

</manifest>
