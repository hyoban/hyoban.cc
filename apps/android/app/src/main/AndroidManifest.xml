<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Moments, places and trips come from the API; the photos from the image origin. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for only when the map is asked to find where the phone is, or a new Moment where it is. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Where a photo picked for a new Moment was taken, which the gallery hides without it. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <application
        android:name=".MomentsApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moments">
        <!-- Compose lays the app out again on its own when the phone turns, so the
             activity stays: the map, a playing video and the open page carry on as they were.
             A playing video goes on in a picture-in-picture window when the app is left. -->
        <activity
            android:name=".MainActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- moments://moment/{uid}, trip/{id}, day/{date}, place/{id}, settings, map,
                 trips, moments and new open their pages, from a link or from
                 `adb shell am start -d`; one opened while the app is on screen goes over
                 the page shown rather than starting it again. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="moments" />
            </intent-filter>
        </activity>

        <!-- A page a widget opens, over the app in its task: back closes it, and the app's
             icon closes it too and shows the app as it was rather than the page. -->
        <activity
            android:name=".LinkActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:exported="false" />

        <!-- A place shared from a map, Amap's among them, or photos from the gallery: it
             draws nothing, and opens the app on a new Moment with them, or gives them to the
             Moment being written. -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter android:label="@string/share_as_place">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Photos from the gallery, one or several, for a new Moment. -->
            <intent-filter android:label="@string/share_as_moment">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- The same, keeping the shared place on its own and leaving the map in front. -->
        <activity-alias
            android:name=".SavePlaceActivity"
            android:exported="true"
            android:targetActivity=".ShareActivity">
            <intent-filter android:label="@string/share_save_place">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <!-- The home screen's widgets: a Moment from this day in an earlier year, and the trip. -->
        <receiver
            android:name=".widget.MemoryWidgetReceiver"
            android:label="@string/widget_memory_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_memory" />
        </receiver>
        <receiver
            android:name=".widget.TripWidgetReceiver"
            android:label="@string/widget_trip_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_trip" />
        </receiver>
        <!-- Serves the photo or video the viewer shares to the app it is shared with. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
