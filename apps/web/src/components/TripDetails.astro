---
import { getTripPath } from '@/trip-path'
import { isInTrip } from '@hyoban/trip-map'
import TripChat from '@/components/TripChat.astro'
import TripCoverCollage from '@/components/TripCoverCollage.astro'
import { formatRate, formatYuan } from '@/data/vehicle-costs'
import { getBills, getCarCharges, getCarDays, getCheckins, getMomentTripCosts, getMomentTripOdometer, type Moment, type MomentTrip } from '@/moments'
import { formatBillAmount, getSpending } from '@/moments/bills'
import { getTripChat } from '@/moments/trip-chat'
import { getTripCollage } from '@/moments/trip-images'

// A trip's sidebar beside the map: its photos and totals, the button that plays it, and
// its days as the app's trip has them, a conversation of its Moments, public check-ins
// and the public bills paid in its span (TripChat), each stop playing the trip from its
// own bubble. The map fetches it as a fragment (see
// pages/trip/[id]/moments.astro); a trip's page renders it in place.

interface Props {
  /** Every Moment, of which the trip's days are shown. */
  moments: Moment[]
  trip: MomentTrip
}

const { moments, trip } = Astro.props
// A trip's bills are the public ones paid in its span, as it holds every entry there.
const tripBills = getBills().filter(bill => isInTrip(trip, bill.occurredAt))
const days = getTripChat(trip, moments, getCheckins(), tripBills, getCarCharges(), getCarDays())
const [spent, ...otherSpent] = getSpending(tripBills)
// The trip at a glance, figures with a word under each: how long and where, how
// far the car went and how often it charged, and what it cost on the road, from the car's
// ledger, in all and a kilometre, when it drove and the records have them; and what its
// public bills spent, in the currency paid most often, the others under it.
const odometer = getMomentTripOdometer(trip)
const charges = odometer?.charges.length ?? 0
const costs = odometer && getMomentTripCosts(trip, odometer)
const figures = [
  { value: String(trip.dayCount), unit: '天', note: `${trip.placeCount} 个地点` },
  ...(trip.drivingKm > 0
    ? [{ value: trip.drivingKm.toLocaleString('zh-CN'), unit: '公里', note: charges > 0 ? `充电 ${charges} 次` : '自驾' }]
    : []),
  ...(costs
    ? [{
        value: formatYuan(costs.total),
        unit: '',
        note: costs.distanceMeters > 0 ? `每公里 ${formatRate(costs.total / 100 / (costs.distanceMeters / 1000))}` : '花费',
      }]
    : []),
  ...(spent
    ? [{
        value: formatBillAmount(spent.amount, spent.currency),
        unit: '',
        note: [`${tripBills.filter(bill => bill.kind === 'expense').length} 笔支出`, ...otherSpent.map(other => formatBillAmount(other.amount, other.currency))].join(' · '),
      }]
    : []),
]
---

<div class="trip-details">
  <TripCoverCollage images={getTripCollage(trip, moments)} priority sizes="(max-width: 48rem) 100vw, 26rem" />
  <ul class="trip-details__figures" data-figures={figures.length} style={`--figure-columns: ${Math.max(3, figures.length)}`}>
    {figures.map(({ value, unit, note }) => (
      <li>
        <span class="trip-details__figure">{value}{unit && <small>{unit}</small>}</span>
        <span class="trip-details__note">{note}</span>
      </li>
    ))}
  </ul>
  <a class="trip-details__play" href={getTripPath(trip.id, {})} data-trip-map-stop-play={trip.id}>
    <span class="i-lucide-play" aria-hidden="true" />
    回放旅程
  </a>
</div>
<TripChat days={days} />

<style>
  .trip-details {
    padding-top: 1rem;

    & .trip-cover-collage {
      margin-bottom: 0.75rem;
    }
  }

  .trip-details__figures {
    display: grid;
    grid-template-columns: repeat(var(--figure-columns), minmax(0, 1fr));
    gap: 0.75rem;
    font-variant-numeric: tabular-nums;

    /* Four figures in a row leave their words no room on a phone: two rows of two there. */
    @media (max-width: 30rem) {
      &[data-figures='4'] {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    & li {
      display: flex;
      flex-direction: column;
      min-width: 0;
    }
  }

  .trip-details__figure {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.75rem;
    letter-spacing: -0.02em;
    white-space: nowrap;

    & small {
      margin-left: 0.125rem;
      color: var(--color-tx-2);
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0;
    }
  }

  .trip-details__note {
    overflow: hidden;
    color: var(--color-tx-3);
    font-size: 0.75rem;
    line-height: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .trip-details__play {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2.5rem;
    margin-top: 0.75rem;
    border-radius: 9999px;
    background: var(--color-tx);
    color: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: calc(1.25 / 0.875);
    text-decoration: none;

    @media (hover: hover) {
      &:hover {
        color: var(--color-bg);
        opacity: 0.9;
      }
    }

    &:focus-visible {
      outline: 2px solid var(--color-tx);
      outline-offset: 2px;
    }

    & span {
      font-size: 0.8125rem;
    }
  }
</style>
