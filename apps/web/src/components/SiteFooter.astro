---
import { site } from '@/site-config'

const { links } = site
---

<footer class="site-footer">
  {
    links.map(({ href, label, icon }) => (
      <a
        href={href}
        aria-label={label}
        title={label}
        {...(href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <span class={icon} aria-hidden="true" />
      </a>
    ))
  }
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    max-width: 40rem;
    margin: 5rem auto 0;
    padding-top: 2rem;

    & a {
      color: var(--color-tx-3);
      text-decoration: none;
      transition: color 150ms var(--ease);

      @media (hover: hover) {
        &:hover {
          color: var(--color-tx);
        }
      }
    }

    & span {
      display: block;
      width: 1rem;
      height: 1rem;
    }
  }
</style>
