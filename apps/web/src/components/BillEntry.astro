---
import type { PublicBill } from '@/moments'
import { formatBillAmount } from '@/moments/bills'

interface Props {
  bill: PublicBill
}

const { bill } = Astro.props
const weekdayFormatter = new Intl.DateTimeFormat('zh-CN', { timeZone: 'UTC', weekday: 'short' })
// Its day as the trip's Moments have it, without the year.
const [, month, day] = bill.dateKey.split('-').map(part => Number.parseInt(part, 10))
const dayLabel = `${month}/${day} ${weekdayFormatter.format(new Date(`${bill.dateKey}T00:00:00Z`))}`
// The category's own name, its parent left to the category itself: `餐饮 › 晚餐` reads 晚餐.
const category = bill.category?.split(' › ').at(-1)
---

<!-- A public bill in a trip's sidebar: one quiet line, as a check-in's, the day and time
     it was paid, what for and what it cost, and what came back of it, among the trip's Moments. -->
<article class="bill-entry">
  <span class="i-lucide-receipt" aria-hidden="true" />
  <span class="sr-only">{bill.kind === 'income' ? '收入' : '支出'}</span>
  <time datetime={bill.occurredAt}>{dayLabel}{bill.occurredLabel && ` ${bill.occurredLabel}`}</time>
  <span class="bill-entry__what">
    {category ?? (bill.kind === 'income' ? '收入' : '支出')}
    {bill.note && <span class="bill-entry__note">{bill.note}</span>}
  </span>
  <span class="bill-entry__amount" data-kind={bill.kind}>{bill.kind === 'income' ? '+' : ''}{formatBillAmount(bill.amount, bill.currency)}{bill.refunded && <span class="bill-entry__refunded">退款 {formatBillAmount(bill.refunded, bill.currency)}</span>}</span>
</article>
