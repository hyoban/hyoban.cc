---
import ChatBillRow from '@/components/ChatBillRow.astro'
import ChatChargeRow from '@/components/ChatChargeRow.astro'
import ChatRecordRow from '@/components/ChatRecordRow.astro'
import ChatTail from '@/components/ChatTail.astro'
import MomentBubble from '@/components/MomentBubble.astro'
import type { CarDay } from '@/moments'
import type { ChatDay } from '@/moments/trip-chat'

interface Props {
  days: ChatDay[]
}

const { days } = Astro.props
// A day's driving time and energy, as its line says them after 用车.
const driveDetail = (day: CarDay) => [
  day.durationSeconds !== undefined && formatDuration(day.durationSeconds),
  day.energyWh !== undefined && `${(day.energyWh / 1000).toFixed(1)} kWh`,
].filter(Boolean).join(' · ')
const formatDuration = (seconds: number) => {
  const minutes = Math.round(seconds / 60)
  return minutes >= 60 ? `${Math.floor(minutes / 60)} 小时 ${minutes % 60} 分钟` : `${minutes} 分钟`
}
const formatKm = (meters: number) => `${(meters / 1000).toLocaleString('zh-CN', { maximumFractionDigits: meters < 10_000 ? 1 : 0 })} 公里`
---

<!-- A trip's days as the app's trip has them, a conversation: the day's date in a capsule,
     then its Moments and check-ins as bubbles from the right, and the bills and charges between
     them gathered in one outlined bubble from the left, the day ending with what the car drove
     (styles/trip-chat.css). -->
<div class="trip-chat">
  {
    days.map(day => (
      <section class="chat-day" aria-label={day.label}>
        <h2 class="chat-date"><span>{day.label}</span></h2>
        {day.bubbles.map(bubble => bubble.kind === 'moment'
          ? <MomentBubble moment={bubble.moment} bills={bubble.bills} charges={bubble.charges} joinedAbove={bubble.joinedAbove} joinedBelow={bubble.joinedBelow} />
          : bubble.kind === 'checkin'
            ? (
                <article
                  class:list={['chat-sent', { 'chat-sent--joined-above': bubble.joinedAbove }]}
                  data-trip-map-waypoint-entry={bubble.checkin.occurredAt.length > 10 ? bubble.checkin.occurredAt.slice(0, 16) : undefined}
                >
                  <div class:list={['chat-bubble', 'chat-bubble--sent', { 'chat-bubble--fill': bubble.bills.length + bubble.charges.length > 0, 'chat-bubble--joined-above': bubble.joinedAbove, 'chat-bubble--joined-below': bubble.joinedBelow }]}>
                    <div class="chat-bubble__body">
                      <div class="chat-bubble__content">
                        <a
                          class="chat-checkin"
                          href={`/map/${bubble.checkin.dateKey.slice(0, 4)}/${bubble.checkin.dateKey.slice(5, 7)}/place/${bubble.checkin.locations[0].id}/`}
                          data-trip-map-place-link={bubble.checkin.locations[0].id}
                        >
                          <span class="i-lucide-map-pin-check-inside" aria-hidden="true" />
                          <span class="sr-only">签到</span>
                          <span class="chat-checkin__venue">{bubble.checkin.venue}</span>
                          {bubble.checkin.occurredLabel && <time class="chat-row__time" datetime={bubble.checkin.occurredAt}>{bubble.checkin.occurredLabel}</time>}
                        </a>
                        {
                          bubble.bills.length + bubble.charges.length > 0 && (
                            <div class="chat-bills">
                              {bubble.charges.map(charge => <ChatChargeRow charge={charge} timeAtEnd hideTime={charge.charge.startedAt.slice(11, 16) === bubble.checkin.occurredLabel} />)}
                              {bubble.bills.map(bill => <ChatBillRow bill={bill} timeAtEnd hideTime />)}
                            </div>
                          )
                        }
                      </div>
                    </div>
                    {!bubble.joinedBelow && <ChatTail sent />}
                  </div>
                </article>
              )
            : (
                <div class="chat-received">
                  <div class:list={['chat-bubble', 'chat-bubble--received', { 'chat-bubble--fill': bubble.lines.length > 1 }]}>
                    <div class="chat-bubble__body">
                      <div class="chat-bubble__content">
                        {bubble.lines.map(line => line.kind === 'bill'
                          ? <ChatBillRow bill={line.bill} />
                          : line.kind === 'charge'
                            ? <ChatChargeRow charge={line.charge} />
                            : <ChatRecordRow icon="i-lucide-car-front" title="用车" detailBelow detail={driveDetail(line.day)} value={formatKm(line.day.distanceMeters)} />)}
                      </div>
                    </div>
                    <ChatTail sent={false} />
                  </div>
                </div>
              ))}
      </section>
    ))
  }
</div>
