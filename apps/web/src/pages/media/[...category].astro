---
import MediaSourceIcon from '@/components/MediaSourceIcon.astro'
import SitePage from '@/components/SitePage.astro'
import generatedMedia from '@/data/media.generated.json'
import mediaRecommendations from '@/data/media-recommendations.json'
import Layout from '@/layouts/Layout.astro'
import { compareMediaItems, DEFAULT_MEDIA_CATEGORY, getMediaCategoryPath, getMediaItemKey, type MediaCategory, mediaCategories } from '@/media'
import { formatDuration, getMusicTracks } from '@/music'
import { getPageCardPath, getPageTitle, MEDIA_TEXT } from '@/page-cards'

export function getStaticPaths() {
  return mediaCategories.map(category => ({
    params: { category: category.value === DEFAULT_MEDIA_CATEGORY ? undefined : category.value },
    props: { category: category.value },
  }))
}

const { category: currentCategory } = Astro.props as { category: MediaCategory }
const pageTitle = getPageTitle(MEDIA_TEXT)
const pageDescription = MEDIA_TEXT.description
const TMDB_IMAGE_BASE_URL = 'https://image.tmdb.org/t/p'
const ANIMATION_GENRE_ID = 16

type MediaRecommendation = {
  doubanId?: number
  note?: string
  playbackSources?: PlaybackSource[]
  type: 'movie' | 'tv'
  tmdbId: number
}

type PlaybackSource = {
  name: string
  url: string
}

type TmdbPerson = {
  job?: string
  name?: string
}

type TmdbCompany = {
  name?: string
}

type TmdbGenre = {
  id?: number
}

type TmdbDetails = {
  created_by?: TmdbPerson[]
  credits?: {
    crew?: TmdbPerson[]
  }
  first_air_date?: string
  genres?: TmdbGenre[]
  name?: string
  networks?: TmdbCompany[]
  original_name?: string
  original_title?: string
  overview?: string
  poster_path?: string | null
  production_companies?: TmdbCompany[]
  release_date?: string
  title?: string
}

type GeneratedMediaItem = {
  type: 'movie' | 'tv'
  tmdbId: number
  data: TmdbDetails
}

const generatedByKey = new Map(
  (generatedMedia.items as GeneratedMediaItem[]).map(item => [
    getMediaItemKey(item),
    item,
  ]),
)

const sortedRecommendations = [...mediaRecommendations as MediaRecommendation[]].sort(compareMediaItems)

const mediaWorks = sortedRecommendations.map((recommendation) => {
  const generated = generatedByKey.get(getMediaItemKey(recommendation))

  if (!generated) {
    throw new Error(
      `Missing generated TMDB data for ${getMediaItemKey(recommendation)}. Run "pnpm media:generate".`,
    )
  }

  return resolveMediaWork(recommendation, generated)
})

const musicTracks = await getMusicTracks()

const mediaCategoryCounts = new Map(
  mediaCategories.map(category => [
    category.value,
    category.value === 'music'
      ? musicTracks.length
      : mediaWorks.filter(work => work.categories.includes(category.value)).length,
  ]),
)

function resolveMediaWork(recommendation: MediaRecommendation, generated: GeneratedMediaItem) {
  const data = generated.data
  const title = getTitle(generated.type, data)
  const originalTitle = getOriginalTitle(generated.type, data)
  const displayTitle = originalTitle && originalTitle !== title
    ? `${title}（${originalTitle}）`
    : title
  const doubanUrl = recommendation.doubanId
    ? getDoubanUrl(recommendation.doubanId)
    : undefined

  return {
    categories: getMediaCategories(generated.type, data),
    creator: getCreator(generated.type, data),
    displayTitle,
    doubanUrl,
    note: recommendation.note,
    overview: data.overview,
    playbackSources: recommendation.playbackSources ?? [],
    posterUrl: data.poster_path ? `${TMDB_IMAGE_BASE_URL}/w342${data.poster_path}` : undefined,
    tmdbUrl: getTmdbUrl(generated.type, generated.tmdbId),
    year: getYear(generated.type, data),
  }
}

function getMediaCategories(type: GeneratedMediaItem['type'], data: TmdbDetails): MediaCategory[] {
  if (data.genres?.some(genre => genre.id === ANIMATION_GENRE_ID)) {
    return ['anime']
  }

  if (type === 'tv' && isTvbMedia(data)) {
    return ['tvb']
  }

  return [type]
}

function isTvbMedia(data: TmdbDetails) {
  return [...(data.networks ?? []), ...(data.production_companies ?? [])]
    .some(company => company.name && (/(^|\s)TVB($|\s)/i.test(company.name) || company.name.includes('香港电视广播')))
}

function getDoubanUrl(doubanId: number) {
  return `https://movie.douban.com/subject/${doubanId}/`
}

function getTmdbUrl(type: GeneratedMediaItem['type'], tmdbId: number) {
  return `https://www.themoviedb.org/${type}/${tmdbId}`
}

function getTitle(type: GeneratedMediaItem['type'], data: TmdbDetails) {
  if (type === 'movie') {
    return data.title || getOriginalTitle(type, data) || '未命名电影'
  }

  return data.name || getOriginalTitle(type, data) || '未命名剧集'
}

function getOriginalTitle(type: GeneratedMediaItem['type'], data: TmdbDetails) {
  return type === 'movie'
    ? data.original_title
    : data.original_name
}

function getYear(type: GeneratedMediaItem['type'], data: TmdbDetails) {
  const date = type === 'movie'
    ? data.release_date
    : data.first_air_date

  return date?.slice(0, 4)
}

function getCreator(type: GeneratedMediaItem['type'], data: TmdbDetails) {
  if (type === 'movie') {
    const directors = data.credits?.crew
      ?.filter(person => person.job === 'Director')
      .map(person => person.name)
      .filter(Boolean)

    if (directors?.length) {
      return directors.join(', ')
    }
  } else {
    const creators = data.created_by
      ?.map(person => person.name)
      .filter(Boolean)

    if (creators?.length) {
      return creators.join(', ')
    }
  }

  return data.production_companies?.[0]?.name
    || data.networks?.[0]?.name
    || undefined
}

---

<Layout title={pageTitle} description={pageDescription} image={await getPageCardPath('/media/')}>
  {
    currentCategory === DEFAULT_MEDIA_CATEGORY && (
      <Fragment slot="head">
        {/* Links from before the categories had their own pages: /media/?category=movie. */}
        <script is:inline data-astro-rerun>
          const category = new URL(location.href).searchParams.get('category')
          if (['tv', 'tvb', 'movie', 'music'].includes(category)) location.replace(`/media/${category}/`)
        </script>
      </Fragment>
    )
  }

  <SitePage title={MEDIA_TEXT.heading} description={pageDescription}>

    <nav class="media-filters" aria-label="分类过滤">
      {
        mediaCategories.map(category => (
          <a
            href={getMediaCategoryPath(category.value)}
            class="media-filter"
            aria-current={category.value === currentCategory ? 'page' : undefined}
            data-astro-history="replace"
          >
            {category.label}
            <span class="media-filter__count">{mediaCategoryCounts.get(category.value)}</span>
          </a>
        ))
      }
    </nav>

    <ol class="media-list">
      {
        mediaWorks.filter(work => work.categories.includes(currentCategory)).map(work => (
          <li>
            <article class="media-work">
              <div class="media-work__body">
                {
                  work.posterUrl && (
                    <a
                      href={work.tmdbUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="media-work__poster"
                      tabindex="-1"
                      aria-hidden="true"
                    >
                      <img
                        src={work.posterUrl}
                        alt=""
                        loading="lazy"
                      />
                    </a>
                  )
                }

                <header class="media-work__header">
                  <h2>
                    <a href={work.tmdbUrl} target="_blank" rel="noopener noreferrer">
                      {work.displayTitle}
                    </a>
                  </h2>
                  {(work.creator || work.year || work.doubanUrl || work.playbackSources.length > 0) && (
                    <p class="media-work__meta">
                      {work.creator && <span>{work.creator}</span>}
                      {work.year && <span>{work.year}</span>}
                      {work.doubanUrl && (
                        <a href={work.doubanUrl} target="_blank" rel="noopener noreferrer" class="media-work__source" aria-label="豆瓣" title="豆瓣">
                          <span class="i-simple-icons-douban" aria-hidden="true" />
                        </a>
                      )}
                      {work.playbackSources.map(source => (
                        <a href={source.url} target="_blank" rel="noopener noreferrer" class="media-work__source" aria-label={source.name} title={source.name}>
                          <MediaSourceIcon name={source.name} />
                        </a>
                      ))}
                    </p>
                  )}
                </header>

                {work.note && (
                  <p class="media-work__text">{work.note}</p>
                )}

                {work.overview && (
                  <p class="media-work__text media-work__text--overview">{work.overview}</p>
                )}
              </div>
            </article>
          </li>
        ))
      }
      {
        currentCategory === 'music' && musicTracks.map(track => (
          <li>
            <article class="music-track">
              {
                track.coverUrl && (
                  <a
                    href={track.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="music-track__cover"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img src={track.coverUrl} alt="" loading="lazy" />
                  </a>
                )
              }
              <header class="music-track__header">
                <h2>
                  <a href={track.url} target="_blank" rel="noopener noreferrer">{track.title}</a>
                </h2>
                <p class="media-work__meta">
                  {track.artists.length > 0 && <span>{track.artists.join(' / ')}</span>}
                  {track.album && track.album !== track.title && <span class="music-track__album">{track.album}</span>}
                  {track.durationSeconds && <span class="music-track__duration">{formatDuration(track.durationSeconds)}</span>}
                </p>
              </header>
            </article>
          </li>
        ))
      }
    </ol>
  </SitePage>
</Layout>

<style>
  .media-filters {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: fit-content;
    max-width: 100%;
    margin-bottom: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .media-filter {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    color: var(--color-tx-2);
    text-decoration: none;
    transition: color 150ms var(--ease);

    &[aria-current='page'] {
      color: var(--color-tx);
    }

    @media (hover: hover) {
      &:hover {
        color: var(--color-tx);
      }
    }
  }

  .media-filter__count {
    font-variant-numeric: tabular-nums;
  }

  .media-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  /* The poster on the left of the title, and from 40rem of the words below it too. */
  .media-work {
    display: grid;
    align-items: start;
    gap: 0.75rem;
    padding-block: 0.75rem;

    @media (width >= 40rem) {
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 0.25rem 1.25rem;
    }
  }

  .media-work__body {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
    min-width: 0;

    @media (width >= 40rem) {
      display: contents;
    }
  }

  .media-work__poster {
    display: block;
    grid-row: 1 / span 2;
    grid-column-start: 1;
    align-self: start;
    width: 100%;

    & img {
      width: 100%;
      aspect-ratio: 2 / 3;
      border-radius: 0.25rem;
      background: var(--color-inline);
      object-fit: cover;
      box-shadow: 0 0 0 1px var(--color-border);
    }
  }

  .media-work__header {
    grid-row-start: 1;
    grid-column-start: 2;
    min-width: 0;

    & > :not(:last-child) {
      margin-bottom: 0.5rem;
    }

    & h2 {
      display: -webkit-box;
      overflow: hidden;
      font-weight: 500;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }

  .media-work__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
    color: var(--color-tx-2);
  }

  .media-work__source {
    display: inline-flex;
    align-items: center;
    text-decoration: none;

    @media (hover: hover) {
      &:hover {
        color: var(--color-tx);
      }
    }
  }

  .media-work__text {
    display: -webkit-box;
    grid-column-start: 2;
    align-self: end;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;

    @media (width >= 40rem) {
      -webkit-line-clamp: 3;
    }
  }

  .media-work__text--overview {
    color: var(--color-tx-2);
  }

  /* A song: its album's cover beside the title, and who sings it, the album and its length below. */
  .music-track {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.375rem;
  }

  .music-track__cover {
    display: block;

    & img {
      width: 100%;
      aspect-ratio: 1;
      border-radius: 0.25rem;
      background: var(--color-inline);
      object-fit: cover;
      box-shadow: 0 0 0 1px var(--color-border);
    }
  }

  .music-track__header {
    grid-column-start: 2;
    min-width: 0;

    & h2 {
      overflow: hidden;
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    & .media-work__meta {
      flex-wrap: nowrap;
      overflow: hidden;
      white-space: nowrap;
    }
  }

  .music-track__album {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .music-track__duration {
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }
</style>
