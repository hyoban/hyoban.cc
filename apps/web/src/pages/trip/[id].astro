---
import CalendarMap from '@/components/CalendarMap.astro'
import { getMapYears, getMoments, getTripPaths } from '@/moments'

// A trip's sidebar beside the map, /trip/<id>/; and the same path shape, /trip/<year>/, is
// the trip list narrowed to a year.
export async function getStaticPaths() {
  const years = getMapYears(await getMoments())

  return [
    ...(await getTripPaths()).map(({ params, props }) => ({ params, props: { trip: props.trip } })),
    ...years.map(year => ({ params: { id: String(year) }, props: { year } })),
  ]
}

const { trip, year } = Astro.props as { trip?: { id: string }, year?: number }
---

{trip ? <CalendarMap pickedTripId={trip.id} /> : <CalendarMap tripList period={{ year: year! }} />}
