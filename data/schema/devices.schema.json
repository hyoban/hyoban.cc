{
  "$id": "https://hyoban.cc/data/schema/v3/devices.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "propertyNames": {
    "type": "string",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "bought": {
        "type": "object",
        "properties": {
          "on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "on",
          "price"
        ],
        "additionalProperties": {}
      },
      "sold": {
        "type": "object",
        "properties": {
          "on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "price": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "on",
          "price"
        ],
        "additionalProperties": {}
      },
      "idle": {
        "default": false,
        "type": "boolean"
      },
      "image": {
        "type": "string",
        "minLength": 1
      },
      "note": {
        "type": "string"
      }
    },
    "required": [
      "name",
      "category",
      "bought"
    ],
    "additionalProperties": {}
  }
}
