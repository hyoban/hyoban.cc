{
  "$id": "https://hyoban.cc/data/schema/v2/vehicle-month.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "month": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
    },
    "capturedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "string",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      ]
    },
    "report": {
      "type": "object",
      "properties": {
        "distanceMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tripCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "longestTripMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "longestTripDurationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "energyWh": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "drivingEnergyWh": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parkedEnergyWh": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reportedConsumption": {
          "type": "object",
          "properties": {
            "whPer100Km": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "basis": {
              "type": "string",
              "enum": [
                "driving",
                "driving_and_parked"
              ]
            }
          },
          "required": [
            "whPer100Km",
            "basis"
          ],
          "additionalProperties": {}
        },
        "chargeCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "distanceBeatsPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": {}
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "distanceMeters": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "energyWh": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "drivingEnergyWh": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "parkedEnergyWh": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "type": "object",
            "properties": {
              "captureId": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pointer": {
                "type": "string",
                "pattern": "^\\/"
              },
              "method": {
                "type": "string",
                "enum": [
                  "screen",
                  "screen_tap",
                  "share_report"
                ]
              }
            },
            "required": [
              "captureId",
              "pointer",
              "method"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "date",
          "source"
        ],
        "additionalProperties": {}
      }
    },
    "charging": {
      "type": "object",
      "properties": {
        "reported": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "energyWh": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "count",
            "energyWh"
          ],
          "additionalProperties": {}
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  {
                    "type": "string",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  }
                ]
              },
              "type": {
                "type": "string",
                "enum": [
                  "AC",
                  "DC"
                ]
              },
              "energyWh": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "durationSeconds": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "source": {
                "type": "object",
                "properties": {
                  "captureId": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "pointer": {
                    "type": "string",
                    "pattern": "^\\/"
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "screen",
                      "screen_tap",
                      "share_report"
                    ]
                  }
                },
                "required": [
                  "captureId",
                  "pointer",
                  "method"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "startedAt",
              "type",
              "energyWh",
              "durationSeconds",
              "source"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "reported",
        "sessions"
      ],
      "additionalProperties": {}
    },
    "assistedDriving": {
      "type": "object",
      "properties": {
        "distanceMeters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nzp": {
          "type": "object",
          "properties": {
            "distanceMeters": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "durationSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reportedDistancePercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "reportedDurationPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": {}
        },
        "accLcc": {
          "type": "object",
          "properties": {
            "distanceMeters": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "durationSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reportedDistancePercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "reportedDurationPercent": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "additionalProperties": {}
        },
        "parkingCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "parkingAverageSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "daysOwned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "beatsPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "nzp",
        "accLcc"
      ],
      "additionalProperties": {}
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "captureId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pointer": {
            "type": "string",
            "pattern": "^\\/"
          },
          "method": {
            "type": "string",
            "enum": [
              "screen",
              "screen_tap",
              "share_report"
            ]
          }
        },
        "required": [
          "captureId",
          "pointer",
          "method"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "deviceId",
    "month",
    "capturedAt",
    "sources"
  ],
  "additionalProperties": {}
}
